{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graiphic.github.io/FROG/Expression/Schemas/frog.studio-document.schema.json",
  "title": "Graiphic Studio authoring writer profile v1",
  "description": "Structural compatibility for historical ordinary drafts from revision 2, current writer revisions 3 through 8, and Studio recovery revision 9. Semantic validation and execution admission are separate operations.",
  "$comment": "Evidence owners: common Frontend FrogDocumentFormat/FrogDraftWriter/FrogDraftReader and Studio FrogDocumentCompatibility. Opaque properties require their actual implementation validators. This schema covers writer-shaped artifacts and the explicit recovery envelope.",
  "type": "object",
  "required": [
    "format",
    "draft_revision",
    "title",
    "metadata"
  ],
  "properties": {
    "format": {
      "const": "frog.document.draft"
    },
    "draft_revision": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9
    },
    "language": {
      "const": "FROG"
    },
    "title": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "interface": {
      "type": "object"
    },
    "interface_map": {
      "type": "object"
    },
    "frontPanel": {
      "type": "object",
      "required": [
        "widgets"
      ],
      "properties": {
        "canvas": {
          "type": "object"
        },
        "grid": {
          "type": "object"
        },
        "widgets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/widget"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "diagram": {
      "$ref": "#/$defs/graph"
    },
    "host": {
      "type": "object"
    },
    "execution_policy": {
      "type": "object"
    },
    "compilation": {
      "type": "object"
    },
    "storage": {
      "type": "object",
      "required": ["version", "array_mode"],
      "properties": {
        "version": {"const": 1},
        "array_mode": {"enum": ["readable", "automatic", "compact_standalone"]}
      }
    },
    "icon": {
      "type": "object"
    },
    "ide": {
      "type": "object"
    }
  },
  "not": {
    "required": [
      "spec_version"
    ]
  },
  "allOf": [
    {
      "if": {
        "required": [
          "storage"
        ]
      },
      "then": {
        "properties": {
          "draft_revision": {
            "minimum": 3
          }
        }
      }
    },
    {
      "if": {"properties": {"draft_revision": {"maximum": 7}}},
      "then": {"$ref": "#/$defs/noTypeDefinitionLink"}
    },
    {
      "if": {"properties": {"draft_revision": {"const": 9}}},
      "then": {
        "required": ["ide"],
        "properties": {
          "ide": {
            "required": ["recoverability"],
            "properties": {
              "recoverability": {
                "type": "object",
                "required": ["frog_document_recovery"],
                "properties": {
                  "frog_document_recovery": {"$ref": "#/$defs/recovery"}
                }
              }
            }
          }
        },
        "if": {"anyOf": [{"required": ["diagram"]}, {"required": ["frontPanel"]}]},
        "then": {"required": ["language", "diagram", "frontPanel"]}
      },
      "else": {"required": ["language", "diagram", "frontPanel"]}
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "noTypeDefinitionLink": {
      "if": {"type": "object"},
      "then": {
        "not": {"required": ["type_definition"]},
        "additionalProperties": {"$ref": "#/$defs/noTypeDefinitionLink"}
      },
      "else": {"items": {"$ref": "#/$defs/noTypeDefinitionLink"}}
    },
    "typeDefinitionLink": {
      "type": "object",
      "required": ["definition_id", "source_path", "resolved_revision", "schema_fingerprint", "baseline_widget"],
      "properties": {
        "definition_id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string"},
        "resolved_revision": {"type": "integer", "minimum": 1},
        "schema_fingerprint": {"type": "string", "minLength": 64, "maxLength": 64},
        "baseline_widget": {"type": "string", "minLength": 1},
        "unresolved_reason": {"type": "string"},
        "icon_svg": {"type": "string"}
      }
    },
    "recovery": {
      "type": "object",
      "required": ["version", "original_source_base64", "working_source_base64", "issues"],
      "properties": {
        "version": {"const": 1},
        "original_source_base64": {"type": "string", "contentEncoding": "base64"},
        "working_source_base64": {"type": "string", "contentEncoding": "base64"},
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["category", "code", "pointer", "message", "interpretation", "blocks_run"],
            "properties": {
              "category": {"type": "integer", "minimum": 0, "maximum": 5},
              "code": {"type": "string", "minLength": 1},
              "pointer": {"type": "string"},
              "message": {"type": "string"},
              "interpretation": {"type": "integer", "minimum": 0, "maximum": 2},
              "blocks_run": {"type": "boolean"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "bounds": {
      "type": "object",
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "endpoint": {
      "type": "object",
      "required": [
        "node",
        "port"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "port": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "binding": {
      "type": "object",
      "properties": {
        "mode": {
          "const": "widget_value"
        },
        "public_input_id": {
          "type": "string"
        },
        "public_output_id": {
          "type": "string"
        },
        "interface_map_slot": {
          "type": "string"
        },
        "connection_requirement": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "choice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "integer"
        },
        "disabled": {
          "type": "boolean"
        },
        "visible": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "typeSchema": {
      "type": "object",
      "required": [
        "canonical",
        "choice_kind",
        "field_names",
        "choices",
        "children"
      ],
      "properties": {
        "canonical": {
          "type": "string"
        },
        "choice_kind": {
          "enum": [
            "none",
            "enum",
            "ring",
            "dropdown"
          ]
        },
        "field_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeSchema"
          }
        }
      },
      "additionalProperties": true
    },
    "applicationControl": {
      "type": "object",
      "required": [
        "profile",
        "kind",
        "expected_class",
        "value_schema",
        "target",
        "properties",
        "method_id",
        "parameters"
      ],
      "properties": {
        "profile": {
          "const": "frog.studio.application_control@1"
        },
        "kind": {
          "enum": [
            "reference",
            "property",
            "invoke",
            "close"
          ]
        },
        "expected_class": {
          "type": "string"
        },
        "value_schema": {
          "$ref": "#/$defs/typeSchema"
        },
        "target": {
          "type": "object",
          "required": [
            "kind",
            "owner_document",
            "widget_id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "unbound",
                "this_frog",
                "this_application",
                "front_panel",
                "widget"
              ]
            },
            "owner_document": {
              "type": "string"
            },
            "widget_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "member_id",
              "mode"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "member_id": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "read",
                  "write"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "method_id": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "enabled"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "widget": {
      "type": "object",
      "required": [
        "id",
        "bounds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "classId": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "valueType": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "layout": {
          "$ref": "#/$defs/bounds"
        },
        "props": {
          "type": "object"
        },
        "type_definition": {
          "$ref": "#/$defs/typeDefinitionLink"
        },
        "state": {
          "type": "object"
        },
        "geometry": {
          "type": "object"
        },
        "typography": {
          "type": "object"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "runtime": {
          "type": "object"
        },
        "studio_application_control": {
          "$ref": "#/$defs/applicationControl"
        },
        "studio_dotnet_reference": {
          "type": "object"
        },
        "type": {
          "type": "string"
        },
        "class_ref": {
          "type": "string"
        },
        "visual": {
          "type": "object"
        },
        "studio": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "$ref": "#/$defs/endpoint"
        },
        "to": {
          "$ref": "#/$defs/endpoint"
        },
        "bends": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "widget": {
          "type": "string"
        },
        "structure_type": {
          "type": "string"
        },
        "layout": {
          "$ref": "#/$defs/bounds"
        },
        "label": {
          "type": "string"
        },
        "label_visible": {
          "type": "boolean"
        },
        "value_type": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "palette_catalog_id": {
          "type": "string"
        },
        "constant_owner_node_id": {
          "type": "string"
        },
        "constant_field_id": {
          "type": "string"
        },
        "constant_field_order": {
          "type": "integer"
        },
        "type_definition": {
          "$ref": "#/$defs/typeDefinitionLink"
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "diagram"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "diagram": {
                "$ref": "#/$defs/graph"
              }
            },
            "additionalProperties": true
          }
        },
        "studio_application_control": {
          "$ref": "#/$defs/applicationControl"
        },
        "studio_connectivity": {
          "type": "object"
        },
        "studio_native_call": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "graph": {
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "wire_fragments": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "zoom_percent": {
          "type": "integer"
        },
        "viewport_origin": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graiphic.io/frog/sdk/ecosystem/0.1/frontend-semantic-context.schema.json",
  "description": "Accepted context shapes of frog.frontend.resolution@1 at the API-3 checkpoint. Schema validation does not check pointer existence, eligibility, overlap or support for other profiles.",
  "oneOf": [
    {
      "type": "object",
      "maxProperties": 0,
      "additionalProperties": false
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "dependencies"
      ],
      "properties": {
        "profile": {
          "const": "frog.frontend.resolution@1"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "source_pointer"
            ],
            "properties": {
              "kind": {
                "const": 2
              },
              "source_pointer": {
                "type": "string",
                "maxLength": 8192,
                "pattern": "^(?:/(?:[^~]|~[01])*)?$",
                "minLength": 1
              }
            }
          }
        },
        "conditional_disable": {
          "type": "object",
          "maxProperties": 0,
          "additionalProperties": false
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graiphic.io/frog/sdk/ecosystem/0.2/frontend-capabilities.schema.json",
  "description": "Frontend capability document 0.2 used by API 3. Document, C API, software and Source/FIR versions are independent; schema publication does not deliver an implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "source_formats",
    "fir_formats",
    "frontend_apis",
    "frontend",
    "api_operations",
    "profiles",
    "profiles_exhaustive",
    "default_limits",
    "effective_limits",
    "max_fir_bytes",
    "max_resolution_steps",
    "dependency_kinds",
    "dissemination",
    "native_execution_claim"
  ],
  "properties": {
    "schema": {
      "const": "frog.frontend.capabilities"
    },
    "schema_version": {
      "const": "0.2"
    },
    "source_formats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "version"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "fir_formats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "version"
        ],
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "frontend_apis": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "software_version",
        "api_version",
        "commit",
        "sha256"
      ],
      "properties": {
        "software_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "api_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "api_operations": {
      "type": "array",
      "items": {
        "enum": [
          "validate",
          "derive",
          "describe"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "profiles_exhaustive": {
      "const": false
    },
    "default_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_source_bytes",
        "max_dependency_bytes",
        "max_total_dependency_bytes",
        "max_result_bytes",
        "max_nodes",
        "max_connections",
        "max_nesting_depth",
        "max_dependencies",
        "max_diagnostics"
      ],
      "properties": {
        "max_source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_dependency_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_total_dependency_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_result_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_nesting_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_dependencies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_diagnostics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    },
    "effective_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_source_bytes",
        "max_dependency_bytes",
        "max_total_dependency_bytes",
        "max_result_bytes",
        "max_nodes",
        "max_connections",
        "max_nesting_depth",
        "max_dependencies",
        "max_diagnostics"
      ],
      "properties": {
        "max_source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_dependency_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_total_dependency_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_result_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_nodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_connections": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_nesting_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_dependencies": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "max_diagnostics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    },
    "max_fir_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "max_resolution_steps": {
      "type": "integer",
      "minimum": 1
    },
    "dependency_kinds": {
      "type": "array",
      "items": {
        "enum": [
          "type_definition"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "dissemination": {
      "const": "local"
    },
    "native_execution_claim": {
      "const": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graiphic.io/frog/sdk/ecosystem/0.1/frontend-dependencies.schema.json",
  "description": "Explicit CLI host-side dependency lock, version 1. Kind syntax is separate from advertised Frontend support. Relative file paths use the explicitly selected lock directory; no core file lookup is implied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "dependencies"
  ],
  "properties": {
    "format": {
      "const": "frog.frontend.dependencies"
    },
    "version": {
      "const": "1"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "reference",
          "source_uri",
          "identity",
          "version",
          "path"
        ],
        "properties": {
          "kind": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "reference": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[^\\u0000]*$"
          },
          "requesting_source_uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[^\\u0000]*$"
          },
          "source_uri": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[^\\u0000]*$"
          },
          "identity": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[^\\u0000]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[^\\u0000]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\u0000]*$"
          }
        }
      }
    }
  }
}

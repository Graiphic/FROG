          "maxLength": 2048
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    }
  },
  "description": "Versioned method payload under wire 0.1. Describe success uses a direct 0.1/0.2 description document instead; legacy describe/probe request is {}. Error/cancelled response may be {}. Limits apply to the whole encoded envelope. Envelope status determines whether response handles/receipts are mandatory; cross-document hashes, tuple equality and admission cannot be established by JSON Schema alone.",

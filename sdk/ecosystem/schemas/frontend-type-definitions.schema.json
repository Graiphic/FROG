{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graiphic.io/frog/sdk/ecosystem/0.1/frontend-type-definitions.schema.json",
  "description": "Dependency envelope used by frog.frontend.type-definitions@1. The envelope does not define or validate a second type language; selected fragments still undergo the applicable complete type-schema and semantic checks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "identity",
    "version",
    "definitions"
  ],
  "properties": {
    "profile": {
      "const": "frog.frontend.type-definitions@1"
    },
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192,
      "pattern": "^[^\\u0000]*$"
    },
    "definitions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}

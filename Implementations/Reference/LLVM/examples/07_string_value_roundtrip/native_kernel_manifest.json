    "path": "Versioning/Readme.md"
  },
  "review": {
    "last_reviewed": "2026-06-04",
    "scope": "Example 07 String native kernel manifest. The UI review covers the placeholder/text_value launch posture; kernel semantics remain string-in to string-out."
  },
  "kernel": {
    "id": "example07_string_roundtrip_kernel",
    "source_lowered_unit": "Examples/07_string_value_roundtrip/main.lowering.json",
    "backend": {
      "family": "llvm",
      "artifact_kind": "native_object_or_library",
      "source_artifact": "Implementations/Reference/LLVM/examples/07_string_value_roundtrip/kernel.ll",
      "artifact_library": {
        "windows": "frog_example07_kernel.dll",
        "linux": "libfrog_example07_kernel.so",
        "macos": "libfrog_example07_kernel.dylib"
      }
    },
    "entry": {
      "symbol": "frog_example07_run",
      "abi": "frog_string_utf8_256_to_result_status_outptr"
    },
    "io": {
      "inputs": [
        {
          "id": "input_text",
          "type": "string",
          "encoding": "utf8",
          "max_bytes": 256
        }
      ],
      "outputs": [
        {
          "id": "result_text",
          "type": "string",
          "encoding": "utf8",
          "max_bytes": 256
        }
      ]
    },
    "result_status_layout": {
      "carrier": "out_parameter",
      "c_signature": "void frog_example07_run(const uint8_t* input_ptr, uint32_t input_len, FrogStringRunResult* out_result)",
      "fields": [
        {
          "id": "ok",
          "type": "u8"
        },
        {
          "id": "error_code",
          "type": "u16"
        },
        {
          "id": "result_len",
          "type": "u32"
        },
        {
          "id": "result_buffer",
          "type": "u8[256]",
          "logical_type": "utf8_string"
        }
      ]
    },
    "error_model": {
      "overflow": "reject_execution_on_string_buffer_overflow",
      "error_codes": [
        {
          "code": 0,
          "meaning": "no_error"
        },
        {
          "code": 1,
          "meaning": "string_buffer_overflow",
          "diagnostic": "result_text must remain within 256 UTF-8 bytes."
        }
      ]
    }
  },

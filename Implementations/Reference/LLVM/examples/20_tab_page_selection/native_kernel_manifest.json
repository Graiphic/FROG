{
  "artifact_kind": "frog_native_kernel_manifest",
  "artifact_governance_ref": {
    "path": "Versioning/Readme.md"
  },
  "kernel": {
    "id": "example20_tab_page_selection_kernel",
    "source_lowered_unit": "Examples/20_tab_page_selection/main.lowering.json",
    "backend": {
      "family": "llvm",
      "artifact_kind": "native_dynamic_library",
      "source_artifact": "Implementations/Reference/LLVM/examples/20_tab_page_selection/kernel.ll",
      "artifact_library": {
        "windows": "frog_example20_tab_kernel.dll",
        "linux": "libfrog_example20_tab_kernel.so",
        "macos": "libfrog_example20_tab_kernel.dylib"
      }
    },
    "entry": {
      "symbol": "frog_example20_run",
      "abi": "frog_string_utf8_256_to_result_status_outptr"
    },
    "io": {
      "inputs": [
        {
          "id": "selected_page_id",
          "type": "string",
          "encoding": "utf8",
          "max_bytes": 256
        }
      ],
      "outputs": [
        {
          "id": "selected_page_id_out",
          "type": "string",
          "encoding": "utf8",
          "max_bytes": 256
        }
      ]
    },
    "result_status_layout": {
      "carrier": "out_parameter",
      "c_signature": "void frog_example20_run(const uint8_t* input_ptr, uint32_t input_len, FrogStringRunResult* out_result)",
      "fields": [
        {
          "id": "ok",
          "type": "u8"
        },
        {
          "id": "error_code",
          "type": "u16"
        },
        {
          "id": "result_len",
          "type": "u32"
        },
        {
          "id": "result_buffer",
          "type": "u8[256]",
          "logical_type": "utf8_string"
        }
      ]
    },
    "error_model": {
      "overflow": "reject_execution_on_string_buffer_overflow",
      "error_codes": [
        {
          "code": 0,
          "meaning": "no_error"
        },
        {
          "code": 1,
          "meaning": "string_buffer_overflow",
          "diagnostic": "selected_page_id_out must remain within 256 UTF-8 bytes."
        }
      ]
    }
  },
  "runtime_boundary": {
    "reference": "Implementations/Reference/Runtime/KernelBridge.md",
    "runtime_dependency_posture": "runtime_consumes_manifest_declared_kernel_not_llvm_directly"
  }
}

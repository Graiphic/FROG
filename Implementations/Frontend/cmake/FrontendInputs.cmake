# One input identity implementation for embedded and standalone builds.
function(frog_frontend_input_identity frontend_root out_hash out_manifest)
    file(READ "${frontend_root}/source-origin.json" origins)
    string(JSON origin_count LENGTH "${origins}" sources)
    math(EXPR last_origin "${origin_count} - 1")
    set(content_identity "")
    foreach(i RANGE 0 ${last_origin})
        string(JSON entry GET "${origins}" sources ${i})
        string(JSON path GET "${entry}" path)
        string(JSON expected GET "${entry}" sha256)
        string(JSON ownership GET "${entry}" ownership)
        if(NOT EXISTS "${frontend_root}/${path}")
            message(FATAL_ERROR "Frontend input missing: ${path}")
        endif()
        file(SHA256 "${frontend_root}/${path}" actual)
        if(ownership STREQUAL "snapshot" AND NOT actual STREQUAL expected)
            message(FATAL_ERROR "Frontend declaration snapshot drift: ${path}")
        endif()
        if(ownership STREQUAL "snapshot" AND FROG_FRONTEND_UPSTREAM_ROOT)
            string(JSON upstream GET "${entry}" upstream)
            file(SHA256 "${FROG_FRONTEND_UPSTREAM_ROOT}/${upstream}" upstream_actual)
            if(NOT upstream_actual STREQUAL actual)
                message(FATAL_ERROR "Frontend upstream declaration differs: ${upstream}")
            endif()
        endif()
        string(APPEND content_identity "${path}:${actual}\n")
    endforeach()
    # The component identity covers the CLI even in a library-only consumer.
    foreach(path IN ITEMS src/FrontendApi.cpp src/FrontendOperation.cpp src/FrontendCli.cpp CMakeLists.txt production-sources.cmake)
        if(EXISTS "${frontend_root}/${path}")
            file(SHA256 "${frontend_root}/${path}" actual)
            string(APPEND content_identity "${path}:${actual}\n")
        endif()
    endforeach()
    string(SHA256 FROG_FRONTEND_CONTENT_SHA256 "${content_identity}")
    set(${out_hash} "${FROG_FRONTEND_CONTENT_SHA256}" PARENT_SCOPE)
    set(${out_manifest} "${content_identity}" PARENT_SCOPE)
endfunction()

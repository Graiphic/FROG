{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_numeric_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.numeric",
    "name": "FROG Default Numeric Realization",
    "namespace": "frog.realizations.default.numeric",
    "family": "default",
    "category": "value",
    "role_posture": "control_indicator",
    "summary": "Machine-readable default realization manifest for standardized numeric widgets."
  },
  "ownership_boundary": {
    "owns": [
      "default numeric realization records",
      "numeric realization variant declarations",
      "numeric realization resource references",
      "numeric part bindings",
      "numeric state maps",
      "numeric realization property bindings",
      "numeric anchors",
      "numeric host hints",
      "numeric realization validation expectations"
    ],
    "does_not_own": [
      "numeric widget class law",
      "numeric representation semantics",
      "numeric value semantics",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private numeric handles",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Numeric.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.numeric_control",
      "role": "control",
      "primary_value": {
        "present": true,
        "kind": "numeric_scalar",
        "user_mutable": true
      }
    },
    {
      "class_id": "frog.widgets.numeric_indicator",
      "role": "indicator",
      "primary_value": {
        "present": true,
        "kind": "numeric_scalar",
        "user_mutable": false
      }
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.numeric_control",
      "frog.realizations.default.numeric_indicator"
    ],
    "variants": [
      "frog.realizations.default.numeric.rectangular"
    ],
    "resources": [
      "frog.realizations.default.numeric.assets.rectangular_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.numeric_control",
      "family": "default",
      "target_class": "frog.widgets.numeric_control",
      "variant_property": "realization.variant",
      "default_variant": "rectangular",
      "supported_variants": [
        "rectangular"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "frame",
        "control_body",
        "indicator_body",
        "value_face",
        "text_value",
        "spinner",
        "increment_up",
        "increment_down",
        "radix_badge",
        "unit_label",
        "focus_ring"
      ],
      "supported_visual_states": [
        "normal",
        "hovered",
        "focused",
        "pressed",
        "disabled",
        "read_only",
        "out_of_range"
      ],
      "fallbacks": {
        "missing_spinner": "host_native_spinner_or_hidden",
        "missing_caption": "host_external_caption_region",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    },
    {
      "id": "frog.realizations.default.numeric_indicator",
      "family": "default",
      "target_class": "frog.widgets.numeric_indicator",
      "variant_property": "realization.variant",
      "default_variant": "rectangular",
      "supported_variants": [
        "rectangular"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "frame",
        "indicator_body",
        "value_face",
        "text_value",
        "radix_badge",
        "unit_label",
        "focus_ring"
      ],
      "supported_visual_states": [
        "normal",
        "focused",
        "pressed",
        "disabled",
        "out_of_range"
      ],
      "fallbacks": {
        "missing_caption": "host_external_caption_region",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "variants": [
    {
      "id": "frog.realizations.default.numeric.rectangular",
      "variant": "rectangular",
      "target_classes": [
        "frog.widgets.numeric_control",
        "frog.widgets.numeric_indicator"
      ],
      "resource_ref": "frog.realizations.default.numeric.assets.rectangular_svg",
      "geometry_posture": {
        "shape_family": "rectangular",
        "layout_source": "front_panel_layout_rectangle",
        "scales_to_layout": true,
        "supports_spinner_cluster": true,
        "supports_caption": true,
        "supports_unit_label": true,
        "supports_radix_badge": true
      },
      "fallback": "host_rectangle_numeric"
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.numeric.assets.rectangular_svg",
      "kind": "svg",
      "path": "./assets/numeric/templates/numeric_rectangular.svg",
      "target_classes": [
        "frog.widgets.numeric_control",
        "frog.widgets.numeric_indicator"
      ],
      "target_variant": "rectangular",
      "template_markers": {
        "template": "frog.realizations.default.numeric.rectangular",
        "variant": "rectangular",
        "part_attribute": "data-frog-part",
        "binding_attribute": "data-frog-bind",
        "member_attribute": "data-frog-member",
        "anchor_attribute": "data-frog-anchor"
      }
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_element",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "label",
      "binding_kind": "svg_text_or_metadata",
      "binding_selector": "[data-frog-part='label']",
      "semantic_member": "label.text"
    },
    {
      "part": "caption",
      "binding_kind": "svg_text_or_host_text",
      "binding_selector": "[data-frog-part='caption']",
      "semantic_member": "caption.text",
      "style_binding_group": "style.caption"
    },
    {
      "part": "frame",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='frame']",
      "style_binding_group": "style.frame"
    },
    {
      "part": "value_face",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='value_face']",
      "style_binding_group": "style.value_face"
    },
    {
      "part": "text_value",
      "binding_kind": "svg_text_or_host_text",
      "binding_selector": "[data-frog-part='text_value']",
      "semantic_member": "value",
      "style_binding_group": "style.text_value"
    },
    {
      "part": "spinner",
      "binding_kind": "svg_group_or_host_spinner",
      "binding_selector": "[data-frog-part='spinner']",
      "visibility_member": "display.increment_buttons_visible"
    },
    {
      "part": "increment_up",
      "binding_kind": "svg_group_or_host_button",
      "binding_selector": "[data-frog-part='increment_up']",
      "method_member": "increment()"
    },
    {
      "part": "increment_down",
      "binding_kind": "svg_group_or_host_button",
      "binding_selector": "[data-frog-part='increment_down']",
      "method_member": "decrement()"
    },
    {
      "part": "radix_badge",
      "binding_kind": "svg_text_or_host_badge",
      "binding_selector": "[data-frog-part='radix_badge']",
      "visibility_member": "display.radix_visible"
    },
    {
      "part": "unit_label",
      "binding_kind": "svg_text_or_host_text",
      "binding_selector": "[data-frog-part='unit_label']",
      "semantic_member": "unit_label.text",
      "visibility_member": "unit_label.visible"
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='focus_ring']",
      "style_binding_group": "style.focus_ring"
    }
  ],
  "state_maps": [
    {
      "state": "normal"
    },
    {
      "state": "hovered",
      "value_condition": {
        "interaction.hovered": true
      },
      "inherits": "normal",
      "property_bindings": [
        "style.increment_button.fill_color.hover",
        "style.increment_button.symbol_color.hover",
        "style.increment_button.border_color.hover"
      ]
    },
    {
      "state": "focused",
      "value_condition": {
        "interaction.focused": true
      },
      "inherits": "normal",
      "property_bindings": [
        "style.focus_ring.visible",
        "style.focus_ring.color"
      ]
    },
    {
      "state": "pressed",
      "value_condition": {
        "interaction.pressed": true
      },
      "inherits": "normal",
      "property_bindings": [
        "style.increment_button.fill_color.pressed",
        "style.increment_button.symbol_color.pressed",
        "style.increment_button.border_color.pressed"
      ]
    },
    {
      "state": "disabled",
      "value_condition": {
        "interaction.enabled": false
      },
      "inherits": "normal",
      "property_bindings": [
        "style.disabled.opacity"
      ]
    },
    {
      "state": "read_only",
      "value_condition": {
        "interaction.read_only": true
      },
      "inherits": "normal"
    },
    {
      "state": "out_of_range",
      "value_condition": {
        "numeric_value_out_of_range": true
      },
      "inherits": "normal"
    }
  ],
  "property_bindings": [
    {
      "member": "label.text",
      "target_part": "label",
      "target_operation": "set_text_content"
    },
    {
      "member": "label.visible",
      "target_part": "label",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.text",
      "target_part": "caption",
      "target_operation": "set_text_content"
    },
    {
      "member": "caption.visible",
      "target_part": "caption",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.anchor.x",
      "target_part": "caption",
      "target_operation": "set_anchor_x"
    },
    {
      "member": "caption.anchor.y",
      "target_part": "caption",
      "target_operation": "set_anchor_y"
    },
    {
      "member": "caption.align.horizontal",
      "target_part": "caption",
      "target_operation": "set_text_anchor_alignment"
    },
    {
      "member": "value",
      "target_part": "text_value",
      "target_operation": "format_and_set_text"
    },
    {
      "member": "display.format_kind",
      "target_part": "text_value",
      "target_operation": "select_format_kind"
    },
    {
      "member": "display.format_string",
      "target_part": "text_value",
      "target_operation": "select_custom_format"
    },
    {
      "member": "display.increment_buttons_visible",
      "target_part": "spinner",
      "target_operation": "set_visibility"
    },
    {
      "member": "display.radix_visible",
      "target_part": "radix_badge",
      "target_operation": "set_visibility"
    },
    {
      "member": "unit_label.text",
      "target_part": "unit_label",
      "target_operation": "set_text_content"
    },
    {
      "member": "unit_label.visible",
      "target_part": "unit_label",
      "target_operation": "set_visibility"
    },
    {
      "member": "style.caption.*",
      "target_part": "caption",
      "target_operation": "apply_caption_style"
    },
    {
      "member": "style.frame.*",
      "target_part": "frame",
      "target_operation": "apply_frame_style"
    },
    {
      "member": "style.value_face.*",
      "target_part": "value_face",
      "target_operation": "apply_value_face_style"
    },
    {
      "member": "style.text_value.*",
      "target_part": "text_value",
      "target_operation": "apply_text_style"
    },
    {
      "member": "style.spinner.*",
      "target_part": "spinner",
      "target_operation": "apply_spinner_style"
    },
    {
      "member": "style.increment_button.*",
      "target_part": "increment_up",
      "target_operation": "apply_increment_button_style"
    },
    {
      "member": "style.increment_button.*",
      "target_part": "increment_down",
      "target_operation": "apply_increment_button_style"
    },
    {
      "member": "style.focus_ring.*",
      "target_part": "focus_ring",
      "target_operation": "apply_focus_ring_style"
    }
  ],
  "anchors": [
    {
      "id": "frog.realizations.default.numeric.label.anchor",
      "target_part": "label",
      "source_selector": "[data-frog-anchor='label.anchor']",
      "anchor_kind": "text_anchor"
    },
    {
      "id": "frog.realizations.default.numeric.caption.anchor",
      "target_part": "caption",
      "source_selector": "[data-frog-anchor='caption.anchor']",
      "anchor_kind": "text_anchor"
    },
    {
      "id": "frog.realizations.default.numeric.text_value.center",
      "target_part": "text_value",
      "source_selector": "[data-frog-anchor='text_value.center']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "center",
      "default_vertical_alignment": "middle"
    }
  ],
  "host_hints": {
    "preferred_host_kind": "svg_template_host",
    "resize_posture": "scale_template_to_front_panel_layout_rectangle",
    "text_rendering_posture": "host_may_replace_template_text_content",
    "style_application_posture": "apply_property_bindings_before_render",
    "default_value_posture": "semantic_default_value_is_source_or_class_owned_not_realization_owned",
    "default_compact_geometry": {
      "posture": "labview_like_value_face_plus_array_indexer_style_vertical_increment_decrement",
      "view_box_width": 220,
      "view_box_height": 88,
      "body_height": 30,
      "value_face_width": 74,
      "value_to_spinner_gap": 4,
      "spinner_width": 16,
      "spinner_button_height": 14,
      "spinner_button_gap": 2,
      "control_body_width": 94,
      "indicator_body_width": 74,
      "default_label_anchor_x": 18,
      "default_caption_anchor_x": 18,
      "proportionality_rule": "hosts must preserve these part ratios when embedding the Default Numeric SVG as an Array element or other contained widget surface; the increment/decrement buttons use the same separated-button proportion as the Default Array index display, mirrored to the right of the value face"
    },
    "numeric_representation_surface": {
      "posture": "representation_is_source_owned_and_runtime_interpreted",
      "canonical_members": [
        "data_type.representation",
        "data_type.named_numeric_size"
      ],
      "compatibility_aliases": [
        "representation.kind"
      ],
      "supported_named_sizes": [
        {
          "name": "EXT",
          "representation": "ext",
          "kind": "floating_point",
          "precision": "extended_host_or_backend_defined"
        },
        {
          "name": "DBL",
          "representation": "dbl",
          "kind": "floating_point",
          "bits": 64
        },
        {
          "name": "SGL",
          "representation": "sgl",
          "kind": "floating_point",
          "bits": 32
        },
        {
          "name": "FXP",
          "representation": "fxp",
          "kind": "fixed_point"
        },
        {
          "name": "I64",
          "representation": "i64",
          "kind": "integer",
          "signed": true,
          "bits": 64
        },
        {
          "name": "I32",
          "representation": "i32",
          "kind": "integer",
          "signed": true,
          "bits": 32
        },
        {
          "name": "I16",
          "representation": "i16",
          "kind": "integer",
          "signed": true,
          "bits": 16
        },
        {
          "name": "I8",
          "representation": "i8",
          "kind": "integer",
          "signed": true,
          "bits": 8
        },
        {
          "name": "U64",
          "representation": "u64",
          "kind": "integer",
          "signed": false,
          "bits": 64
        },
        {
          "name": "U32",
          "representation": "u32",
          "kind": "integer",
          "signed": false,
          "bits": 32
        },
        {
          "name": "U16",
          "representation": "u16",
          "kind": "integer",
          "signed": false,
          "bits": 16
        },
        {
          "name": "U8",
          "representation": "u8",
          "kind": "integer",
          "signed": false,
          "bits": 8
        },
        {
          "name": "CXT",
          "representation": "cxt",
          "kind": "complex",
          "precision": "extended_host_or_backend_defined"
        },
        {
          "name": "CDB",
          "representation": "cdb",
          "kind": "complex",
          "component_representation": "dbl"
        },
        {
          "name": "CSG",
          "representation": "csg",
          "kind": "complex",
          "component_representation": "sgl"
        }
      ],
      "validated_runtime_scope": "runtimes must only accept representations proven by the source/FIR/lowering/native artifact corridor under test"
    },
    "accessibility_posture": {
      "roles": {
        "frog.widgets.numeric_control": "spinbutton",
        "frog.widgets.numeric_indicator": "status"
      },
      "value_source": "value",
      "label_source": "label.text",
      "caption_source": "caption.text"
    }
  },
  "validation_expectations": [
    "target classes must exist in Libraries/Widgets/Numeric.md",
    "all declared public parts must exist in the numeric class law",
    "resources must resolve relative to this package file",
    "resource SVG templates should expose data-frog-part markers for declared parts",
    "property bindings must target public numeric members declared by class law",
    "semantic default_value must come from the numeric class/source instance or containing widget model",
    "numeric representation must come from source-owned data_type.representation or its documented compatibility alias",
    "runtime-facing examples must validate that the source-owned representation matches the native artifact ABI corridor before accepting edits",
    "variant selection must not create a new widget class"
  ]
}

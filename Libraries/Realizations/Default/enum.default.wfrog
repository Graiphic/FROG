{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_enum_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "publication_review": {
    "last_reviewed": "2026-06-12",
    "scope": "Default Enum compact value SVG, placement aura, optional increment/decrement command parts, dropdown list SVG skin, dropdown host-surface layout, semantic public parts, and shared compact finite-choice visual posture with Default Ring.",
    "public_posture": "Publishes the compact value skin, popup list skin, reusable default widget properties, popup layout contract, supported semantic parts, and review date; visual posture may share host rendering code with Default Ring, but Enum value semantics remain the Enum widget class law."
  },
  "package": {
    "id": "frog.realizations.default.enum",
    "name": "FROG Default Enum Realization",
    "namespace": "frog.realizations.default.enum",
    "family": "default",
    "category": "value",
    "role_posture": "control_indicator",
    "summary": "Machine-readable default realization manifest for standardized enum widgets."
  },
  "ownership_boundary": {
    "owns": [
      "enum realization records",
      "enum resources",
      "enum part bindings",
      "enum state maps",
      "enum property bindings",
      "enum anchors",
      "enum host hints"
    ],
    "does_not_own": [
      "enum widget class law",
      "enum item semantics",
      "enum value semantics",
      "canonical .frog source",
      "frog.ui primitive semantics"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Enum.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.enum_control",
      "role": "control",
      "primary_value": {
        "present": true,
        "kind": "enum_item_id",
        "user_mutable": true
      }
    },
    {
      "class_id": "frog.widgets.enum_indicator",
      "role": "indicator",
      "primary_value": {
        "present": true,
        "kind": "enum_item_id",
        "user_mutable": false
      }
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.enum_control",
      "frog.realizations.default.enum_indicator"
    ],
    "variants": [
      "frog.realizations.default.enum.rectangular_ring"
    ],
    "resources": [
      "frog.realizations.default.enum.assets.rectangular_ring_svg",
      "frog.realizations.default.enum.assets.dropdown_list_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.enum_control",
      "family": "default",
      "target_class": "frog.widgets.enum_control",
      "default_variant": "rectangular_ring",
      "supported_parts": [
        "root",
        "placement_bounds",
        "label",
        "caption",
        "value_face",
        "focus_ring",
        "value_display",
        "spinner",
        "increment_up",
        "increment_down"
      ],
      "supported_visual_states": [
        "normal",
        "focused",
        "disabled",
        "opened",
        "pressed"
      ]
    },
    {
      "id": "frog.realizations.default.enum_indicator",
      "family": "default",
      "target_class": "frog.widgets.enum_indicator",
      "default_variant": "rectangular_ring",
      "supported_parts": [
        "root",
        "placement_bounds",
        "label",
        "caption",
        "value_face",
        "focus_ring",
        "value_display"
      ],
      "supported_visual_states": [
        "normal",
        "focused",
        "disabled"
      ]
    }
  ],
  "variants": [
    {
      "id": "frog.realizations.default.enum.rectangular_ring",
      "variant": "rectangular_ring",
      "target_classes": [
        "frog.widgets.enum_control",
        "frog.widgets.enum_indicator"
      ],
      "resource_ref": "frog.realizations.default.enum.assets.rectangular_ring_svg",
      "popup_resource_ref": "frog.realizations.default.enum.assets.dropdown_list_svg"
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.enum.assets.rectangular_ring_svg",
      "kind": "svg",
      "path": "./assets/enum/templates/enum_rectangular_ring.svg",
      "target_classes": [
        "frog.widgets.enum_control",
        "frog.widgets.enum_indicator"
      ],
      "target_variant": "rectangular_ring"
    },
    {
      "id": "frog.realizations.default.enum.assets.dropdown_list_svg",
      "kind": "svg",
      "path": "./assets/enum/templates/enum_dropdown_list.svg",
      "target_classes": [
        "frog.widgets.enum_control"
      ],
      "target_variant": "rectangular_ring",
      "host_surface": "dropdown"
    }
  ],
  "default_widget_properties": [
    {
      "class_id": "frog.widgets.enum_control",
      "role": "control",
      "visual": {
        "resource_ref": "frog.realizations.default.enum.assets.rectangular_ring_svg",
        "popup_resource_ref": "frog.realizations.default.enum.assets.dropdown_list_svg"
      },
      "props": {
        "display.increment_buttons_visible": true,
        "data_entry.increment_wrap": true,
        "style.scale.reference_width": 200,
        "style.scale.reference_height": 130,
        "style.value_face.fill_color": "#ffffff",
        "style.value_face.fill_color.hover": "#eef6ff",
        "style.value_face.border_color": "#A8ABAE",
        "style.value_face.border_color.hover": "#8E9297",
        "style.value_face.border_width": "1px",
        "style.value_display.color": "#111827",
        "style.value_display.font_size": "16px",
        "style.value_display.font_size_mode": "scale_with_widget",
        "style.value_display.font_weight": "400",
        "style.value_display.vertical_offset": "-2px",
        "style.value_display.vertical_offset_mode": "scale_with_widget",
        "style.value_display.padding_inline": "8px",
        "style.value_display.padding_inline_mode": "scale_with_widget",
        "style.focus_ring.color": "#2563eb",
        "style.focus_ring.width": "2px",
        "style.increment_button.fill_color.normal": "#edf2f7",
        "style.increment_button.fill_color.hover": "#dbeafe",
        "style.increment_button.fill_color.pressed": "#bfdbfe",
        "style.increment_button.border_color.normal": "#94a3b8",
        "style.increment_button.border_color.hover": "#64748b",
        "style.increment_button.border_color.pressed": "#2563eb",
        "style.increment_button.symbol_color.normal": "#334e68",
        "style.increment_button.symbol_color.hover": "#1d4ed8",
        "style.increment_button.symbol_color.pressed": "#1e40af",
        "style.dropdown.fill_color": "#ffffff",
        "style.dropdown.border_color": "#64748b",
        "style.dropdown.border_width": "1px",
        "style.dropdown.border_width_mode": "scale_with_widget",
        "style.dropdown.option.fill_color": "#ffffff",
        "style.dropdown.option.text_color": "#111827",
        "style.dropdown.option.hover_fill_color": "#dbeafe",
        "style.dropdown.option.hover_text_color": "#111827",
        "style.dropdown.option.selected_fill_color": "#3b6db5",
        "style.dropdown.option.selected_text_color": "#ffffff",
        "style.dropdown.option.font_family": "Segoe UI,Arial,sans-serif",
        "style.dropdown.option.font_size": "14px",
        "style.dropdown.option.font_size_mode": "scale_with_widget",
        "style.dropdown.option.font_weight": "400",
        "style.dropdown.option.font_style": "normal",
        "style.dropdown.option.padding_inline": "7px",
        "style.dropdown.option.padding_inline_mode": "scale_with_widget",
        "style.dropdown.option.height": "24px",
        "style.dropdown.option.height_mode": "scale_with_widget",
        "interaction.enabled": true,
        "interaction.read_only": false,
        "realization.variant": "rectangular_ring"
      }
    },
    {
      "class_id": "frog.widgets.enum_indicator",
      "role": "indicator",
      "visual": {
        "resource_ref": "frog.realizations.default.enum.assets.rectangular_ring_svg"
      },
      "props": {
        "style.scale.reference_width": 200,
        "style.scale.reference_height": 130,
        "style.value_face.fill_color": "#E8EBED",
        "style.value_face.border_color": "#A8ABAE",
        "style.value_face.border_width": "1px",
        "style.value_display.color": "#111827",
        "style.value_display.font_size": "16px",
        "style.value_display.font_size_mode": "scale_with_widget",
        "style.value_display.font_weight": "400",
        "style.value_display.vertical_offset": "-2px",
        "style.value_display.vertical_offset_mode": "scale_with_widget",
        "style.value_display.padding_inline": "8px",
        "style.value_display.padding_inline_mode": "scale_with_widget",
        "style.focus_ring.color": "#2563eb",
        "style.focus_ring.width": "2px",
        "interaction.enabled": false,
        "interaction.read_only": true,
        "realization.variant": "rectangular_ring"
      }
    }
  ],
  "host_surface_bindings": [
    {
      "surface": "dropdown",
      "resource_ref": "frog.realizations.default.enum.assets.dropdown_list_svg",
      "supported_parts": [
        "root",
        "list_panel",
        "option_row",
        "option_text"
      ],
      "panel_part": "list_panel",
      "repeat_part": "option_row",
      "text_part": "option_text",
      "semantic_members": [
        "items[]",
        "items[].text",
        "selected.*"
      ],
      "layout": {
        "anchor_part": "value_face",
        "x": "center_on_anchor",
        "y": "bottom",
        "width": "outer_width",
        "source_width_outset_units": 2.923,
        "height": "repeated_part_stack",
        "outer_box_stroke_width_property": "style.value_face.border_width",
        "outer_box_stroke_width_mode_property": "style.value_face.border_width_mode",
        "included_parts": [
          "value_face"
        ]
      }
    }
  ],
  "part_bindings": [
    {
      "part": "placement_bounds",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='placement_bounds']",
      "semantic_members": [
        "layout.placement_bounds.*",
        "layout.grid.*",
        "layout.resize.*"
      ],
      "placement_role": "widget_placement_aura_not_focus_not_selection_optional_grid_snap_policy"
    },
    {
      "part": "label",
      "semantic_member": "label.text"
    },
    {
      "part": "caption",
      "semantic_member": "caption.text"
    },
    {
      "part": "value_display",
      "semantic_members": [
        "value",
        "selected.text",
        "items[]"
      ]
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='focus_ring']",
      "geometry_contract": "same_outer_bounds_as_value_face; excludes spinner, increment_up, and increment_down",
      "style_binding_group": "style.focus_ring",
      "state_sensitive": true
    },
    {
      "part": "spinner",
      "visibility_member": "display.increment_buttons_visible"
    },
    {
      "part": "increment_up",
      "semantic_member": "select_next()",
      "method_member": "increment()"
    },
    {
      "part": "increment_down",
      "semantic_member": "select_previous()",
      "method_member": "decrement()"
    }
  ],
  "state_maps": [
    {
      "state": "normal"
    },
    {
      "state": "focused",
      "property_bindings": [
        "style.focus_ring.visible",
        "style.focus_ring.color",
        "style.focus_ring.width"
      ]
    },
    {
      "state": "disabled"
    },
    {
      "state": "opened"
    },
    {
      "state": "pressed"
    }
  ],
  "property_bindings": [
    {
      "member": "caption.text",
      "target_part": "caption",
      "target_operation": "set_text_content"
    },
    {
      "member": "caption.visible",
      "target_part": "caption",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.anchor.x",
      "target_part": "caption",
      "target_operation": "set_anchor_x"
    },
    {
      "member": "caption.anchor.y",
      "target_part": "caption",
      "target_operation": "set_anchor_y"
    },
    {
      "member": "caption.align.horizontal",
      "target_part": "caption",
      "target_operation": "set_text_anchor_alignment"
    },
    {
      "member": "caption.style.text_color",
      "target_part": "caption",
      "target_operation": "set_text_fill"
    },
    {
      "member": "caption.style.font_family",
      "target_part": "caption",
      "target_operation": "set_text_font_family"
    },
    {
      "member": "caption.style.font_size",
      "target_part": "caption",
      "target_operation": "set_text_font_size"
    },
    {
      "member": "caption.style.font_weight",
      "target_part": "caption",
      "target_operation": "set_text_font_weight"
    },
    {
      "member": "value",
      "target_part": "value_display",
      "target_operation": "render_selected_item"
    },
    {
      "member": "items[]",
      "target_part": "value_display",
      "target_operation": "resolve_selected_item_text"
    },
    {
      "member": "display.increment_buttons_visible",
      "target_part": "spinner",
      "target_operation": "set_visibility"
    },
    {
      "member": "style.increment_button.*",
      "target_part": "increment_up",
      "target_operation": "apply_increment_button_style"
    },
    {
      "member": "style.increment_button.*",
      "target_part": "increment_down",
      "target_operation": "apply_increment_button_style"
    },
    {
      "member": "style.focus_ring.*",
      "target_part": "focus_ring",
      "target_operation": "apply_focus_ring_style"
    },
    {
      "member": "layout.placement_bounds.*",
      "target_part": "placement_bounds",
      "target_operation": "publish_placement_aura"
    },
    {
      "member": "layout.grid.*",
      "target_part": "placement_bounds",
      "target_operation": "publish_grid_snap_policy"
    }
  ],
  "anchors": [
    {
      "id": "frog.realizations.default.enum.label.anchor",
      "target_part": "label",
      "source_selector": "[data-frog-anchor='label.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.enum.caption.anchor",
      "target_part": "caption",
      "source_selector": "[data-frog-anchor='caption.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.enum.value_display.left_center",
      "target_part": "value_display",
      "source_selector": "[data-frog-anchor='value_display.left_center']",
      "anchor_kind": "text_anchor"
    }
  ],
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_single_selector",
    "popup_posture": "host_may_provide_native_popup_for_item_selection",
    "style_property_source": ".frog instance props overriding Default realization values",
    "default_compact_geometry": {
      "posture": "labview_like_value_face_plus_array_indexer_style_vertical_increment_decrement",
      "view_box_width": 200,
      "view_box_height": 130,
      "placement_grid_pitch": 16,
      "placement_bounds_part": "placement_bounds",
      "placement_bounds_x": 0,
      "placement_bounds_y": 72,
      "placement_bounds_width": 176,
      "placement_bounds_height": 38,
      "placement_bounds_posture": "widget_aura_with_optional_grid_snap_policy_not_focus_or_selection",
      "placement_aura_padding": 4,
      "placement_aura_padding_rule": "uniform band around the compact enum body; top_left and top_right snap to the common grid only when source_or_container_policy_declares_snap; Array cells consume placement_bounds, not value_face or spinner geometry",
      "body_height": 30,
      "value_face_x": 24,
      "value_face_y": 76,
      "value_face_width": 148,
      "value_face_height": 30,
      "spinner_x": 4,
      "spinner_width": 16,
      "spinner_button_height": 14,
      "spinner_button_gap": 2,
      "default_control_value_face_fill_color": "#ffffff",
      "default_indicator_value_face_fill_color": "#E8EBED",
      "default_value_face_border_color": "#A8ABAE",
      "default_value_face_border_width": "1px",
      "focus_ring_posture": "widget_focus_interaction_part_not_placement_aura_not_ide_selection",
      "proportionality_rule": "hosts must preserve placement_bounds as the contained-widget footprint when embedding the Default Enum SVG in Array cells; hidden increment/decrement buttons allow value_face to expand over the compact body without changing placement_bounds"
    }
  },
  "validation_expectations": [
    "target classes must exist in Libraries/Widgets/Enum.md",
    "value must resolve to a declared item unless undefined runtime values are explicitly allowed",
    "items must preserve stable ids",
    "accepted visual defaults are manifest data merged before source-owned instance overrides, not runtime constants",
    "placement_bounds must be present as a non-rendered public placement aura and must not be confused with focus_ring, dropdown selection, or Array cell selection",
    "Array cells embedding Default Enum consume placement_bounds as the cell footprint; control_body, value_face, spinner, increment_up, and increment_down are internal widget parts, not the cell boundary",
    "Default Enum and Default Ring may share compact visual posture, placement geometry, increment/decrement affordances, popup skin posture, and Array containment law; they must not share terminal value semantics.",
    "focus_ring covers only the value_face outer boundary; increment/decrement command parts keep their own geometry and are not enclosed by focus.",
    "increment/decrement commands must navigate the declared items[] order, honor display.increment_buttons_visible, and honor data_entry.increment_wrap; the Default posture sets increment_wrap true for circular next/previous item stepping",
    "when embedded in Array, the dropdown host surface must render as an Array overlay above the viewport and must not be clipped by the repeated cell box; hover and pressed button states must remain visible on increment_up and increment_down"
  ]
}

{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_enum_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "publication_review": {
    "last_reviewed": "2026-06-06",
    "scope": "Default Enum closed selector SVG, optional increment/decrement command parts, dropdown list SVG skin, dropdown host-surface layout, and semantic public parts.",
    "public_posture": "Publishes the closed selector skin, popup list skin, reusable default widget properties, popup layout contract, supported semantic parts, and review date; runtime implementation code remains outside the public publication scope."
  },
  "package": {
    "id": "frog.realizations.default.enum",
    "name": "FROG Default Enum Realization",
    "namespace": "frog.realizations.default.enum",
    "family": "default",
    "category": "value",
    "role_posture": "control_indicator",
    "summary": "Machine-readable default realization manifest for standardized enum widgets."
  },
  "ownership_boundary": {
    "owns": [
      "enum realization records",
      "enum resources",
      "enum part bindings",
      "enum state maps",
      "enum property bindings",
      "enum anchors",
      "enum host hints"
    ],
    "does_not_own": [
      "enum widget class law",
      "enum item semantics",
      "enum value semantics",
      "canonical .frog source",
      "frog.ui primitive semantics"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Enum.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.enum_control",
      "role": "control",
      "primary_value": {
        "present": true,
        "kind": "enum_item_id",
        "user_mutable": true
      }
    },
    {
      "class_id": "frog.widgets.enum_indicator",
      "role": "indicator",
      "primary_value": {
        "present": true,
        "kind": "enum_item_id",
        "user_mutable": false
      }
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.enum_control",
      "frog.realizations.default.enum_indicator"
    ],
    "variants": [
      "frog.realizations.default.enum.rectangular_ring"
    ],
    "resources": [
      "frog.realizations.default.enum.assets.rectangular_ring_svg",
      "frog.realizations.default.enum.assets.dropdown_list_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.enum_control",
      "family": "default",
      "target_class": "frog.widgets.enum_control",
      "default_variant": "rectangular_ring",
      "supported_parts": [
        "root",
        "label",
        "caption",
        "value_face",
        "focus_ring",
        "value_display",
        "selector_face",
        "spinner",
        "increment_up",
        "increment_down"
      ],
      "supported_visual_states": [
        "normal",
        "focused",
        "disabled",
        "opened",
        "pressed"
      ]
    },
    {
      "id": "frog.realizations.default.enum_indicator",
      "family": "default",
      "target_class": "frog.widgets.enum_indicator",
      "default_variant": "rectangular_ring",
      "supported_parts": [
        "root",
        "label",
        "caption",
        "value_face",
        "focus_ring",
        "value_display"
      ],
      "supported_visual_states": [
        "normal",
        "focused",
        "disabled"
      ]
    }
  ],
  "variants": [
    {
      "id": "frog.realizations.default.enum.rectangular_ring",
      "variant": "rectangular_ring",
      "target_classes": [
        "frog.widgets.enum_control",
        "frog.widgets.enum_indicator"
      ],
      "resource_ref": "frog.realizations.default.enum.assets.rectangular_ring_svg",
      "popup_resource_ref": "frog.realizations.default.enum.assets.dropdown_list_svg"
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.enum.assets.rectangular_ring_svg",
      "kind": "svg",
      "path": "./assets/enum/templates/enum_rectangular_ring.svg",
      "target_classes": [
        "frog.widgets.enum_control",
        "frog.widgets.enum_indicator"
      ],
      "target_variant": "rectangular_ring"
    },
    {
      "id": "frog.realizations.default.enum.assets.dropdown_list_svg",
      "kind": "svg",
      "path": "./assets/enum/templates/enum_dropdown_list.svg",
      "target_classes": [
        "frog.widgets.enum_control"
      ],
      "target_variant": "rectangular_ring",
      "host_surface": "dropdown"
    }
  ],
  "default_widget_properties": [
    {
      "class_id": "frog.widgets.enum_control",
      "role": "control",
      "visual": {
        "resource_ref": "frog.realizations.default.enum.assets.rectangular_ring_svg",
        "popup_resource_ref": "frog.realizations.default.enum.assets.dropdown_list_svg"
      },
      "props": {
        "display.selector_visible": true,
        "display.increment_buttons_visible": true,
        "data_entry.increment_wrap": false,
        "style.scale.reference_width": 260,
        "style.scale.reference_height": 110,
        "style.value_face.fill_color": "#ffffff",
        "style.value_face.fill_color.hover": "#eef6ff",
        "style.value_face.border_color": "#64748b",
        "style.value_face.border_color.hover": "#64748b",
        "style.value_face.border_width": "1px",
        "style.value_display.color": "#111827",
        "style.value_display.font_size": "16px",
        "style.value_display.font_size_mode": "scale_with_widget",
        "style.value_display.font_weight": "400",
        "style.value_display.vertical_offset": "-2px",
        "style.value_display.vertical_offset_mode": "scale_with_widget",
        "style.value_display.padding_inline": "8px",
        "style.value_display.padding_inline_mode": "scale_with_widget",

    },
    {
      "class_id": "frog.widgets.enum_indicator",
      "role": "indicator",
      "visual": {
        "resource_ref": "frog.realizations.default.enum.assets.rectangular_ring_svg"
      },
      "props": {
        "display.selector_visible": false,
        "style.scale.reference_width": 260,
        "style.scale.reference_height": 110,
        "style.value_face.fill_color": "#f8fafc",
        "style.value_face.border_color": "#64748b",
        "style.value_face.border_width": "1px",
        "style.value_display.color": "#111827",
        "style.value_display.font_size": "16px",
        "style.value_display.font_size_mode": "scale_with_widget",
        "style.value_display.font_weight": "400",
        "style.value_display.vertical_offset": "-2px",
        "style.value_display.vertical_offset_mode": "scale_with_widget",
        "style.value_display.padding_inline": "8px",
        "style.value_display.padding_inline_mode": "scale_with_widget",
        "style.selector_face.fill_color": "transparent",
        "style.selector_face.border_color": "transparent",
        "style.selector_face.border_width": "0px",
        "style.selector_face.symbol_color": "transparent",
        "style.focus_ring.color": "#2563eb",
        "style.focus_ring.width": "2px",
        "interaction.enabled": false,
        "interaction.read_only": true,
        "realization.variant": "rectangular_ring"
      }
    }
  ],
  "host_surface_bindings": [
    {
      "surface": "dropdown",
      "resource_ref": "frog.realizations.default.enum.assets.dropdown_list_svg",
      "supported_parts": [
        "root",
        "list_panel",
        "option_row",
        "option_text"
      ],
      "panel_part": "list_panel",
      "repeat_part": "option_row",
      "text_part": "option_text",
      "semantic_members": [
        "items[]",
        "items[].text",
        "selected.*"
      ],
      "layout": {
        "anchor_part": "value_face",
        "x": "center_on_anchor",
        "y": "bottom",
        "width": "outer_width",
        "source_width_outset_units": 2.923,
        "height": "repeated_part_stack",
        "outer_box_stroke_width_property": "style.value_face.border_width",
        "outer_box_stroke_width_mode_property": "style.value_face.border_width_mode",
        "excluded_parts": [
          "selector_face"
        ]
      }
    }
  ],
  "part_bindings": [
    {
      "part": "label",
      "semantic_member": "label.text"
    },
    {
      "part": "caption",
      "semantic_member": "caption.text"
    },
    {
      "part": "value_display",
      "semantic_members": [
        "value",
        "selected.text",
        "items[]"
      ]
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='focus_ring']",
      "geometry_contract": "same_outer_bounds_as_value_face; excludes selector_face, spinner, increment_up, and increment_down",
      "style_binding_group": "style.focus_ring",
      "state_sensitive": true
    },
    {
      "part": "spinner",
      "visibility_member": "display.increment_buttons_visible"
    },
    {
      "part": "increment_up",
      "semantic_member": "select_next()",
      "method_member": "increment()"
    },
    {
      "part": "increment_down",
      "semantic_member": "select_previous()",
      "method_member": "decrement()"
    }
  ],
  "state_maps": [
    {
      "state": "normal"
    },
    {
      "state": "focused",
      "property_bindings": [
        "style.focus_ring.visible",
        "style.focus_ring.color",
        "style.focus_ring.width"
      ]
    },
    {
      "state": "disabled"
    },
    {
      "state": "opened"
    },
    {
      "state": "pressed"
    }
  ],
  "property_bindings": [
    {
      "member": "caption.text",
      "target_part": "caption",
      "target_operation": "set_text_content"
    },
    {
      "member": "caption.visible",
      "target_part": "caption",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.anchor.x",
      "target_part": "caption",
      "target_operation": "set_anchor_x"
    },
    {
      "member": "caption.anchor.y",
      "target_part": "caption",
      "target_operation": "set_anchor_y"
    },
    {
      "member": "caption.align.horizontal",
      "target_part": "caption",
      "target_operation": "set_text_anchor_alignment"
    },
    {
      "member": "caption.style.text_color",
      "target_part": "caption",
      "target_operation": "set_text_fill"
    },
    {
      "member": "caption.style.font_family",
      "target_part": "caption",
      "target_operation": "set_text_font_family"
    },
    {
      "member": "caption.style.font_size",
      "target_part": "caption",
      "target_operation": "set_text_font_size"
    },
    {
      "member": "caption.style.font_weight",
      "target_part": "caption",
      "target_operation": "set_text_font_weight"
    },
    {
      "member": "value",
      "target_part": "value_display",
      "target_operation": "render_selected_item"
    },
    {
      "member": "items[]",
      "target_part": "value_display",
      "target_operation": "resolve_selected_item_text"
    },
    {
      "member": "display.increment_buttons_visible",
      "target_part": "spinner",
      "target_operation": "set_visibility"
    },
    {
      "member": "style.increment_button.*",
      "target_part": "increment_up",
      "target_operation": "apply_increment_button_style"
    },
    {
      "member": "style.increment_button.*",
      "target_part": "increment_down",
      "target_operation": "apply_increment_button_style"
    },
    {
      "member": "style.focus_ring.*",
      "target_part": "focus_ring",
      "target_operation": "apply_focus_ring_style"
    }
  ],
  "anchors": [
    {
      "id": "frog.realizations.default.enum.label.anchor",
      "target_part": "label",
      "source_selector": "[data-frog-anchor='label.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.enum.caption.anchor",
      "target_part": "caption",
      "source_selector": "[data-frog-anchor='caption.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.enum.value_display.left_center",
      "target_part": "value_display",
      "source_selector": "[data-frog-anchor='value_display.left_center']",
      "anchor_kind": "text_anchor"
    }
  ],
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_single_selector",
    "popup_posture": "host_may_provide_native_popup_for_item_selection",
    "style_property_source": ".frog instance props overriding Default realization values"
  },
  "validation_expectations": [
    "target classes must exist in Libraries/Widgets/Enum.md",
    "value must resolve to a declared item unless undefined runtime values are explicitly allowed",
    "items must preserve stable ids",
    "accepted visual defaults are manifest data merged before source-owned instance overrides, not runtime constants",
    "focus_ring covers only the value_face outer boundary; selector and increment/decrement command parts keep their own geometry and are not enclosed by focus.",
    "increment/decrement commands must navigate the declared items[] order and honor display.increment_buttons_visible"
  ]
}

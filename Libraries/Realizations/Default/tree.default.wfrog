{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_tree_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.tree",
    "name": "FROG Default Tree Realization",
    "namespace": "frog.realizations.default.tree",
    "family": "default",
    "category": "selection / navigation",
    "role_posture": "control / indicator",
    "summary": "Machine-readable default realization manifest for standardized tree widgets."
  },
  "ownership_boundary": {
    "owns": [
      "default tree realization records",
      "tree realization resources",
      "tree part bindings",
      "tree host hints",
      "tree validation expectations"
    ],
    "does_not_own": [
      "tree widget class law",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private host handles",
      "virtualized node handles",
      "host-native tree renderer handles",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Tree.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.tree_control",
      "role": "control"
    },
    {
      "class_id": "frog.widgets.tree_indicator",
      "role": "indicator"
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.tree"
    ],
    "resources": [
      "frog.realizations.default.tree.assets.shell_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.tree",
      "family": "default",
      "target_classes": [
        "frog.widgets.tree_control",
        "frog.widgets.tree_indicator"
      ],
      "supported_parts": [
      "root",
      "label",
      "caption",
      "node_region",
      "column_headers",
      "node_row",
        "node_indent",
        "node_connector",
        "expander_face",
        "checkbox_face",
        "node_icon",
        "node_label",
        "active_node",
        "active_cell",
        "selection_face",
        "edit_overlay",
      "drag_feedback",
      "drop_target",
      "vertical_scrollbar",
      "horizontal_scrollbar"
      ],
      "supported_selection_modes": [
        "none",
        "single_node",
        "multi_node",
        "range"
      ],
      "supported_check_modes": [
        "none",
        "boolean",
        "tri_state"
      ],
      "supported_drop_positions": [
        "before",
        "inside",
        "after"
      ],
      "fallbacks": {
        "missing_resource": "host_native_or_generic_compatible_rendering",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint",
        "unsupported_selection_mode": "reject_or_downgrade_to_single_node_selection",
        "unsupported_check_mode": "reject_or_disable_check_surface",
        "unsupported_drag_drop": "reject_or_preserve_selection_only"
      }
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.tree.assets.shell_svg",
      "kind": "svg",
      "path": "./assets/tree/templates/tree_shell.svg",
      "role": "geometry_shell"
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_geometry_surface",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "label",
      "binding_kind": "svg_geometry_surface",
      "binding_selector": "[data-frog-part='label']"
    },
    {
      "part": "caption",
      "binding_kind": "svg_geometry_surface",
      "binding_selector": "[data-frog-part='caption']"
    },
    {
      "part": "node_region",
      "binding_kind": "svg_geometry_surface",
      "binding_selector": "[data-frog-part='node_region']"
    },
    {
      "part": "column_headers",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='column_headers']"
    },
    {
      "part": "node_row",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='node_row']"
    },
    {
      "part": "node_indent",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='node_indent']"
    },
    {
      "part": "node_connector",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='node_connector']"
    },
    {
      "part": "expander_face",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='expander_face']"
    },
    {
      "part": "checkbox_face",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='checkbox_face']"
    },
    {
      "part": "node_icon",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='node_icon']"
    },
    {
      "part": "node_label",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='node_label']"
    },
    {
      "part": "active_node",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='active_node']"
    },
    {
      "part": "active_cell",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='active_cell']"
    },
    {
      "part": "selection_face",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='selection_face']"
    },
    {
      "part": "edit_overlay",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='edit_overlay']"
    },
    {
      "part": "drag_feedback",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='drag_feedback']"
    },
    {
      "part": "drop_target",
      "binding_kind": "host_overlay_generated_surface",
      "binding_selector": "[data-frog-part='drop_target']"
    },
    {
      "part": "vertical_scrollbar",
      "binding_kind": "svg_geometry_surface",
      "binding_selector": "[data-frog-part='vertical_scrollbar']"
    },
    {
      "part": "horizontal_scrollbar",
      "binding_kind": "svg_geometry_surface",
      "binding_selector": "[data-frog-part='horizontal_scrollbar']"
    }
  ],
  "property_bindings": [
    {
      "member": "caption.text",
      "target_part": "caption",
      "target_operation": "set_text_content"
    },
    {
      "member": "caption.visible",
      "target_part": "caption",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.anchor.x",
      "target_part": "caption",
      "target_operation": "set_anchor_x"
    },
    {
      "member": "caption.anchor.y",
      "target_part": "caption",
      "target_operation": "set_anchor_y"
    },
    {
      "member": "caption.align.horizontal",
      "target_part": "caption",
      "target_operation": "set_text_anchor_alignment"
    },
    {
      "member": "value",
      "target_part": "node_region",
      "target_operation": "render_tree_value"
    },
    {
      "member": "nodes.*",
      "target_part": "node_row",
      "target_operation": "render_nodes"
    },
    {
      "member": "nodes.label",
      "target_part": "node_label",
      "target_operation": "render_node_label"
    },
    {
      "member": "nodes.icon",
      "target_part": "node_icon",
      "target_operation": "render_node_icon"
    },
    {
      "member": "selection.*",
      "target_part": "selection_face",
      "target_operation": "render_selection"
    },
    {
      "member": "selection.active_node_id",
      "target_part": "active_node",
      "target_operation": "render_active_node"
    },
    {
      "member": "selection.active_column_id",
      "target_part": "active_cell",
      "target_operation": "render_active_cell_column"
    },
    {
      "member": "selection.active_cell_id",
      "target_part": "active_cell",
      "target_operation": "render_active_cell"
    },
    {
      "member": "expansion.*",
      "target_part": "expander_face",
      "target_operation": "render_expansion"
    },
    {
      "member": "check.*",
      "target_part": "checkbox_face",
      "target_operation": "render_check_state"
    },
    {
      "member": "viewport.*",
      "target_part": "node_region",
      "target_operation": "apply_viewport"
    },
    {
      "member": "display.column_headers_visible",
      "target_part": "column_headers",
      "target_operation": "set_visibility"
    },
    {
      "member": "display.column_headers_fixed",
      "target_part": "column_headers",
      "target_operation": "set_fixed_header_posture"
    },
    {
      "member": "search.*",
      "target_part": "node_region",
      "target_operation": "render_search_matches"
    },
    {
      "member": "filter.*",
      "target_part": "node_region",
      "target_operation": "apply_filter_view"
    },
    {
      "member": "editing.*",
      "target_part": "edit_overlay",
      "target_operation": "render_editing_state"
    },
    {
      "member": "drag.*",
      "target_part": "drag_feedback",
      "target_operation": "render_drag_feedback"
    },
    {
      "member": "drop.*",
      "target_part": "drop_target",
      "target_operation": "render_drop_target"
    }
  ],
  "method_bindings": [
    {
      "method": "clear_selection",
      "target_operation": "clear_selection"
    },
    {
      "method": "set_selection",
      "target_operation": "set_selection"
    },
    {
      "method": "select_node",
      "target_operation": "set_active_node"
    },
    {
      "method": "expand_node",
      "target_operation": "expand_node"
    },
    {
      "method": "collapse_node",
      "target_operation": "collapse_node"
    },
    {
      "method": "toggle_node",
      "target_operation": "toggle_node_expansion"
    },
    {
      "method": "scroll_to_node",
      "target_operation": "apply_viewport"
    },
    {
      "method": "set_node_label",
      "target_operation": "update_node_label"
    },
    {
      "method": "append_child",
      "target_operation": "append_child_node"
    },
    {
      "method": "remove_node",
      "target_operation": "remove_node"
    },
    {
      "method": "move_node",
      "target_operation": "move_node"
    },
    {
      "method": "set_checked",
      "target_operation": "update_check_state"
    },
    {
      "method": "find_nodes",
      "target_operation": "search_nodes"
    },
    {
      "method": "clear_filter",
      "target_operation": "clear_filter"
    }
  ],
  "event_bindings": [
    {
      "event": "value_changed",
      "source_part": "node_region"
    },
    {
      "event": "selection_changed",
      "source_part": "selection_face"
    },
    {
      "event": "expansion_changed",
      "source_part": "expander_face"
    },
    {
      "event": "node_expanded",
      "source_part": "expander_face"
    },
    {
      "event": "node_collapsed",
      "source_part": "expander_face"
    },
    {
      "event": "check_changed",
      "source_part": "checkbox_face"
    },
    {
      "event": "viewport_changed",
      "source_part": "node_region"
    },
    {
      "event": "edit_started",
      "source_part": "edit_overlay"
    },
    {
      "event": "edit_committed",
      "source_part": "edit_overlay"
    },
    {
      "event": "node_clicked",
      "source_part": "node_row"
    },
    {
      "event": "node_double_clicked",
      "source_part": "node_row"
    },
    {
      "event": "drag_started",
      "source_part": "drag_feedback"
    },
    {
      "event": "drop_completed",
      "source_part": "drop_target"
    }
  ],
  "state_maps": [
    {
      "state": "normal"
    },
    {
      "state": "focused"
    },
    {
      "state": "disabled"
    },
    {
      "state": "selection_active"
    },
    {
      "state": "editing"
    },
    {
      "state": "dragging"
    },
    {
      "state": "drop_target"
    }
  ],
  "composition": {
    "shell": "frog.realizations.default.tree.assets.shell_svg",
    "static_shell_parts": [
      "root",
      "label",
      "caption",
      "node_region",
      "vertical_scrollbar",
      "horizontal_scrollbar"
    ],
    "dynamic_host_overlay_parts": [
      "column_headers",
      "node_row",
      "node_indent",
      "node_connector",
      "expander_face",
      "checkbox_face",
      "node_icon",
      "node_label",
      "active_node",
      "active_cell",
      "selection_face",
      "edit_overlay",
      "drag_feedback",
      "drop_target"
    ],
    "layer_order": [
      "node_region",
      "column_headers",
      "node_connector",
      "node_indent",
      "node_row",
      "selection_face",
      "active_node",
      "active_cell",
      "expander_face",
      "checkbox_face",
      "node_icon",
      "node_label",
      "edit_overlay",
      "drag_feedback",
      "drop_target",
      "vertical_scrollbar",
      "horizontal_scrollbar",
      "label",
      "caption"
    ],
    "slots": [],
    "nested_slots": []
  },
  "anchors": [
    {
      "id": "frog.realizations.default.tree.label.anchor",
      "target_part": "label",
      "source_selector": "[data-frog-anchor='label.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.tree.caption.anchor",
      "target_part": "caption",
      "source_selector": "[data-frog-anchor='caption.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    }
  ],
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_virtual_tree",
    "style_application_posture": "apply_property_bindings_before_render",
    "host_native_replacement_allowed": true,
    "virtualization_allowed": true,
    "minimum_visible_nodes": 1
  },
  "validation_expectations": [
    "target classes must exist in the referenced widget class-law document",
    "all declared public parts must exist in widget class law",
    "resources must resolve relative to this package file",
    "resources must not become semantic owners of widget value",
    "runtime-private host handles must not be exposed as public widget members",
    "virtualized node and row handles must remain realization-private",
    "the shell SVG must expose static anchor and geometry data-frog-part markers; dynamic Tree column header, row, selection, expansion, editing, and drag/drop parts are generated host overlays aligned to those geometry markers",
    "unsupported edit or drag/drop operations on indicator classes must be rejected"
  ]
}

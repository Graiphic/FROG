{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_ring_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "publication_review": {
    "last_reviewed": "2026-06-12",
    "scope": "Default Ring compact value SVG, placement aura, optional increment/decrement command parts, dropdown list SVG skin, semantic public parts, and shared compact finite-choice visual posture with Default Enum.",
    "public_posture": "Publishes the compact value skin, popup list skin, reusable default widget properties, supported semantic parts, and review date; visual posture may share host rendering code with Default Enum, but Ring value semantics remain the Ring widget class law."
  },
  "package": {
    "id": "frog.realizations.default.ring",
    "name": "FROG Default Ring Realization",
    "namespace": "frog.realizations.default.ring",
    "family": "default",
    "category": "selection / navigation",
    "role_posture": "control / indicator",
    "summary": "Machine-readable default realization manifest for standardized Ring widgets."
  },
  "ownership_boundary": {
    "owns": [
      "default Ring realization records",
      "Ring SVG resources",
      "Ring part bindings",
      "Ring host hints",
      "Ring validation expectations"
    ],
    "does_not_own": [
      "Ring widget class law",
      "canonical .frog source",
      "Ring item identity",
      "Ring item numeric values",
      "FIR semantics",
      "lowering semantics",
      "runtime-private host handles",
      "host-native combo handles",
      "IDE-private item editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Ring.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.ring_control",
      "role": "control"
    },
    {
      "class_id": "frog.widgets.ring_indicator",
      "role": "indicator"
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.ring"
    ],
    "resources": [
      "frog.realizations.default.ring.assets.rectangular_svg",
      "frog.realizations.default.ring.assets.dropdown_list_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.ring",
      "family": "default",
      "target_classes": [
        "frog.widgets.ring_control",
        "frog.widgets.ring_indicator"
      ],
      "supported_parts": [
        "root",
        "placement_bounds",
        "label",
        "caption",
        "value_face",
        "focus_ring",
        "value_display",
        "spinner",
        "increment_up",
        "increment_down",
        "list_panel",
        "option_row",
        "option_label",
        "option_selection_face"
      ],
      "supported_selection_modes": [
        "single"
      ],
      "supported_item_features": [
        "id",
        "label",
        "value",
        "numeric_value",
        "enabled",
        "visible",
        "tooltip",
        "metadata",
        "strings_and_values",
        "disabled_items",
        "sequential_values",
        "undefined_value_policy"
      ],
      "fallbacks": {
        "missing_resource": "reject_or_host_native_compatible_rendering",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint",
        "unsupported_item_value": "reject_unless_source_allows_undefined_values",
        "unsupported_popup_host": "host_native_or_generic_compatible_selector"
      }
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.ring.assets.rectangular_svg",
      "kind": "svg",
      "path": "./assets/ring/templates/ring_rectangular.svg",
      "role": "primary_template",
      "target_parts": [
        "root",
        "placement_bounds",
        "value_face",
        "focus_ring",
        "value_display",
        "spinner",
        "increment_up",
        "increment_down"
      ]
    },
    {
      "id": "frog.realizations.default.ring.assets.dropdown_list_svg",
      "kind": "svg",
      "path": "./assets/ring/templates/ring_dropdown_list.svg",
      "role": "dropdown_host_surface_template",
      "target_parts": [
        "root",
        "list_panel",
        "option_row",
        "option_label",
        "option_selection_face"
      ],
      "host_surface": "dropdown"
    }
  ],
  "default_widget_properties": [
    {
      "class_id": "frog.widgets.ring_control",
      "role": "control",
      "visual": {
        "resource_ref": "frog.realizations.default.ring.assets.rectangular_svg",
        "popup_resource_ref": "frog.realizations.default.ring.assets.dropdown_list_svg"
      },
      "props": {
        "display.digital_display_visible": false,
        "display.increment_decrement_visible": true,
        "data_entry.increment_wrap": true,
        "display.format.type": "unsigned_decimal",
        "display.format.string": "%u",
        "display.format.advanced_editing": false,
        "display.popup_max_visible_items": 6,
        "display.text_overflow_visible": false,
        "style.scale.reference_width": 200,
        "style.scale.reference_height": 130,
        "style.frame.fill_color": "transparent",
        "style.frame.border_color": "transparent",
        "style.frame.border_width": "0px",
        "style.value_face.fill_color": "#ffffff",
        "style.value_face.fill_color.hover": "#eef6ff",
        "style.value_face.border_color": "#A8ABAE",
        "style.value_face.border_color.hover": "#8E9297",
        "style.value_face.border_width": "1px",
        "style.value_display.color": "#111827",
        "style.value_display.font_size": "15px",
        "style.value_display.font_weight": "400",
        "style.value_display.vertical_offset": "-2px",
        "style.value_display.padding_inline": "9px",
        "style.increment_button.fill_color.normal": "#edf2f7",
        "style.increment_button.fill_color.hover": "#dbeafe",
        "style.increment_button.fill_color.pressed": "#bfdbfe",
        "style.increment_button.border_color.normal": "#94a3b8",
        "style.increment_button.border_color.hover": "#64748b",
        "style.increment_button.border_color.pressed": "#2563eb",
        "style.increment_button.symbol_color.normal": "#334e68",
        "style.increment_button.symbol_color.hover": "#1d4ed8",
        "style.increment_button.symbol_color.pressed": "#1e40af",
        "style.popup.fill_color": "#ffffff",
        "style.popup.border_color": "#64748b",
        "style.popup.border_width": "1px",
        "style.popup.shadow": "0 8px 20px rgba(15,23,42,0.12)",
        "style.popup.option.fill_color": "#ffffff",
        "style.popup.option.text_color": "#111827",
        "style.popup.option.hover_fill_color": "#dbeafe",
        "style.popup.option.hover_text_color": "#0f172a",
        "style.popup.option.selected_fill_color": "#bfdbfe",
        "style.popup.option.selected_text_color": "#0f172a",
        "style.popup.option.disabled_opacity": "0.62",
        "style.popup.option.font_family": "Segoe UI, Arial, sans-serif",
        "style.popup.option.font_size": "14px",
        "style.popup.option.font_weight": "400",
        "style.popup.option.height": "28px",
        "style.popup.option.padding_inline": "9px",
        "style.focus_ring.color": "#2563eb",
        "style.focus_ring.width": "2px",
        "interaction.visible": true,
        "interaction.enabled": true,
        "interaction.read_only": false,
        "interaction.focusable": true,
        "realization.variant": "rectangular"
      }
    },
    {
      "class_id": "frog.widgets.ring_indicator",
      "role": "indicator",
      "visual": {
        "resource_ref": "frog.realizations.default.ring.assets.rectangular_svg"
      },
      "props": {
        "display.digital_display_visible": false,
        "display.increment_decrement_visible": false,
        "display.format.type": "unsigned_decimal",
        "display.format.string": "%u",
        "display.format.advanced_editing": false,
        "display.popup_max_visible_items": 0,
        "display.text_overflow_visible": false,
        "style.scale.reference_width": 200,
        "style.scale.reference_height": 130,
        "style.frame.fill_color": "transparent",
        "style.frame.border_color": "transparent",
        "style.frame.border_width": "0px",
        "style.value_face.fill_color": "#E8EBED",
        "style.value_face.border_color": "#A8ABAE",
        "style.value_face.border_width": "1px",
        "style.value_display.color": "#111827",
        "style.value_display.font_size": "15px",
        "style.value_display.font_weight": "400",
        "style.value_display.vertical_offset": "-2px",
        "style.value_display.padding_inline": "9px",
        "style.focus_ring.color": "#2563eb",
        "style.focus_ring.width": "2px",
        "interaction.visible": true,
        "interaction.enabled": false,
        "interaction.read_only": true,
        "interaction.focusable": false,
        "realization.variant": "rectangular"
      }
    }
  ],
  "host_surface_bindings": [
    {
      "surface": "dropdown",
      "resource_ref": "frog.realizations.default.ring.assets.dropdown_list_svg",
      "supported_parts": [
        "root",
        "list_panel",
        "option_row",
        "option_label",
        "option_selection_face"
      ],
      "panel_part": "list_panel",
      "repeat_part": "option_row",
      "text_part": "option_label",
      "selection_part": "option_selection_face",
      "semantic_members": [
        "items[]",
        "items[].label",
        "items[].enabled",
        "value.selected_id",
        "value.selected_value",
        "selected.*"
      ],
      "layout": {
        "anchor_part": "value_face",
        "x": "left",
        "y": "bottom",
        "width": "width",
        "height": "repeated_part_stack",
        "included_parts": [
          "value_face"
        ]
      }
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "placement_bounds",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='placement_bounds']",
      "semantic_members": [
        "layout.placement_bounds.*",
        "layout.grid.*",
        "layout.resize.*"
      ],
      "placement_role": "widget_placement_aura_not_focus_not_selection_optional_grid_snap_policy"
    },
    {
      "part": "label",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='label']"
    },
    {
      "part": "caption",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='caption']"
    },
    {
      "part": "value_face",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='value_face']"
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='focus_ring']",
      "geometry_contract": "same_outer_bounds_as_value_face; excludes spinner, increment_up, and increment_down",
      "style_binding_group": "style.focus_ring",
      "state_sensitive": true
    },
    {
      "part": "value_display",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='value_display']"
    },
    {
      "part": "spinner",
      "binding_kind": "svg_group_or_host_spinner",
      "binding_selector": "[data-frog-part='spinner']",
      "visibility_member": "display.increment_decrement_visible"
    },
    {
      "part": "increment_up",
      "binding_kind": "svg_group_or_host_button",
      "binding_selector": "[data-frog-part='increment_up']",
      "method_member": "increment()"
    },
    {
      "part": "increment_down",
      "binding_kind": "svg_group_or_host_button",
      "binding_selector": "[data-frog-part='increment_down']",
      "method_member": "decrement()"
    },
    {
      "part": "list_panel",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='list_panel']"
    },
    {
      "part": "option_row",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='option_row']"
    },
    {
      "part": "option_label",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='option_label']"
    },
    {
      "part": "option_selection_face",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='option_selection_face']"
    }
  ],
  "property_bindings": [
    {
      "source": "value.selected_id",
      "target_part": "value_display",
      "target": "selected_item_text"
    },
    {
      "source": "value.selected_value",
      "target_part": "value_display",
      "target": "selected_item_value"
    },
    {
      "source": "data_type.representation",
      "target_part": "value_display",
      "target": "selected_item_numeric_representation"
    },
    {
      "source": "items[]",
      "target_part": "list_panel",
      "target": "option_inventory"
    },
    {
      "source": "items.sequential_values",
      "target_part": "list_panel",
      "target": "strings_and_values_policy"
    },
    {
      "source": "items[].enabled",
      "target_part": "option_row",
      "target": "disabled_item_policy"
    },
    {
      "source": "display.digital_display_visible",
      "target_part": "value_display",
      "target": "optional_numeric_display"
    },
    {
      "source": "display.increment_decrement_visible",
      "target_part": "spinner",
      "target": "set_visibility"
    },
    {
      "source": "style.increment_button.*",
      "target_part": "increment_up",
      "target": "css_variables"
    },
    {
      "source": "style.increment_button.*",
      "target_part": "increment_down",
      "target": "css_variables"
    },
    {
      "source": "display.format.*",
      "target_part": "value_display",
      "target": "numeric_display_format_policy"
    },
    {
      "source": "style.value_display.*",
      "target_part": "value_display",
      "target": "css_variables"
    },
    {
      "source": "data_entry.*",
      "target_part": "value_face",
      "target": "numeric_data_entry_policy"
    },
    {
      "source": "style.value_face.*",
      "target_part": "value_face",
      "target": "css_variables"
    },
    {
      "source": "style.focus_ring.*",
      "target_part": "focus_ring",
      "target": "css_variables"
    },
    {
      "source": "layout.placement_bounds.*",
      "target_part": "placement_bounds",
      "target": "publish_placement_aura"
    },
    {
      "source": "layout.grid.*",
      "target_part": "placement_bounds",
      "target": "publish_grid_snap_policy"
    },
    {
      "source": "style.popup.option.*",
      "target_part": "option_row",
      "target": "css_variables"
    },
    {
      "source": "style.popup.*",
      "target_part": "list_panel",
      "target": "css_variables"
    }
  ],
  "event_bindings": [
    {
      "event": "value_changed",
      "source_part": "value_face",
      "payload": [
        "value.selected_id",
        "value.selected_value",
        "value.selected_index",
        "value.selected_label"
      ]
    },
    {
      "event": "selector_opened",
      "source_part": "value_face",
      "payload": [
        "interaction.opened"
      ]
    }
  ],
  "host_hints": {
    "preferred_rendering": "svg_template_with_host_popup_overlay",
    "popup_overlay_surface": "dropdown",
    "popup_overlay_alignment_part": "list_panel",
    "hit_area_parts": [
      "value_face",
      "value_face"
    ],
    "style_property_source": ".frog instance props overriding Default realization values",
    "default_compact_geometry": {
      "posture": "labview_like_value_face_plus_array_indexer_style_vertical_increment_decrement",
      "view_box_width": 200,
      "view_box_height": 130,
      "placement_grid_pitch": 16,
      "placement_bounds_part": "placement_bounds",
      "placement_bounds_x": 0,
      "placement_bounds_y": 72,
      "placement_bounds_width": 176,
      "placement_bounds_height": 38,
      "placement_bounds_posture": "widget_aura_with_optional_grid_snap_policy_not_focus_or_selection",
      "placement_aura_padding": 4,
      "placement_aura_padding_rule": "uniform band around the compact ring body; top_left and top_right snap to the common grid only when source_or_container_policy_declares_snap; Array cells consume placement_bounds, not value_face or spinner geometry",
      "body_height": 30,
      "value_face_x": 24,
      "value_face_y": 76,
      "value_face_width": 148,
      "value_face_height": 30,
      "spinner_x": 4,
      "spinner_width": 16,
      "spinner_button_height": 14,
      "spinner_button_gap": 2,
      "default_control_value_face_fill_color": "#ffffff",
      "default_indicator_value_face_fill_color": "#E8EBED",
      "default_value_face_border_color": "#A8ABAE",
      "default_value_face_border_width": "1px",
      "focus_ring_posture": "widget_focus_interaction_part_not_placement_aura_not_ide_selection",
      "proportionality_rule": "hosts must preserve placement_bounds as the contained-widget footprint when embedding the Default Ring SVG in Array cells; hidden increment/decrement buttons allow value_face to expand over the compact body without changing placement_bounds"
    }
  },
  "validation_expectations": [
    "Ring widgets keep item inventory and selected numeric value in source-owned instance data.",
    "The LabVIEW-like Ring default posture maps display strings to scalar numeric values; selected_id is UI identity, not the diagram value.",
    "The compact value face consumes the Default Ring SVG asset and published parts.",
    "placement_bounds must be present as a non-rendered public placement aura and must not be confused with focus_ring, popup selection, or Array cell selection.",
    "Array cells embedding Default Ring consume placement_bounds as the cell footprint; value_face, spinner, increment_up, and increment_down are internal widget parts, not the cell boundary.",
    "Default Ring and Default Enum may share compact visual posture, placement geometry, increment/decrement affordances, popup skin posture, and Array containment law; they must not share terminal value semantics.",
    "Runtime host overlays align to value_face, value_display, spinner, increment_up, increment_down, and list_panel.",
    "Visual styles are source-owned properties or Default realization values, not runtime constants.",
    "focus_ring covers only the value_face outer boundary; increment/decrement command parts keep their own geometry and are not enclosed by focus.",
    "Increment/decrement commands navigate visible enabled items, honor display.increment_decrement_visible, and honor data_entry.increment_wrap; the Default posture sets increment_wrap true for circular next/previous item stepping.",
    "When embedded in Array, the dropdown host surface must render as an Array overlay above the viewport and must not be clipped by the repeated cell box; hover and pressed button states must remain visible on increment_up and increment_down.",
    "Ring remains distinct from Enum class law."
  ]
}

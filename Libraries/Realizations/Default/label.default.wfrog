{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_label_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.label",
    "name": "FROG Default Label Realization",
    "namespace": "frog.realizations.default.label",
    "family": "default",
    "summary": "Machine-readable default realization manifest for the standardized standalone label widget."
  },
  "ownership_boundary": {
    "owns": [
      "default label realization record",
      "label realization resource references",
      "label part bindings",
      "label property bindings",
      "label anchors",
      "label host hints",
      "label validation expectations"
    ],
    "does_not_own": [
      "label widget class law",
      "label semantic text",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private text handles"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Label.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.label",
      "role": "support",
      "primary_value": {
        "present": false
      },
      "semantic_text": {
        "member": "text.value",
        "dynamic": true
      }
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.label"
    ],
    "variants": [
      "frog.realizations.default.label.rectangular"
    ],
    "resources": [
      "frog.realizations.default.label.assets.rectangular_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.label",
      "family": "default",
      "target_class": "frog.widgets.label",
      "variant_property": "realization.variant",
      "default_variant": "rectangular",
      "supported_variants": [
        "rectangular"
      ],
      "supported_parts": [
        "root",
        "background",
        "frame",
        "text_surface",
        "focus_ring"
      ],
      "supported_visual_states": [
        "normal",
        "focused",
        "disabled",
        "hidden"
      ],
      "fallbacks": {
        "missing_variant": "rectangular",
        "missing_background": "transparent_background",
        "missing_frame": "frameless_label",
        "missing_focus_ring": "host_native_focus_ring"
      }
    }
  ],
  "variants": [
    {
      "id": "frog.realizations.default.label.rectangular",
      "variant": "rectangular",
      "target_class": "frog.widgets.label",
      "resource_ref": "frog.realizations.default.label.assets.rectangular_svg",
      "geometry_posture": {
        "shape_family": "rectangular_text_region",
        "layout_source": "front_panel_layout_rectangle",
        "scales_to_layout": true,
        "supports_background": true,
        "supports_frame": true,
        "supports_dynamic_text": true
      },
      "fallback": "host_text_label"
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.label.assets.rectangular_svg",
      "kind": "svg",
      "path": "./assets/label/templates/label_rectangular.svg",
      "target_class": "frog.widgets.label",
      "target_variant": "rectangular",
      "template_markers": {
        "template": "frog.realizations.default.label.rectangular",
        "variant": "rectangular",
        "part_attribute": "data-frog-part",
        "binding_attribute": "data-frog-bind",
        "member_attribute": "data-frog-member",
        "anchor_attribute": "data-frog-anchor"
      }
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_element",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "background",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='background']",
      "style_binding_group": "style.background"
    },
    {
      "part": "frame",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='frame']",
      "style_binding_group": "style.frame"
    },
    {
      "part": "text_surface",
      "binding_kind": "svg_text_or_host_text",
      "binding_selector": "[data-frog-part='text_surface']",
      "semantic_member": "text.value",
      "style_binding_group": "style.text"
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='focus_ring']",
      "style_binding_group": "style.focus_ring"
    }
  ],
  "state_maps": [
    {
      "state": "normal"
    },
    {
      "state": "focused",
      "value_condition": {
        "interaction.focused": true
      },
      "inherits": "normal"
    },
    {
      "state": "disabled",
      "value_condition": {
        "interaction.enabled": false
      },
      "inherits": "normal"
    },
    {
      "state": "hidden",
      "value_condition": {
        "interaction.visible": false
      }
    }
  ],
  "property_bindings": [
    {
      "member": "text.value",
      "target_part": "text_surface",
      "target_operation": "set_text_content"
    },
    {
      "member": "text.visible",
      "target_part": "text_surface",
      "target_operation": "set_visibility"
    },
    {
      "member": "style.text.*",
      "target_part": "text_surface",
      "target_operation": "apply_text_style"
    },
    {
      "member": "style.background.*",
      "target_part": "background",
      "target_operation": "apply_background_style"
    },
    {
      "member": "style.frame.*",
      "target_part": "frame",
      "target_operation": "apply_frame_style"
    },
    {
      "member": "style.focus_ring.*",
      "target_part": "focus_ring",
      "target_operation": "apply_focus_ring_style"
    }
  ],
  "anchors": [
    {
      "id": "frog.realizations.default.label.text_surface.left_center",
      "target_part": "text_surface",
      "source_selector": "[data-frog-anchor='text_surface.left_center']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "middle"
    }
  ],
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_text",
    "resize_posture": "scale_template_to_front_panel_layout_rectangle",
    "text_rendering_posture": "host_may_replace_template_text_content",
    "style_application_posture": "apply_property_bindings_before_render",
    "accessibility_posture": {
      "role": "text",
      "text_source": "text.value",
      "label_source": "label.text"
    }
  },
  "validation_expectations": [
    "target class must exist in Libraries/Widgets/Label.md",
    "all declared public parts must exist in the label class law",
    "resources must resolve relative to this package file",
    "text.value must remain the semantic owner of visible support text",
    "SVG-baked preview text must not be treated as semantic label content"
  ]
}

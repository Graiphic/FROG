{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_listbox_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.listbox",
    "name": "FROG Default listbox Realization",
    "namespace": "frog.realizations.default.listbox",
    "family": "default",
    "category": "selection / navigation",
    "role_posture": "control / indicator",
    "summary": "Machine-readable default realization manifest for standardized listbox widgets."
  },
  "ownership_boundary": {
    "owns": [
      "default listbox realization records",
      "listbox realization resources",
      "listbox part bindings",
      "listbox host hints",
      "listbox validation expectations"
    ],
    "does_not_own": [
      "listbox widget class law",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private host handles",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Listbox.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.listbox_control",
      "role": "control"
    },
    {
      "class_id": "frog.widgets.listbox_indicator",
      "role": "indicator"
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.listbox"
    ],
    "resources": [
      "frog.realizations.default.listbox.assets.shell_svg",
      "frog.realizations.default.listbox.assets.item_region_svg",
      "frog.realizations.default.listbox.assets.item_row_svg",
      "frog.realizations.default.listbox.assets.selection_face_svg",
      "frog.realizations.default.listbox.assets.vertical_scrollbar_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.listbox",
      "family": "default",
      "target_classes": [
        "frog.widgets.listbox_control",
        "frog.widgets.listbox_indicator"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "frame",
        "item_region",
        "item_row",
        "selection_face",
        "vertical_scrollbar",
        "focus_ring"
      ],
      "fallbacks": {
        "missing_resource": "host_native_or_generic_compatible_rendering",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.listbox.assets.shell_svg",
      "kind": "svg",
      "path": "./assets/listbox/templates/listbox_shell.svg",
      "role": "assembly_shell"
    },
    {
      "id": "frog.realizations.default.listbox.assets.item_region_svg",
      "kind": "svg",
      "path": "./assets/listbox/subobjects/item_region.svg",
      "target_part": "item_region"
    },
    {
      "id": "frog.realizations.default.listbox.assets.item_row_svg",
      "kind": "svg",
      "path": "./assets/listbox/subobjects/item_row.svg",
      "target_part": "item_row"
    },
    {
      "id": "frog.realizations.default.listbox.assets.selection_face_svg",
      "kind": "svg",
      "path": "./assets/listbox/subobjects/selection_face.svg",
      "target_part": "selection_face"
    },
    {
      "id": "frog.realizations.default.listbox.assets.vertical_scrollbar_svg",
      "kind": "svg",
      "path": "./assets/listbox/subobjects/vertical_scrollbar.svg",
      "target_part": "vertical_scrollbar"
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "label",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='label']"
    },
    {
      "part": "caption",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='caption']"
    },
    {
      "part": "frame",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='frame']"
    },
    {
      "part": "item_region",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='item_region']"
    },
    {
      "part": "item_row",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='item_row']"
    },
    {
      "part": "selection_face",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='selection_face']"
    },
    {
      "part": "vertical_scrollbar",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='vertical_scrollbar']"
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='focus_ring']"
    }
  ],
  "property_bindings": [
    {
      "member": "items[]",
      "target_part": "item_region",
      "target_operation": "render_items"
    },
    {
      "member": "selection.*",
      "target_part": "selection_face",
      "target_operation": "render_selection"
    },
    {
      "member": "value",
      "target_part": "item_region",
      "target_operation": "resolve_selected_item"
    }
  ],
  "state_maps": [
    {
      "state": "normal"
    }
  ],
  "composition": {
    "shell": "frog.realizations.default.listbox.assets.shell_svg",
    "slots": [
      {
        "slot": "item_region",
        "resource_ref": "frog.realizations.default.listbox.assets.item_region_svg"
      },
      {
        "slot": "vertical_scrollbar",
        "resource_ref": "frog.realizations.default.listbox.assets.vertical_scrollbar_svg"
      }
    ],
    "nested_slots": [
      {
        "parent_part": "item_region",
        "slot": "item_row",
        "resource_ref": "frog.realizations.default.listbox.assets.item_row_svg"
      },
      {
        "parent_part": "item_region",
        "slot": "selection_face",
        "resource_ref": "frog.realizations.default.listbox.assets.selection_face_svg"
      }
    ]
  },
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_widget",
    "style_application_posture": "apply_property_bindings_before_render"
  },
  "validation_expectations": [
    "target classes must exist in the referenced widget class-law document",
    "all declared public parts must exist in widget class law",
    "resources must resolve relative to this package file",
    "resources must not become semantic owners of widget value",
    "runtime-private host handles must not be exposed as public widget members"
  ]
}

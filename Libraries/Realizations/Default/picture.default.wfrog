{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_picture_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.picture",
    "name": "FROG Default picture Realization",
    "namespace": "frog.realizations.default.picture",
    "family": "default",
    "category": "visual data",
    "role_posture": "control / indicator",
    "summary": "Machine-readable default realization manifest for standardized picture widgets."
  },
  "ownership_boundary": {
    "owns": [
      "default picture realization records",
      "picture realization resources",
      "picture part bindings",
      "picture host hints",
      "picture validation expectations"
    ],
    "does_not_own": [
      "picture widget class law",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private host handles",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Picture.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.picture_control",
      "role": "control"
    },
    {
      "class_id": "frog.widgets.picture_indicator",
      "role": "indicator"
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.picture"
    ],
    "resources": [
      "frog.realizations.default.picture.assets.rectangular_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.picture",
      "family": "default",
      "target_classes": [
        "frog.widgets.picture_control",
        "frog.widgets.picture_indicator"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "frame",
        "picture_region",
        "image_surface",
        "overlay_region",
        "roi_layer",
        "crosshair_layer",
        "cursor_readout",
        "focus_ring"
      ],
      "fallbacks": {
        "missing_resource": "host_native_or_generic_compatible_rendering",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.picture.assets.rectangular_svg",
      "kind": "svg",
      "path": "./assets/picture/templates/picture_rectangular.svg",
      "target_classes": [
        "frog.widgets.picture_control",
        "frog.widgets.picture_indicator"
      ]
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "label",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='label']",
      "semantic_member": "label.text",
      "visibility_member": "label.visible",
      "placement_role": "structural_label"
    },
    {
      "part": "caption",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='caption']",
      "semantic_member": "caption.text",
      "visibility_member": "caption.visible",
      "placement_role": "front_panel_caption"
    },
    {
      "part": "frame",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='frame']",
      "style_binding_group": "style.frame"
    },
    {
      "part": "picture_region",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='picture_region']",
      "style_binding_group": "style.picture_region"
    },
    {
      "part": "image_surface",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='image_surface']",
      "semantic_member": "image.*",
      "style_binding_group": "display"
    },
    {
      "part": "overlay_region",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='overlay_region']"
    },
    {
      "part": "roi_layer",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='roi_layer']"
    },
    {
      "part": "crosshair_layer",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='crosshair_layer']"
    },
    {
      "part": "cursor_readout",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='cursor_readout']"
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='focus_ring']",
      "style_binding_group": "style.focus_ring"
    }
  ],
  "property_bindings": [
    {
      "member": "label.text",
      "target_part": "label",
      "target_operation": "set_text_content"
    },
    {
      "member": "label.visible",
      "target_part": "label",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.text",
      "target_part": "caption",
      "target_operation": "set_text_content"
    },
    {
      "member": "caption.visible",
      "target_part": "caption",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.anchor.x",
      "target_part": "caption",
      "target_operation": "set_anchor_x"
    },
    {
      "member": "caption.anchor.y",
      "target_part": "caption",
      "target_operation": "set_anchor_y"
    },
    {
      "member": "caption.align.horizontal",
      "target_part": "caption",
      "target_operation": "set_text_anchor_alignment"
    },
    {
      "member": "caption.style.text_color",
      "target_part": "caption",
      "target_operation": "set_text_fill"
    },
    {
      "member": "caption.style.font_family",
      "target_part": "caption",
      "target_operation": "set_font_family"
    },
    {
      "member": "caption.style.font_size",
      "target_part": "caption",
      "target_operation": "set_font_size"
    },
    {
      "member": "caption.style.font_weight",
      "target_part": "caption",
      "target_operation": "set_font_weight"
    },
    {
      "member": "value",
      "target_part": "picture_region",
      "target_operation": "render_picture_value"
    },
    {
      "member": "image.*",
      "target_part": "image_surface",
      "target_operation": "render_image_payload"
    },
    {
      "member": "viewport.*",
      "target_part": "picture_region",
      "target_operation": "apply_viewport"
    },
    {
      "member": "display.background_color",
      "target_part": "image_surface",
      "target_operation": "set_background_fill"
    },
    {
      "member": "style.frame.*",
      "target_part": "frame",
      "target_operation": "apply_frame_style"
    },
    {
      "member": "style.picture_region.*",
      "target_part": "picture_region",
      "target_operation": "apply_picture_region_style"
    },
    {
      "member": "style.focus_ring.*",
      "target_part": "focus_ring",
      "target_operation": "apply_focus_ring_style"
    },
    {
      "member": "overlay.visible",
      "target_part": "overlay_region",
      "target_operation": "set_visibility"
    },
    {
      "member": "roi.visible",
      "target_part": "roi_layer",
      "target_operation": "set_visibility"
    },
    {
      "member": "crosshair.visible",
      "target_part": "crosshair_layer",
      "target_operation": "set_visibility"
    },
    {
      "member": "cursor_readout.visible",
      "target_part": "cursor_readout",
      "target_operation": "set_visibility"
    },
    {
      "member": "pointer.position",
      "target_part": "overlay_region",
      "target_operation": "render_pointer_overlay"
    }
  ],
  "state_maps": [
    {
      "state": "normal"
    }
  ],
  "anchors": [
    {
      "id": "frog.realizations.default.picture.label.anchor",
      "target_part": "label",
      "source_selector": "[data-frog-anchor='label.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.picture.caption.anchor",
      "target_part": "caption",
      "source_selector": "[data-frog-anchor='caption.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    }
  ],
  "composition": null,
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_widget",
    "style_application_posture": "apply_property_bindings_before_render"
  },
  "validation_expectations": [
    "target classes must exist in the referenced widget class-law document",
    "all declared public parts must exist in widget class law",
    "resources must resolve relative to this package file",
    "resources must not become semantic owners of widget value",
    "runtime-private host handles must not be exposed as public widget members"
  ]
}

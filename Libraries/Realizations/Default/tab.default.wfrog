{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_tab_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.tab",
    "name": "FROG Default Tab Realization",
    "namespace": "frog.realizations.default.tab",
    "family": "default",
    "category": "selection / navigation",
    "role_posture": "control / indicator",
    "summary": "Machine-readable default realization manifest for standardized tab widgets."
  },
  "ownership_boundary": {
    "owns": [
      "default tab realization records",
      "tab realization resources",
      "tab part bindings",
      "tab host hints",
      "tab validation expectations"
    ],
    "does_not_own": [
      "tab widget class law",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private host handles",
      "host-native tab handles",
      "hidden page renderer handles",
      "child widget value ownership",
      "IDE-private page editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Tab.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.tab_control",
      "role": "control"
    },
    {
      "class_id": "frog.widgets.tab_indicator",
      "role": "indicator"
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.tab"
    ],
    "resources": [
      "frog.realizations.default.tab.assets.shell_svg",
      "frog.realizations.default.tab.assets.tab_header_region_svg",
      "frog.realizations.default.tab.assets.tab_item_svg",
      "frog.realizations.default.tab.assets.selection_face_svg",
      "frog.realizations.default.tab.assets.page_region_svg",
      "frog.realizations.default.tab.assets.tab_close_button_svg",
      "frog.realizations.default.tab.assets.overflow_button_svg",
      "frog.realizations.default.tab.assets.overflow_menu_svg",
      "frog.realizations.default.tab.assets.tab_scroll_previous_svg",
      "frog.realizations.default.tab.assets.tab_scroll_next_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.tab",
      "family": "default",
      "target_classes": [
        "frog.widgets.tab_control",
        "frog.widgets.tab_indicator"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "frame",
        "tab_header_region",
        "tab_item",
        "tab_item_label",
        "tab_item_icon",
        "tab_close_button",
        "selection_face",
        "overflow_button",
        "overflow_menu",
        "tab_scroll_previous",
        "tab_scroll_next",
        "page_label_display",
        "page_label_display_face",
        "page_label_display_text",
        "page_label_display_previous",
        "page_label_display_next",
        "page_region",
        "page_container",
        "page_content",
        "focus_ring"
      ],
      "supported_header_placements": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "supported_item_width_policies": [
        "auto",
        "equal",
        "fixed",
        "content"
      ],
      "supported_item_positioning_policies": [
        "source_layout",
        "flow"
      ],
      "supported_selected_row_policies": [
        "none",
        "selected_row_nearest_page"
      ],
      "supported_selected_join_edges": [
        "none",
        "bottom"
      ],
      "supported_overflow_policies": [
        "wrap",
        "fit",
        "scroll",
        "clip",
        "menu"
      ],
      "supported_close_policies": [
        "deny",
        "request",
        "immediate"
      ],
      "configurable_property_surfaces": [
        "headers.placement",
        "headers.visible",
        "headers.item_positioning_policy",
        "headers.selected_row_policy",
        "headers.item_width_policy",
        "headers.overflow_policy",
        "headers.allow_multiple_rows",
        "headers.max_rows",
        "headers.item_width",
        "headers.item_min_width",
        "headers.item_flex",
        "headers.item_gap",
        "headers.row_gap",
        "pages[].tab_item.layout.*",
        "page_label_display.*",
        "page_region.*",
        "style.frame.*",
        "style.header.*",
        "style.tab_item.*",
        "style.tab_item.selected_join_edge",
        "style.tab_item.selected_join_border_color",
        "style.tab_item.selected_join_overlap",
        "style.tab_item.selected_row_join_edge",
        "style.tab_item.selected_row_join_border_color",
        "style.selection_face.*",
        "style.page_region.*",
        "style.page_content.*",
        "style.focus_ring.*"
      ],
      "fallbacks": {
        "missing_resource": "host_native_or_generic_compatible_rendering",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint",
        "unsupported_header_placement": "reject_or_use_top",
        "unsupported_close_policy": "reject_or_disable_close_surface",
        "unsupported_overflow_mode": "reject_or_use_overflow_menu"
      }
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.tab.assets.shell_svg",
      "kind": "svg",
      "path": "./assets/tab/templates/tab_shell.svg",
      "role": "assembly_shell"
    },
    {
      "id": "frog.realizations.default.tab.assets.tab_header_region_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/tab_header_region.svg",
      "target_part": "tab_header_region"
    },
    {
      "id": "frog.realizations.default.tab.assets.tab_item_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/tab_item.svg",
      "target_part": "tab_item"
    },
    {
      "id": "frog.realizations.default.tab.assets.selection_face_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/selection_face.svg",
      "target_part": "selection_face"
    },
    {
      "id": "frog.realizations.default.tab.assets.page_region_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/page_region.svg",
      "target_part": "page_region"
    },
    {
      "id": "frog.realizations.default.tab.assets.tab_close_button_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/tab_close_button.svg",
      "target_part": "tab_close_button"
    },
    {
      "id": "frog.realizations.default.tab.assets.overflow_button_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/overflow_button.svg",
      "target_part": "overflow_button"
    },
    {
      "id": "frog.realizations.default.tab.assets.overflow_menu_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/overflow_menu.svg",
      "target_part": "overflow_menu"
    },
    {
      "id": "frog.realizations.default.tab.assets.tab_scroll_previous_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/tab_scroll_previous.svg",
      "target_part": "tab_scroll_previous"
    },
    {
      "id": "frog.realizations.default.tab.assets.tab_scroll_next_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/tab_scroll_next.svg",
      "target_part": "tab_scroll_next"
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_or_host_surface",

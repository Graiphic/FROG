{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_tab_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.tab",
    "name": "FROG Default tab Realization",
    "namespace": "frog.realizations.default.tab",
    "family": "default",
    "category": "selection / navigation",
    "role_posture": "control / indicator",
    "summary": "Machine-readable default realization manifest for standardized tab widgets."
  },
  "ownership_boundary": {
    "owns": [
      "default tab realization records",
      "tab realization resources",
      "tab part bindings",
      "tab host hints",
      "tab validation expectations"
    ],
    "does_not_own": [
      "tab widget class law",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private host handles",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Tab.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.tab_control",
      "role": "control"
    },
    {
      "class_id": "frog.widgets.tab_indicator",
      "role": "indicator"
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.tab"
    ],
    "resources": [
      "frog.realizations.default.tab.assets.shell_svg",
      "frog.realizations.default.tab.assets.tab_header_region_svg",
      "frog.realizations.default.tab.assets.tab_item_svg",
      "frog.realizations.default.tab.assets.selection_face_svg",
      "frog.realizations.default.tab.assets.page_region_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.tab",
      "family": "default",
      "target_classes": [
        "frog.widgets.tab_control",
        "frog.widgets.tab_indicator"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "frame",
        "tab_header_region",
        "tab_item",
        "selection_face",
        "page_region",
        "focus_ring"
      ],
      "fallbacks": {
        "missing_resource": "host_native_or_generic_compatible_rendering",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.tab.assets.shell_svg",
      "kind": "svg",
      "path": "./assets/tab/templates/tab_shell.svg",
      "role": "assembly_shell"
    },
    {
      "id": "frog.realizations.default.tab.assets.tab_header_region_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/tab_header_region.svg",
      "target_part": "tab_header_region"
    },
    {
      "id": "frog.realizations.default.tab.assets.tab_item_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/tab_item.svg",
      "target_part": "tab_item"
    },
    {
      "id": "frog.realizations.default.tab.assets.selection_face_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/selection_face.svg",
      "target_part": "selection_face"
    },
    {
      "id": "frog.realizations.default.tab.assets.page_region_svg",
      "kind": "svg",
      "path": "./assets/tab/subobjects/page_region.svg",
      "target_part": "page_region"
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "label",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='label']"
    },
    {
      "part": "caption",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='caption']"
    },
    {
      "part": "frame",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='frame']"
    },
    {
      "part": "tab_header_region",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='tab_header_region']"
    },
    {
      "part": "tab_item",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='tab_item']"
    },
    {
      "part": "selection_face",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='selection_face']"
    },
    {
      "part": "page_region",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='page_region']"
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='focus_ring']"
    }
  ],
  "property_bindings": [
    {
      "member": "pages[]",
      "target_part": "tab_header_region",
      "target_operation": "render_tab_items"
    },
    {
      "member": "selection.*",
      "target_part": "selection_face",
      "target_operation": "render_selected_tab"
    },
    {
      "member": "value",
      "target_part": "page_region",
      "target_operation": "render_selected_page"
    }
  ],
  "state_maps": [
    {
      "state": "normal"
    }
  ],
  "composition": {
    "shell": "frog.realizations.default.tab.assets.shell_svg",
    "slots": [
      {
        "slot": "tab_header_region",
        "resource_ref": "frog.realizations.default.tab.assets.tab_header_region_svg"
      },
      {
        "slot": "page_region",
        "resource_ref": "frog.realizations.default.tab.assets.page_region_svg"
      }
    ],
    "nested_slots": [
      {
        "parent_part": "tab_header_region",
        "slot": "tab_item",
        "resource_ref": "frog.realizations.default.tab.assets.tab_item_svg"
      },
      {
        "parent_part": "tab_header_region",
        "slot": "selection_face",
        "resource_ref": "frog.realizations.default.tab.assets.selection_face_svg"
      }
    ]
  },
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_widget",
    "style_application_posture": "apply_property_bindings_before_render"
  },
  "validation_expectations": [
    "target classes must exist in the referenced widget class-law document",
    "all declared public parts must exist in widget class law",
    "resources must resolve relative to this package file",
    "resources must not become semantic owners of widget value",
    "runtime-private host handles must not be exposed as public widget members"
  ]
}

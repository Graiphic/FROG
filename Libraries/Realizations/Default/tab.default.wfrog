  "anchors": [
    {
      "id": "frog.realizations.default.tab.label.anchor",
      "target_part": "label",
      "source_selector": "[data-frog-anchor='label.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.tab.caption.anchor",
      "target_part": "caption",
      "source_selector": "[data-frog-anchor='caption.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.tab.page_label_display.anchor",
      "target_part": "page_label_display",
      "source_selector": "[data-frog-anchor='page_label_display.anchor']",
      "anchor_kind": "control_surface_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "top"
    }
  ],
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_tab_control",
    "style_application_posture": "apply_property_bindings_before_render",
    "host_native_replacement_allowed": true,
    "page_content_hosting_allowed": true,
    "minimum_page_count": 1
  },
  "validation_expectations": [
    "target classes must exist in the referenced widget class-law document",
    "all declared public parts must exist in widget class law",
    "resources must resolve relative to this package file",
    "resources must not become semantic owners of selected page value or child widget values",
    "runtime-private tab handles must not be exposed as public widget members",
    "page label display overlays must align to the published page_label_display parts and remain source-owned",
    "hidden page renderer handles must remain realization-private",
    "declared SVG resources should expose all supported data-frog-part markers",
    "unsupported close or reorder operations on indicator classes must be rejected"
  ]
}

{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_subpanel_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.subpanel",
    "name": "FROG Default Subpanel Realization",
    "namespace": "frog.realizations.default.subpanel",
    "family": "default",
    "category": "layout / embedded front panel",
    "role_posture": "subpanel_host",
    "summary": "Machine-readable default realization manifest for the standardized Subpanel widget."
  },
  "ownership_boundary": {
    "owns": [
      "default Subpanel realization records",
      "Subpanel realization resources",
      "Subpanel part bindings",
      "Subpanel host hints",
      "Subpanel validation expectations"
    ],
    "does_not_own": [
      "Subpanel widget class law",
      "canonical .frog source",
      "hosted .frog front-panel semantics",
      "frog.ui primitive semantics",
      "runtime-private host handles",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Subpanel.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.subpanel",
      "role": "subpanel_host"
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.subpanel"
    ],
    "resources": [
      "frog.realizations.default.subpanel.assets.shell_svg",
      "frog.realizations.default.subpanel.assets.subpanel_region_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.subpanel",
      "family": "default",
      "target_classes": [
        "frog.widgets.subpanel"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "frame",
        "subpanel_region",
        "focus_ring"
      ],
      "fallbacks": {
        "missing_resource": "host_native_or_generic_compatible_rendering",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.subpanel.assets.shell_svg",
      "kind": "svg",
      "path": "./assets/subpanel/templates/subpanel_shell.svg",
      "role": "assembly_shell"
    },
    {
      "id": "frog.realizations.default.subpanel.assets.subpanel_region_svg",
      "kind": "svg",
      "path": "./assets/subpanel/subobjects/subpanel_region.svg",
      "target_part": "subpanel_region"
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "label",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='label']"
    },
    {
      "part": "caption",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='caption']"
    },
    {
      "part": "frame",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='frame']"
    },
    {
      "part": "subpanel_region",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='subpanel_region']"
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='focus_ring']"
    }
  ],
  "property_bindings": [
    {
      "member": "caption.text",
      "target_part": "caption",
      "target_operation": "set_text_content"
    },
    {
      "member": "caption.visible",
      "target_part": "caption",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.anchor.x",
      "target_part": "caption",
      "target_operation": "set_anchor_x"
    },
    {
      "member": "caption.anchor.y",
      "target_part": "caption",
      "target_operation": "set_anchor_y"
    },
    {
      "member": "caption.align.horizontal",
      "target_part": "caption",
      "target_operation": "set_text_anchor_alignment"
    },
    {
      "member": "caption.style.text_color",
      "target_part": "caption",
      "target_operation": "set_text_color"
    },
    {
      "member": "caption.style.font_family",
      "target_part": "caption",
      "target_operation": "set_font_family"
    },
    {
      "member": "caption.style.font_size",
      "target_part": "caption",
      "target_operation": "set_font_size"
    },
    {
      "member": "caption.style.font_weight",
      "target_part": "caption",
      "target_operation": "set_font_weight"
    },
    {
      "member": "hosted_front_panel_ref",
      "target_part": "subpanel_region",
      "target_operation": "host_front_panel_reference"
    },
    {
      "member": "hosted_front_panel_package_ref",
      "target_part": "subpanel_region",
      "target_operation": "host_front_panel_package_reference"
    },
    {
      "member": "style.frame.fill_color",
      "target_part": "frame",
      "target_operation": "set_fill"
    },
    {
      "member": "style.frame.border_color",
      "target_part": "frame",
      "target_operation": "set_stroke_color"
    },
    {
      "member": "style.frame.border_width",
      "target_part": "frame",
      "target_operation": "set_stroke_width"
    },
    {
      "member": "style.host_region.fill_color",
      "target_part": "subpanel_region",
      "target_operation": "set_fill"
    },
    {
      "member": "style.host_region.border_color",
      "target_part": "subpanel_region",
      "target_operation": "set_stroke_color"
    },
    {
      "member": "style.host_region.border_width",
      "target_part": "subpanel_region",
      "target_operation": "set_stroke_width"
    }
  ],
  "state_maps": [
    {
      "state": "normal"
    }
  ],
  "composition": {
    "shell": "frog.realizations.default.subpanel.assets.shell_svg",
    "slots": [
      {
        "slot": "subpanel_region",
        "resource_ref": "frog.realizations.default.subpanel.assets.subpanel_region_svg"
      }
    ]
  },
  "anchors": [
    {
      "id": "frog.realizations.default.subpanel.label.anchor",
      "target_part": "label",
      "source_selector": "[data-frog-anchor='label.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.subpanel.caption.anchor",
      "target_part": "caption",
      "source_selector": "[data-frog-anchor='caption.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    }
  ],
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_widget",
    "style_application_posture": "apply_property_bindings_before_render",
    "hosted_surface_alignment": "subpanel_region"
  },
  "validation_expectations": [
    "target classes must exist in the referenced widget class-law document",
    "all declared public parts must exist in widget class law",
    "resources must resolve relative to this package file",
    "resources must not become semantic owners of hosted front-panel behavior",
    "runtime-private host handles must not be exposed as public widget members"
  ]
}

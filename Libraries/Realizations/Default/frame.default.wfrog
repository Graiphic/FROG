{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_frame_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.frame",
    "name": "FROG Default Frame Realization",
    "namespace": "frog.realizations.default.frame",
    "family": "default",
    "category": "decoration",
    "role_posture": "support",
    "summary": "Machine-readable default realization manifest for the standardized simple frame support widget."
  },
  "ownership_boundary": {
    "owns": [
      "default frame realization record",
      "frame realization variant declarations",
      "frame SVG resource references",
      "frame background and border part bindings",
      "default frame visual properties",
      "frame realization validation expectations"
    ],
    "does_not_own": [
      "frame widget class law",
      "front-panel containment semantics",
      "canonical .frog source",
      "runtime-private layout handles",
      "IDE-private editing behavior",
      "caption text",
      "method-node behavior",
      "value-flow semantics"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Frame.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.frame",
      "role": "support",
      "primary_value": {
        "present": false
      }
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.frame"
    ],
    "variants": [
      "frog.realizations.default.frame.rectangular"
    ],
    "resources": [
      "frog.realizations.default.frame.assets.rectangular_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.frame",
      "family": "default",
      "target_class": "frog.widgets.frame",
      "variant_property": "realization.variant",
      "default_variant": "rectangular",
      "supported_variants": [
        "rectangular"
      ],
      "supported_parts": [
        "root",
        "background",
        "border"
      ],
      "supported_visual_states": [
        "normal",
        "hidden"
      ],
      "default_properties": {
        "style.background.visible": true,
        "style.background.fill_color": "transparent",
        "style.border.visible": true,
        "style.border.color": "#6b7280",
        "style.border.width": "1px"
      },
      "fallbacks": {
        "missing_variant": "rectangular",
        "missing_background": "transparent_background",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "variants": [
    {
      "id": "frog.realizations.default.frame.rectangular",
      "variant": "rectangular",
      "target_class": "frog.widgets.frame",
      "resource_ref": "frog.realizations.default.frame.assets.rectangular_svg",
      "geometry_posture": {
        "shape_family": "rectangular_support_frame",
        "layout_source": "front_panel_layout_rectangle",
        "scales_to_layout": true,
        "preserve_uniform_border_width": true,
        "supports_background": true
      },
      "fallback": "host_rectangle_frame"
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.frame.assets.rectangular_svg",
      "kind": "svg",
      "path": "./assets/frame/templates/frame_rectangular.svg",
      "target_class": "frog.widgets.frame",
      "target_variant": "rectangular",
      "template_markers": {
        "template": "frog.realizations.default.frame.rectangular",
        "variant": "rectangular",
        "part_attribute": "data-frog-part",
        "binding_attribute": "data-frog-bind"
      }
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_element",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "background",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='background']",
      "style_binding_group": "style.background"
    },
    {
      "part": "border",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='border']",
      "style_binding_group": "style.border",
      "uniform_width_requirement": "vector-effect:non-scaling-stroke"
    }
  ],
  "property_bindings": [
    {
      "member": "style.background.visible",
      "target_part": "background",
      "target_operation": "set_visibility"
    },
    {
      "member": "style.background.fill_color",
      "target_part": "background",
      "target_operation": "set_fill"
    },
    {
      "member": "style.border.visible",
      "target_part": "border",
      "target_operation": "set_visibility"
    },
    {
      "member": "style.border.color",
      "target_part": "border",
      "target_operation": "set_stroke"
    },
    {
      "member": "style.border.width",
      "target_part": "border",
      "target_operation": "set_uniform_stroke_width"
    }
  ],
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_rectangle",
    "resize_posture": "scale_template_to_front_panel_layout_rectangle",
    "style_application_posture": "apply_property_bindings_before_render",
    "accessibility_posture": {
      "role": "presentation",
      "label_source": "label.text"
    }
  },
  "validation_expectations": [
    "target class must exist in Libraries/Widgets/Frame.md",
    "resources must resolve relative to this package file",
    "resource SVG templates must expose root, background, and border parts",
    "border width must stay visually uniform when the frame is resized",
    "border must be a continuous rectangular stroke; the simple Frame baseline does not expose dashed, dotted, or textured border styles",
    "caption, child containment, scrolling, value flow, and method behavior must not be attributed to the simple Frame widget",
    "property bindings must target public frame style members declared by class law"
  ]
}

{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_boolean_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.boolean",
    "name": "FROG Default Boolean Realization",
    "namespace": "frog.realizations.default.boolean",
    "family": "default",
    "summary": "Machine-readable default realization manifest for standardized boolean widgets."
  },
  "ownership_boundary": {
    "owns": [
      "default boolean realization records",
      "default boolean realization variants",
      "boolean realization resource references",
      "boolean part bindings",
      "boolean state maps",
      "boolean realization property bindings",
      "boolean host hints"
    ],
    "does_not_own": [
      "boolean widget class law",
      "boolean widget semantic value meaning",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private widget handles",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Boolean.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.boolean_control",
      "role": "control",
      "primary_value": {
        "present": true,
        "type": "bool",
        "user_mutable": true
      }
    },
    {
      "class_id": "frog.widgets.boolean_indicator",
      "role": "indicator",
      "primary_value": {
        "present": true,
        "type": "bool",
        "user_mutable": false
      }
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.boolean_control",
      "frog.realizations.default.boolean_indicator"
    ],
    "variants": [
      "frog.realizations.default.boolean.rectangular",
      "frog.realizations.default.boolean.circular"
    ],
    "resources": [
      "frog.realizations.default.boolean.assets.rectangular_svg",
      "frog.realizations.default.boolean.assets.circular_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.boolean_control",
      "family": "default",
      "target_class": "frog.widgets.boolean_control",
      "variant_property": "realization.variant",
      "default_variant": "rectangular",
      "supported_variants": [
        "rectangular",
        "circular"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "outer_face",
        "inner_face",
        "state_text",
        "focus_ring",
        "frame"
      ],
      "supported_visual_states": [
        "false",
        "true",
        "hover_false",
        "hover_true",
        "disabled_false",
        "disabled_true",
        "focused_false",
        "focused_true",
        "pressed_false",
        "pressed_true",
        "transition_false_to_true",
        "transition_true_to_false"
      ],
      "fallbacks": {
        "missing_variant": "rectangular",
        "missing_focus_ring": "host_native_focus_ring",
        "missing_state_text": "host_centered_text_region",
        "missing_caption": "host_external_caption_region",
        "missing_label": "host_metadata_label",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    },
    {
      "id": "frog.realizations.default.boolean_indicator",
      "family": "default",
      "target_class": "frog.widgets.boolean_indicator",
      "variant_property": "realization.variant",
      "default_variant": "circular",
      "supported_variants": [
        "rectangular",
        "circular"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "outer_face",
        "inner_face",
        "state_text",
        "focus_ring",
        "frame"
      ],
      "supported_visual_states": [
        "false",
        "true",
        "hover_false",
        "hover_true",
        "disabled_false",
        "disabled_true",
        "focused_false",
        "focused_true",
        "transition_false_to_true",
        "transition_true_to_false"
      ],
      "fallbacks": {
        "missing_variant": "circular",
        "missing_focus_ring": "host_native_focus_ring",
        "missing_state_text": "host_centered_text_region",
        "missing_caption": "host_external_caption_region",
        "missing_label": "host_metadata_label",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "variants": [
    {
      "id": "frog.realizations.default.boolean.rectangular",
      "variant": "rectangular",
      "target_classes": [
        "frog.widgets.boolean_control",
        "frog.widgets.boolean_indicator"
      ],
      "resource_ref": "frog.realizations.default.boolean.assets.rectangular_svg",
      "geometry_posture": {
        "shape_family": "rectangular",
        "layout_source": "front_panel_layout_rectangle",
        "scales_to_layout": true,
        "supports_corner_radius": true,
        "supports_inner_inset": true,
        "supports_state_text_centering": true
      },
      "fallback": "host_rectangle_with_centered_state_text"
    },
    {
      "id": "frog.realizations.default.boolean.circular",
      "variant": "circular",
      "target_classes": [
        "frog.widgets.boolean_control",
        "frog.widgets.boolean_indicator"
      ],
      "resource_ref": "frog.realizations.default.boolean.assets.circular_svg",
      "geometry_posture": {
        "shape_family": "circular",
        "layout_source": "front_panel_layout_rectangle",
        "scales_to_layout": true,
        "preserves_circle_when_square": true,
        "allows_ellipse_when_non_square": true,
        "supports_inner_inset": true,
        "supports_state_text_centering": true
      },
      "fallback": "host_circle_or_ellipse_with_centered_state_text"
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.boolean.assets.rectangular_svg",
      "kind": "svg",
      "path": "./assets/boolean/templates/boolean_rectangular.svg",
      "target_classes": [
        "frog.widgets.boolean_control",
        "frog.widgets.boolean_indicator"
      ],
      "target_variant": "rectangular",
      "template_markers": {
        "template": "frog.realizations.default.boolean.rectangular",
        "variant": "rectangular",
        "part_attribute": "data-frog-part",
        "binding_attribute": "data-frog-bind",
        "member_attribute": "data-frog-member",
        "anchor_attribute": "data-frog-anchor"
      }
    },
    {
      "id": "frog.realizations.default.boolean.assets.circular_svg",
      "kind": "svg",
      "path": "./assets/boolean/templates/boolean_circular.svg",
      "target_classes": [
        "frog.widgets.boolean_control",
        "frog.widgets.boolean_indicator"
      ],
      "target_variant": "circular",
      "template_markers": {
        "template": "frog.realizations.default.boolean.circular",
        "variant": "circular",
        "part_attribute": "data-frog-part",
        "binding_attribute": "data-frog-bind",
        "member_attribute": "data-frog-member",
        "anchor_attribute": "data-frog-anchor"
      }
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_element",
      "binding_selector": "[data-frog-part='root']",
      "role": "widget_root"
    },
    {
      "part": "label",
      "binding_kind": "svg_text_or_metadata",
      "binding_selector": "[data-frog-part='label']",
      "semantic_member": "label.text",
      "visibility_member": "label.visible",
      "placement_role": "structural_label"
    },
    {
      "part": "caption",
      "binding_kind": "svg_text_or_host_text",
      "binding_selector": "[data-frog-part='caption']",
      "semantic_member": "caption.text",
      "visibility_member": "caption.visible",
      "placement_role": "front_panel_caption"
    },
    {
      "part": "outer_face",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='outer_face']",
      "style_binding_group": "style.outer",
      "state_sensitive": true
    },
    {
      "part": "inner_face",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='inner_face']",
      "style_binding_group": "style.inner",
      "state_sensitive": true
    },
    {
      "part": "state_text",
      "binding_kind": "svg_text_or_host_text",
      "binding_selector": "[data-frog-part='state_text']",
      "semantic_members": [
        "state_text.true_text",
        "state_text.false_text"
      ],
      "visibility_member": "state_text.visible",
      "placement_role": "internal_state_text"
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='focus_ring']",
      "style_binding_group": "style.focus_ring",
      "state_sensitive": true
    }
  ],
  "state_maps": [
    {
      "state": "false",
      "value_condition": {
        "value": false
      },
      "property_bindings": [
        "style.outer.fill_color.false",
        "style.outer.border_color.false",
        "style.inner.visible.false",
        "style.inner.fill_color.false",
        "style.inner.border_color.false",
        "state_text.false_text",
        "state_text.style.text_color.false"
      ]
    },
    {
      "state": "true",
      "value_condition": {
        "value": true
      },
      "property_bindings": [
        "style.outer.fill_color.true",
        "style.outer.border_color.true",
        "style.inner.visible.true",
        "style.inner.fill_color.true",
        "style.inner.border_color.true",
        "state_text.true_text",
        "state_text.style.text_color.true"
      ]
    },
    {
      "state": "disabled_false",
      "value_condition": {
        "value": false,
        "interaction.enabled": false
      },
      "inherits": "false",
      "property_bindings": [
        "style.disabled.opacity"
      ]
    },
    {
      "state": "disabled_true",
      "value_condition": {
        "value": true,
        "interaction.enabled": false
      },
      "inherits": "true",
      "property_bindings": [
        "style.disabled.opacity"
      ]
    },
    {
      "state": "focused_false",
      "value_condition": {
        "value": false,
        "interaction.focused": true
      },
      "inherits": "false",
      "property_bindings": [
        "style.focus_ring.visible",
        "style.focus_ring.color",
        "style.focus_ring.width"
      ]
    },
    {
      "state": "focused_true",
      "value_condition": {
        "value": true,
        "interaction.focused": true
      },
      "inherits": "true",
      "property_bindings": [
        "style.focus_ring.visible",
        "style.focus_ring.color",
        "style.focus_ring.width"
      ]
    },
    {
      "state": "hover_false",
      "value_condition": {
        "value": false,
        "interaction.hovered": true
      },
      "target_roles": [
        "control"
      ],
      "inherits": "false",
      "property_bindings": [
        "style.inner.fill_color.hover_false",
        "style.outer.border_color.hover_false",
        "style.hover.cursor"
      ]
    },
    {
      "state": "hover_true",
      "value_condition": {
        "value": true,
        "interaction.hovered": true
      },
      "target_roles": [
        "control"
      ],
      "inherits": "true",
      "property_bindings": [
        "style.inner.fill_color.hover_true",
        "style.outer.border_color.hover_true",
        "style.hover.cursor"
      ]
    },
    {
      "state": "pressed_false",
      "value_condition": {
        "value": false,
        "interaction.pressed": true
      },
      "target_roles": [
        "control"
      ],
      "inherits": "false",
      "property_bindings": [
        "style.inner.fill_color.pressed_false",
        "style.outer.border_color.pressed_false",
        "style.pressed.inset"
      ]
    },
    {
      "state": "pressed_true",
      "value_condition": {
        "value": true,
        "interaction.pressed": true
      },
      "target_roles": [
        "control"
      ],
      "inherits": "true",
      "property_bindings": [
        "style.inner.fill_color.pressed_true",
        "style.outer.border_color.pressed_true",
        "style.pressed.inset"
      ]
    },
    {
      "state": "transition_false_to_true",
      "value_condition": {
        "previous_value": false,
        "value": true
      },
      "target_roles": [
        "control",
        "indicator"
      ],
      "inherits": "true",
      "property_bindings": [
        "style.transition.duration_ms",
        "style.transition.timing"
      ]
    },
    {
      "state": "transition_true_to_false",
      "value_condition": {
        "previous_value": true,
        "value": false
      },
      "target_roles": [
        "control",
        "indicator"
      ],
      "inherits": "false",
      "property_bindings": [
        "style.transition.duration_ms",
        "style.transition.timing"
      ]
    }
  ],
  "property_bindings": [
    {
      "member": "label.text",
      "target_part": "label",
      "target_operation": "set_text_content"
    },
    {
      "member": "label.visible",
      "target_part": "label",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.text",
      "target_part": "caption",
      "target_operation": "set_text_content"
    },
    {
      "member": "caption.visible",
      "target_part": "caption",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.anchor.x",
      "target_part": "caption",
      "target_operation": "set_anchor_x"
    },
    {
      "member": "caption.anchor.y",
      "target_part": "caption",
      "target_operation": "set_anchor_y"
    },
    {
      "member": "caption.align.horizontal",
      "target_part": "caption",
      "target_operation": "set_text_anchor_alignment"
    },
    {
      "member": "caption.style.text_color",
      "target_part": "caption",
      "target_operation": "set_text_fill"
    },
    {
      "member": "caption.style.font_family",
      "target_part": "caption",
      "target_operation": "set_font_family"
    },
    {
      "member": "caption.style.font_size",
      "target_part": "caption",
      "target_operation": "set_font_size"
    },
    {
      "member": "caption.style.font_weight",
      "target_part": "caption",
      "target_operation": "set_font_weight"
    },
    {
      "member": "state_text.visible",
      "target_part": "state_text",
      "target_operation": "set_visibility"
    },
    {
      "member": "state_text.true_text",
      "target_part": "state_text",
      "target_operation": "set_text_content_when_true"
    },
    {
      "member": "state_text.false_text",
      "target_part": "state_text",
      "target_operation": "set_text_content_when_false"
    },
    {
      "member": "style.outer.fill_color.true",
      "target_part": "outer_face",
      "target_operation": "set_fill_when_true"
    },
    {
      "member": "style.outer.fill_color.false",
      "target_part": "outer_face",
      "target_operation": "set_fill_when_false"
    },
    {
      "member": "style.outer.border_color.true",
      "target_part": "outer_face",
      "target_operation": "set_stroke_when_true"
    },
    {
      "member": "style.outer.border_color.false",
      "target_part": "outer_face",
      "target_operation": "set_stroke_when_false"
    },
    {
      "member": "style.outer.border_width",
      "target_part": "outer_face",
      "target_operation": "set_stroke_width"
    },
    {
      "member": "style.outer.corner_radius",
      "target_part": "outer_face",
      "target_operation": "set_rect_corner_radius_when_rectangular"
    },
    {
      "member": "style.inner.visible.true",
      "target_part": "inner_face",
      "target_operation": "set_visibility_when_true"
    },
    {
      "member": "style.inner.visible.false",
      "target_part": "inner_face",
      "target_operation": "set_visibility_when_false"
    },
    {
      "member": "style.inner.fill_color.true",
      "target_part": "inner_face",
      "target_operation": "set_fill_when_true"
    },
    {
      "member": "style.inner.fill_color.false",
      "target_part": "inner_face",
      "target_operation": "set_fill_when_false"
    },
    {
      "member": "style.inner.border_width",
      "target_part": "inner_face",
      "target_operation": "set_stroke_width"
    },
    {
      "member": "style.inner.inset",
      "target_part": "inner_face",
      "target_operation": "set_inset_relative_to_outer_face"
    },
    {
      "member": "style.focus_ring.visible",
      "target_part": "focus_ring",
      "target_operation": "set_visibility"
    },
    {
      "member": "style.focus_ring.color",
      "target_part": "focus_ring",
      "target_operation": "set_stroke"
    },
    {
      "member": "style.focus_ring.width",
      "target_part": "focus_ring",
      "target_operation": "set_stroke_width"
    }
  ],
  "anchors": [
    {
      "id": "frog.realizations.default.boolean.label.anchor",
      "target_part": "label",
      "source_selector": "[data-frog-anchor='label.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.boolean.caption.anchor",
      "target_part": "caption",
      "source_selector": "[data-frog-anchor='caption.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.boolean.state_text.center",
      "target_part": "state_text",
      "source_selector": "[data-frog-anchor='state_text.center']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "center",
      "default_vertical_alignment": "middle"
    }
  ],
  "host_hints": {
    "preferred_host_kind": "svg_template_host",
    "resize_posture": "scale_template_to_front_panel_layout_rectangle",
    "text_rendering_posture": "host_may_replace_template_text_content",
    "style_application_posture": "apply_property_bindings_before_render",
    "accessibility_posture": {
      "role": "switch_or_indicator_by_target_class",
      "state_source": "value",
      "label_source": "label.text",
      "caption_source": "caption.text"
    }
  },
  "validation_expectations": [
    "target classes must exist in Libraries/Widgets/Boolean.md",
    "all declared public parts must exist in the boolean class law",
    "resources must resolve relative to this package file",
    "resource SVG templates should expose data-frog-part markers for declared parts",
    "state maps must not introduce new semantic boolean states beyond true/false and interaction-derived visual states",
    "property bindings must target public boolean members declared by the class law",
    "variant selection must not create a new widget class"
  ]
}

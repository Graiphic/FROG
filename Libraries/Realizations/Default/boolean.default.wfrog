{
  "format": "frog.wfrog",
  "kind": "widget_realization_package",
  "publication_role": "default_boolean_realization_manifest",
  "package_id": "frog.realizations.default.boolean",
  "title": "Default Boolean realization package",
  "reviewed_date": "2026-06-11",
  "metadata": {
    "namespace": "frog.realizations.default.boolean",
    "summary": "Machine-readable default realization manifest for standardized Boolean control and indicator widgets.",
    "contract_summary": "Boolean is one semantic widget family with control/indicator roles and square/round SVG skins. The public skin contract is placement_bounds, state_face, state_text, focus_ring, label, caption, and root."
  },
  "widget_classes": [
    {
      "class_id": "frog.widgets.boolean_control",
      "role": "control",
      "value_type": "bool",
      "properties": [
        { "name": "value" },
        { "name": "caption.text" },
        { "name": "caption.visible" },
        { "name": "state_text.true_text" },
        { "name": "state_text.false_text" },
        { "name": "state_text.visible" },
        { "name": "style.state_face.fill_color.*" },
        { "name": "style.state_face.border_color.*" },
        { "name": "style.state_face.border_width" },
        { "name": "style.focus_ring.*" },
        { "name": "realization.variant" }
      ]
    },
    {
      "class_id": "frog.widgets.boolean_indicator",
      "role": "indicator",
      "value_type": "bool",
      "properties": [
        { "name": "value" },
        { "name": "caption.text" },
        { "name": "caption.visible" },
        { "name": "state_text.true_text" },
        { "name": "state_text.false_text" },
        { "name": "state_text.visible" },
        { "name": "style.state_face.fill_color.*" },
        { "name": "style.state_face.border_color.*" },
        { "name": "style.state_face.border_width" },
        { "name": "style.focus_ring.*" },
        { "name": "realization.variant" }
      ]
    }
  ],
  "realizations": [
    {
      "id": "frog.realizations.default.boolean.rectangular",
      "variant": "rectangular",
      "display_name": "Square LED",
      "resource_ref": "frog.realizations.default.boolean.assets.rectangular_svg",
      "supported_classes": [
        "frog.widgets.boolean_control",
        "frog.widgets.boolean_indicator"
      ],
      "shape_rule": "The state_face is a square/rectangular LED body. IDE resizing may change width and height independently."
    },
    {
      "id": "frog.realizations.default.boolean.circular",
      "variant": "circular",
      "display_name": "Round LED",
      "resource_ref": "frog.realizations.default.boolean.assets.circular_svg",
      "supported_classes": [
        "frog.widgets.boolean_control",
        "frog.widgets.boolean_indicator"
      ],
      "shape_rule": "The state_face is an ellipse. Equal width and height render a circle; independent resizing renders an oval."
    }
  ],
  "svg_assets": [
    {
      "asset_id": "boolean_rectangular_svg",
      "kind": "svg",
      "path": "./assets/boolean/templates/boolean_rectangular.svg",
      "semantic_parts": [
        "root",
        "label",
        "caption",
        "placement_bounds",
        "state_face",
        "focus_ring",
        "state_text"
      ]
    },
    {
      "asset_id": "boolean_circular_svg",
      "kind": "svg",
      "path": "./assets/boolean/templates/boolean_circular.svg",
      "semantic_parts": [
        "root",
        "label",
        "caption",
        "placement_bounds",
        "state_face",
        "focus_ring",
        "state_text"
      ]
    }
  ],
  "host_bindings": [
    {
      "binding_id": "reference_host_default",
      "host_family": "reference_browser_host",
      "target": "reference_browser_host",
      "required_capabilities": [
        "window",
        "basic_widget_rendering",
        "widget_value_binding"
      ],
      "optional_capabilities": [
        "ide_selection_overlay",
        "placement_grid"
      ]
    }
  ],
  "default_widget_properties": [
    {
      "class_id": "frog.widgets.boolean_control",
      "role": "control",
      "visual": {
        "asset_ref": "asset:boolean_rectangular_svg"
      },
      "props": {
        "value": false,
        "caption.text": "Boolean",
        "caption.visible": true,
        "caption.anchor.x": 16,
        "caption.anchor.y": 24,
        "caption.align.horizontal": "left",
        "caption.style.text_color": "#2B3033",
        "caption.style.font_family": "Segoe UI, Arial, sans-serif",
        "caption.style.font_size": "12px",
        "caption.style.font_weight": "400",
        "state_text.true_text": "On",
        "state_text.false_text": "Off",
        "state_text.visible": true,
        "state_text.style.text_color.false": "#2B3033",
        "state_text.style.text_color.true": "#ffffff",
        "state_text.style.font_size": "13px",
        "state_text.style.font_weight": "400",
        "style.state_face.fill_color.false": "#ffffff",
        "style.state_face.fill_color.true": "#4A8DBC",
        "style.state_face.fill_color.hover_false": "#f7fafc",
        "style.state_face.fill_color.hover_true": "#5B9CC7",
        "style.state_face.fill_color.pressed_false": "#e8edf2",
        "style.state_face.fill_color.pressed_true": "#3F7FA9",
        "style.state_face.border_color.false": "#A8ABAE",
        "style.state_face.border_color.true": "#A8ABAE",
        "style.state_face.border_color.hover_false": "#8E9297",
        "style.state_face.border_color.hover_true": "#8E9297",
        "style.state_face.border_color.pressed_false": "#00ADEF",
        "style.state_face.border_color.pressed_true": "#00ADEF",
        "style.state_face.border_width": "1px",
        "style.focus_ring.visible": true,
        "style.focus_ring.color": "#00ADEF",
        "style.focus_ring.width": "1px",
        "style.transition.duration_ms": 120,
        "style.transition.timing": "ease-out",
        "interaction.enabled": true,
        "interaction.read_only": false,
        "interaction.focusable": true,
        "realization.variant": "rectangular"
      }
    },
    {
      "class_id": "frog.widgets.boolean_indicator",
      "role": "indicator",
      "visual": {
        "asset_ref": "asset:boolean_circular_svg"
      },
      "props": {
        "value": false,
        "caption.text": "Boolean",
        "caption.visible": true,
        "caption.anchor.x": 16,
        "caption.anchor.y": 24,
        "caption.align.horizontal": "left",
        "caption.style.text_color": "#2B3033",
        "caption.style.font_family": "Segoe UI, Arial, sans-serif",
        "caption.style.font_size": "12px",
        "caption.style.font_weight": "400",
        "state_text.true_text": "On",
        "state_text.false_text": "Off",
        "state_text.visible": false,
        "state_text.style.text_color.false": "#2B3033",
        "state_text.style.text_color.true": "#ffffff",
        "state_text.style.font_size": "13px",
        "state_text.style.font_weight": "400",
        "style.state_face.fill_color.false": "#ffffff",
        "style.state_face.fill_color.true": "#4A8DBC",
        "style.state_face.border_color.false": "#A8ABAE",
        "style.state_face.border_color.true": "#A8ABAE",
        "style.state_face.border_width": "1px",
        "style.focus_ring.visible": false,
        "style.focus_ring.color": "#00ADEF",
        "style.focus_ring.width": "1px",
        "interaction.enabled": false,
        "interaction.read_only": true,
        "interaction.focusable": false,
        "realization.variant": "circular"
      }
    }
  ],
  "part_bindings": [
    {
      "part": "placement_bounds",
      "role": "placement_bounds",
      "geometry_contract": "The IDE may use this non-rendered rect as the placement aura. It is not the focus ring and it is not a value surface."
    },
    {
      "part": "state_face",
      "role": "boolean_value_surface",
      "style_binding_group": "style.state_face",
      "value_binding": "value"
    },
    {
      "part": "state_text",
      "role": "optional_centered_true_false_text",
      "text_binding": "state_text.true_text/state_text.false_text"
    },
    {
      "part": "focus_ring",
      "role": "keyboard_focus_outline_for_state_face",
      "style_binding_group": "style.focus_ring"
    }
  ],
  "default_geometry_contract": {
    "coordinate_space": "svg_source_units",
    "placement_vocabulary": {
      "placement_bounds_part": "placement_bounds",
      "main_body_concept": "main_body",
      "main_body_parts": [
        "state_face"
      ],
      "aura_band_name": "aura_band",
      "aura_band_source_units": 4,
      "focus_ring_part": "focus_ring",
      "part_names_are_mappings": true
    },
    "placement_bounds": {
      "x": 16,
      "y": 32,
      "width": 72,
      "height": 72,
      "role": "default Boolean placement aura"
    },
    "state_face": {
      "x": 20,
      "y": 36,
      "width": 64,
      "height": 64,
      "role": "default Boolean visible value body"
    },
    "aura_band": {
      "source_units": 4,
      "description": "Default Boolean keeps the same standard vocabulary as other reviewed widgets: a uniform 4 source-unit aura_band between placement_bounds and main_body. The concrete SVG mapping for main_body is state_face. Host resizing scales the skin; the runtime must not invent a different Boolean aura."
    }
  },
  "validation_rules": [
    "A Boolean widget remains frog.widgets.boolean_control or frog.widgets.boolean_indicator regardless of square, round, or oval skin.",
    "The SVG must not publish outer_face, inner_face, or frame as public Boolean parts.",
    "The runtime must bind state colors through style.state_face.* and never hardcode true/false colors outside defaults.",
    "IDE selection aura is represented by placement_bounds; focus_ring remains a main_body/state_face outline.",
    "Default Boolean placement_bounds is 72x72 source units, main_body maps to state_face at 64x64 source units, and the nominal Boolean aura_band is 4 source units, matching the shared aura standard without shrinking the accepted Boolean outer footprint."
  ]
}

{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_boolean_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.boolean",
    "name": "FROG Default Boolean Realization",
    "namespace": "frog.realizations.default.boolean",
    "family": "default",
    "category": "value",
    "role_posture": "control_indicator",
    "summary": "Machine-readable default realization manifest for standardized Boolean control and indicator widgets."
  },
  "ownership_boundary": {
    "owns": [
      "default Boolean realization records",
      "Boolean realization variant declarations",
      "Boolean realization resource references",
      "Boolean part bindings",
      "Boolean visual state maps",
      "Boolean realization property bindings",
      "Boolean anchors",
      "Boolean host hints",
      "Boolean realization validation expectations"
    ],
    "does_not_own": [
      "Boolean widget class law",
      "Boolean value semantics",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private Boolean handles",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Boolean.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.boolean_control",
      "role": "control",
      "primary_value": {
        "present": true,
        "type": "bool",
        "user_mutable": true
      }
    },
    {
      "class_id": "frog.widgets.boolean_indicator",
      "role": "indicator",
      "primary_value": {
        "present": true,
        "type": "bool",
        "user_mutable": false
      }
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.boolean_control",
      "frog.realizations.default.boolean_indicator"
    ],
    "variants": [
      "frog.realizations.default.boolean.rectangular",
      "frog.realizations.default.boolean.circular"
    ],
    "resources": [
      "frog.realizations.default.boolean.assets.rectangular_svg",
      "frog.realizations.default.boolean.assets.circular_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.boolean_control",
      "family": "default",
      "target_class": "frog.widgets.boolean_control",
      "variant_property": "realization.variant",
      "default_variant": "rectangular",
      "supported_variants": [
        "rectangular",
        "circular"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "placement_bounds",
        "state_face",
        "state_text",
        "focus_ring"
      ],
      "supported_visual_states": [
        "false",
        "true",
        "hover_false",
        "hover_true",
        "pressed_false",
        "pressed_true",
        "focused_false",
        "focused_true",
        "disabled_false",
        "disabled_true",
        "transition_false_to_true",
        "transition_true_to_false"
      ],
      "fallbacks": {
        "missing_state_override": "parameterized_svg_template",
        "missing_caption": "host_external_caption_region",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    },
    {
      "id": "frog.realizations.default.boolean_indicator",
      "family": "default",
      "target_class": "frog.widgets.boolean_indicator",
      "variant_property": "realization.variant",
      "default_variant": "circular",
      "supported_variants": [
        "rectangular",
        "circular"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "placement_bounds",
        "state_face",
        "state_text",
        "focus_ring"
      ],
      "supported_visual_states": [
        "false",
        "true",
        "hover_false",
        "hover_true",
        "pressed_false",
        "pressed_true",
        "focused_false",
        "focused_true",
        "disabled_false",
        "disabled_true",
        "transition_false_to_true",
        "transition_true_to_false"
      ],
      "fallbacks": {
        "missing_state_override": "parameterized_svg_template",
        "missing_caption": "host_external_caption_region",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "variants": [
    {
      "id": "frog.realizations.default.boolean.rectangular",
      "variant": "rectangular",
      "target_classes": [
        "frog.widgets.boolean_control",
        "frog.widgets.boolean_indicator"
      ],
      "resource_ref": "frog.realizations.default.boolean.assets.rectangular_svg",
      "geometry_posture": {
        "shape_family": "rectangular_boolean",
        "layout_source": "placement_bounds",
        "scales_to_layout": true,
        "placement_bounds_part": "placement_bounds",
        "visible_body_part": "state_face",
        "host_input_overlay_alignment_part": "state_face",
        "aura_band_units": 4
      },
      "fallback": "host_boolean_surface_only_when_svg_resource_is_missing"
    },
    {
      "id": "frog.realizations.default.boolean.circular",
      "variant": "circular",
      "target_classes": [
        "frog.widgets.boolean_control",
        "frog.widgets.boolean_indicator"
      ],
      "resource_ref": "frog.realizations.default.boolean.assets.circular_svg",
      "geometry_posture": {
        "shape_family": "circular_boolean",
        "layout_source": "placement_bounds",
        "scales_to_layout": true,
        "placement_bounds_part": "placement_bounds",
        "visible_body_part": "state_face",
        "host_input_overlay_alignment_part": "state_face",
        "aura_band_units": 4
      },
      "fallback": "host_boolean_surface_only_when_svg_resource_is_missing"
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.boolean.assets.rectangular_svg",
      "kind": "svg",
      "path": "./assets/boolean/templates/boolean_rectangular.svg",
      "target_classes": [
        "frog.widgets.boolean_control",
        "frog.widgets.boolean_indicator"
      ],
      "target_variant": "rectangular",
      "template_markers": {
        "template": "frog.realizations.default.boolean.rectangular",
        "variant": "rectangular",
        "part_attribute": "data-frog-part",
        "binding_attribute": "data-frog-bind",
        "member_attribute": "data-frog-member",
        "anchor_attribute": "data-frog-anchor"
      }
    },
    {
      "id": "frog.realizations.default.boolean.assets.circular_svg",
      "kind": "svg",
      "path": "./assets/boolean/templates/boolean_circular.svg",
      "target_classes": [
        "frog.widgets.boolean_control",
        "frog.widgets.boolean_indicator"
      ],
      "target_variant": "circular",
      "template_markers": {
        "template": "frog.realizations.default.boolean.circular",
        "variant": "circular",
        "part_attribute": "data-frog-part",
        "binding_attribute": "data-frog-bind",
        "member_attribute": "data-frog-member",
        "anchor_attribute": "data-frog-anchor"
      }
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "label",
      "binding_kind": "svg_text_or_metadata",
      "binding_selector": "[data-frog-part='label']",
      "semantic_member": "label.text",
      "visibility_member": "label.visible",
      "placement_role": "structural_label"
    },
    {
      "part": "caption",
      "binding_kind": "svg_text_or_host_text",
      "binding_selector": "[data-frog-part='caption']",
      "semantic_member": "caption.text",
      "visibility_member": "caption.visible",
      "placement_role": "front_panel_caption"
    },
    {
      "part": "placement_bounds",
      "binding_kind": "svg_geometry",
      "binding_selector": "[data-frog-part='placement_bounds']",
      "semantic_member": "layout.placement_bounds",
      "placement_role": "uniform_aura_around_visible_body"
    },
    {
      "part": "state_face",
      "binding_kind": "svg_shape_or_host_input_overlay_alignment",
      "binding_selector": "[data-frog-part='state_face']",
      "style_binding_group": "style.state_face",
      "semantic_member": "value",
      "state_sensitive": true,
      "host_overlay_role": "input_hit_area_for_controls"
    },
    {
      "part": "state_text",
      "binding_kind": "svg_text_or_host_text",
      "binding_selector": "[data-frog-part='state_text']",
      "semantic_members": [
        "state_text.true_text",
        "state_text.false_text"
      ],
      "visibility_member": "state_text.visible",
      "placement_role": "internal_state_text"
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='focus_ring']",
      "style_binding_group": "style.focus_ring",
      "state_sensitive": true
    }
  ],
  "property_bindings": [
    {
      "member": "label.*",
      "target_part": "label",
      "target_operation": "apply_label"
    },
    {
      "member": "caption.*",
      "target_part": "caption",
      "target_operation": "apply_caption"
    },
    {
      "member": "value",
      "target_part": "state_face",
      "target_operation": "resolve_boolean_visual_state"
    },
    {
      "member": "state_text.*",
      "target_part": "state_text",
      "target_operation": "render_state_text"
    },
    {
      "member": "style.state_face.*",
      "target_part": "state_face",
      "target_operation": "apply_state_face_style"
    },
    {
      "member": "style.focus_ring.*",
      "target_part": "focus_ring",
      "target_operation": "apply_focus_ring_style"
    }
  ],
  "state_maps": [
    {
      "state": "false",
      "value_condition": { "value": false },
      "style_binding_group": "style.state_face.false"
    },
    {
      "state": "true",
      "value_condition": { "value": true },
      "style_binding_group": "style.state_face.true"
    },
    {
      "state": "hover_false",
      "value_condition": { "value": false, "interaction.hovered": true },
      "style_binding_group": "style.state_face.hover_false",
      "inherits": "false"
    },
    {
      "state": "hover_true",
      "value_condition": { "value": true, "interaction.hovered": true },
      "style_binding_group": "style.state_face.hover_true",
      "inherits": "true"
    },
    {
      "state": "pressed_false",
      "value_condition": { "value": false, "interaction.pressed": true },
      "style_binding_group": "style.state_face.pressed_false",
      "inherits": "false"
    },
    {
      "state": "pressed_true",
      "value_condition": { "value": true, "interaction.pressed": true },
      "style_binding_group": "style.state_face.pressed_true",
      "inherits": "true"
    },
    {
      "state": "focused_false",
      "value_condition": { "value": false, "interaction.focused": true },
      "focus_ring_visible": true,
      "inherits": "false"
    },
    {
      "state": "focused_true",
      "value_condition": { "value": true, "interaction.focused": true },
      "focus_ring_visible": true,
      "inherits": "true"
    },
    {
      "state": "disabled_false",
      "value_condition": { "value": false, "interaction.enabled": false },
      "style_posture": "disabled",
      "inherits": "false"
    },
    {
      "state": "disabled_true",
      "value_condition": { "value": true, "interaction.enabled": false },
      "style_posture": "disabled",
      "inherits": "true"
    },
    {
      "state": "transition_false_to_true",
      "transition": { "from": false, "to": true },
      "style_binding_group": "style.transition"
    },
    {
      "state": "transition_true_to_false",
      "transition": { "from": true, "to": false },
      "style_binding_group": "style.transition"
    }
  ],
  "anchors": [
    {
      "id": "frog.realizations.default.boolean.label.anchor",
      "target_part": "label",
      "source_selector": "[data-frog-anchor='label.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.boolean.caption.anchor",
      "target_part": "caption",
      "source_selector": "[data-frog-anchor='caption.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.boolean.state_text.center",
      "target_part": "state_text",
      "source_selector": "[data-frog-anchor='state_text.center']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "center",
      "default_vertical_alignment": "middle"
    }
  ],
  "host_hints": {
    "preferred_host_kind": "svg_template_host",
    "resize_posture": "scale_selected_variant_to_front_panel_layout_rectangle",
    "text_rendering_posture": "host_may_replace_template_text_content",
    "state_rendering_posture": "parameterized_svg_template",
    "style_application_posture": "apply_property_bindings_before_render",
    "input_overlay_posture": {
      "host_overlay_allowed_for_controls": true,
      "target_part": "state_face",
      "overlay_must_not_replace_svg_visual": true
    },
    "accessibility_posture": {
      "control_role": "checkbox",
      "indicator_role": "status",
      "value_source": "value",
      "label_source": "label.text",
      "caption_source": "caption.text"
    }
  },
  "default_widget_properties": [
    {
      "class_id": "frog.widgets.boolean_control",
      "role": "control",
      "visual": {
        "asset_ref": "asset:boolean_rectangular_svg"
      },
      "props": {
        "value": false,
        "caption.text": "Boolean",
        "caption.visible": true,
        "caption.anchor.x": 16,
        "caption.anchor.y": 24,
        "caption.align.horizontal": "left",
        "caption.style.text_color": "#2B3033",
        "caption.style.font_family": "Segoe UI, Arial, sans-serif",
        "caption.style.font_size": "12px",
        "caption.style.font_weight": "400",
        "state_text.true_text": "On",
        "state_text.false_text": "Off",
        "state_text.visible": true,
        "state_text.style.text_color.false": "#2B3033",
        "state_text.style.text_color.true": "#ffffff",
        "state_text.style.font_size": "13px",
        "state_text.style.font_weight": "400",
        "style.state_face.fill_color.false": "#ffffff",
        "style.state_face.fill_color.true": "#4A8DBC",
        "style.state_face.fill_color.hover_false": "#f7fafc",
        "style.state_face.fill_color.hover_true": "#5B9CC7",
        "style.state_face.fill_color.pressed_false": "#e8edf2",
        "style.state_face.fill_color.pressed_true": "#3F7FA9",
        "style.state_face.border_color.false": "#A8ABAE",
        "style.state_face.border_color.true": "#A8ABAE",
        "style.state_face.border_color.hover_false": "#8E9297",
        "style.state_face.border_color.hover_true": "#8E9297",
        "style.state_face.border_color.pressed_false": "#00ADEF",
        "style.state_face.border_color.pressed_true": "#00ADEF",
        "style.state_face.border_width": "1px",
        "style.focus_ring.visible": true,
        "style.focus_ring.color": "#00ADEF",
        "style.focus_ring.width": "1px",
        "style.transition.duration_ms": 120,
        "style.transition.timing": "ease-out",
        "interaction.enabled": true,
        "interaction.read_only": false,
        "interaction.focusable": true,
        "realization.variant": "rectangular"
      }
    },
    {
      "class_id": "frog.widgets.boolean_indicator",
      "role": "indicator",
      "visual": {
        "asset_ref": "asset:boolean_circular_svg"
      },
      "props": {
        "value": false,
        "caption.text": "Boolean",
        "caption.visible": true,
        "caption.anchor.x": 16,
        "caption.anchor.y": 24,
        "caption.align.horizontal": "left",
        "caption.style.text_color": "#2B3033",
        "caption.style.font_family": "Segoe UI, Arial, sans-serif",
        "caption.style.font_size": "12px",
        "caption.style.font_weight": "400",
        "state_text.true_text": "On",
        "state_text.false_text": "Off",
        "state_text.visible": false,
        "state_text.style.text_color.false": "#2B3033",
        "state_text.style.text_color.true": "#ffffff",
        "state_text.style.font_size": "13px",
        "state_text.style.font_weight": "400",
        "style.state_face.fill_color.false": "#ffffff",
        "style.state_face.fill_color.true": "#4A8DBC",
        "style.state_face.border_color.false": "#A8ABAE",
        "style.state_face.border_color.true": "#A8ABAE",
        "style.state_face.border_width": "1px",
        "style.focus_ring.visible": false,
        "style.focus_ring.color": "#00ADEF",
        "style.focus_ring.width": "1px",
        "interaction.enabled": false,
        "interaction.read_only": true,
        "interaction.focusable": false,
        "realization.variant": "circular"
      }
    }
  ],
  "default_geometry_contract": {
    "coordinate_space": "svg_source_units",
    "placement_vocabulary": {
      "placement_bounds_part": "placement_bounds",
      "main_body_concept": "main_body",
      "main_body_parts": [
        "state_face"
      ],
      "aura_band_name": "aura_band",
      "aura_band_source_units": 4,
      "focus_ring_part": "focus_ring",
      "part_names_are_mappings": true
    },
    "placement_bounds": {
      "x": 16,
      "y": 32,
      "width": 36,
      "height": 36,
      "role": "default Boolean placement aura"
    },
    "state_face": {
      "x": 20,
      "y": 36,
      "width": 28,
      "height": 28,
      "role": "default Boolean visible value body"
    },
    "aura_band": {
      "source_units": 4,
      "description": "The placement aura remains distinct from the visible state face and keyboard focus ring."
    }
  },
  "validation_expectations": [
    "target classes must exist in Libraries/Widgets/Boolean.md",
    "all declared public parts must exist in the Boolean class law",
    "resources must resolve relative to this package file",
    "resource SVG templates must expose data-frog-part markers for declared SVG-bound parts",
    "the Boolean value and control or indicator role must remain source-owned semantics",
    "rectangular and circular are realization variants and must not create new widget classes",
    "state maps must cover value, hover, pressed, focus, disabled, and value-transition states",
    "placement_bounds must remain a non-rendered public placement aura distinct from state_face and focus_ring",
    "property bindings must target public Boolean members declared by class law",
    "host input overlays may align to state_face for controls but must never replace the SVG visual"
  ]
}

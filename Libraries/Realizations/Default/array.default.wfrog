      "props": {
        "style.frame.fill_color": "#EEF4F6",
        "style.frame.border_color": "#A8ABAE",
        "style.frame.border_width": "1px",
        "style.frame.padding": 5,
        "style.array_region.fill_color": "#EEF4F6",
        "style.array_region.border_color": "#A8ABAE",
        "style.array_region.border_width": "0px",
        "style.grid_line.color": "#d6dee8",
        "style.grid_line.width": "0px",
        "style.index_display.fill_color": "#ffffff",
        "style.index_display.border_color": "#A8ABAE",
        "style.index_display.border_width": "1px",
        "style.index_display.container_fill_color": "#EEF4F6",
        "style.index_display.container_border_color": "#A8ABAE",
        "style.index_display.container_border_width": "1px",
        "style.index_display.container_padding": "4px",
        "style.index_display.step_fill_color": "#DDE1E4",
        "style.index_display.step_hover_fill_color": "#E0E4E6",
        "style.index_display.step_pressed_fill_color": "#D2D4D5",
        "style.index_display.glyph_color": "#2B3033",
        "style.index_display.step_gap": 2,
        "style.index_display.value_gap": 4,
        "style.scrollbar.track_fill_color": "#DDE1E4",
        "style.scrollbar.track_hover_fill_color": "#E0E4E6",
        "style.scrollbar.track_pressed_fill_color": "#D2D4D5",
        "style.scrollbar.border_color": "#A8ABAE",
        "style.scrollbar.border_width": "1px",
        "style.scrollbar.thumb_fill_color": "#A8ABAE",
        "style.scrollbar.thumb_hover_fill_color": "#8E9297",
        "style.scrollbar.thumb_pressed_fill_color": "#8E9297",
        "style.scrollbar.thumb_padding_percent": 4,
        "style.scrollbar.thickness": "16px",
        "style.scrollbar.horizontal_height": "16px",
        "style.scrollbar.vertical_thumb_width_percent": 66.67,
        "style.scrollbar.vertical_thumb_offset_x_percent": 50,
        "style.scrollbar.vertical_thumb_translate_x": "-50%",
        "style.scrollbar.horizontal_thumb_height_percent": 66.67,
        "style.scrollbar.horizontal_thumb_offset_y_percent": 16.67,
        "style.element.fill_color": "transparent",

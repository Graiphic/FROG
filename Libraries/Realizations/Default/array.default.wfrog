    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "resource_ref": "frog.realizations.default.array.assets.shell_svg",
      "binding_selector": "[data-frog-part='root']",
      "role": "widget_root"
    },
    {
      "part": "label",
      "resource_ref": "frog.realizations.default.array.assets.shell_svg",
      "binding_selector": "[data-frog-part='label']",
      "semantic_member": "label.text"
    },
    {
      "part": "caption",
      "resource_ref": "frog.realizations.default.array.assets.shell_svg",
      "binding_selector": "[data-frog-part='caption']",
      "semantic_member": "caption.text"
    },
    {
      "part": "frame",
      "resource_ref": "frog.realizations.default.array.assets.shell_svg",
      "binding_selector": "[data-frog-part='frame']",
      "semantic_member": "style.frame.*",
      "placement_role": "outer_array_container_frame"
    },
    {
      "part": "index_display",
      "resource_ref": "frog.realizations.default.array.assets.index_display_svg",
      "binding_selector": "[data-frog-part='index_display']",
      "semantic_member": "index_display.*"
    },
    {
      "part": "dimension_controls",
      "resource_ref": "frog.realizations.default.array.assets.shell_svg",
      "binding_selector": "[data-frog-part='dimension_controls']",
      "semantic_member": "dimensions.*"
    },
    {
      "part": "element_region",
      "resource_ref": "frog.realizations.default.array.assets.element_region_svg",
      "binding_selector": "[data-frog-part='element_region']",
      "semantic_members": [
        "value",
        "viewport.*",
        "element.*"
      ]
    },
    {
      "part": "element_slot",
      "resource_ref": "frog.realizations.default.array.assets.element_slot_svg",
      "binding_selector": "[data-frog-part='element_slot']",
      "semantic_member": "element.template_ref"
    },
    {
      "part": "element_gap",
      "resource_ref": "frog.realizations.default.array.assets.shell_svg",
      "binding_selector": "[data-frog-part='element_gap']",
      "semantic_member": "element_gap.size"
    },
    {
      "part": "vertical_scrollbar",
      "resource_ref": "frog.realizations.default.array.assets.vertical_scrollbar_svg",
      "binding_selector": "[data-frog-part='vertical_scrollbar']",
      "semantic_member": "scrollbars.vertical.*"
    },
    {
      "part": "horizontal_scrollbar",
      "resource_ref": "frog.realizations.default.array.assets.horizontal_scrollbar_svg",
      "binding_selector": "[data-frog-part='horizontal_scrollbar']",
      "semantic_member": "scrollbars.horizontal.*"
    },
    {
      "part": "focus_ring",
      "resource_ref": "frog.realizations.default.array.assets.shell_svg",
      "binding_selector": "[data-frog-part='focus_ring']",
      "semantic_members": [
        "interaction.focused",
        "style.focus_ring.*"
      ]
    }
  ],
  "property_bindings": [
    {
      "member": "caption.text",
      "target_part": "caption",
      "target_operation": "set_text_content"
    },
    {
      "member": "caption.visible",
      "target_part": "caption",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.anchor.x",
      "target_part": "caption",
      "target_operation": "set_anchor_x"
    },
    {
      "member": "caption.anchor.y",
      "target_part": "caption",
      "target_operation": "set_anchor_y"
    },
    {
      "member": "caption.align.horizontal",
      "target_part": "caption",
      "target_operation": "set_text_anchor_alignment"
    }
  ],
  "anchors": [
    {
      "id": "frog.realizations.default.array.label.anchor",
      "target_part": "label",
      "source_selector": "[data-frog-anchor='label.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.array.caption.anchor",
      "target_part": "caption",
      "source_selector": "[data-frog-anchor='caption.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    }
  ],
  "host_hints": {
    "preferred_host_kind": "subobject_svg_composition_or_host_native_repeater",
    "composition_posture": "assemble_subobject_assets_into_shell_slots",
    "element_rendering_posture": "host_instantiates_element_template_per_visible_cell",
    "element_default_value_posture": "semantic_default_value_comes_from_frog_element_model_not_realization",
    "element_cell_sizing_posture": "for_widget_backed_cells_the_array_cell_is_the_contained_widget_placement_bounds; explicit source_owned_cell_dimensions_must_match_that_aura_for_the_selected_widget_posture",
    "grid_placement_posture": "array_element_cells_follow_the_common_16px_widget_placement_grid_when_hosting_widgets",
    "frame_layout_posture": "array_element_viewport_frame_uses_source_owned_style_frame_properties_and_stays_visually_separate_from_neighboring_index_display_subcontainer",
    "index_display_spacing_posture": "arrow_gap_and_value_gap_are_source_owned_style_index_display_properties",
    "index_display_container_posture": "visible_index_display_may_have_its_own_source_owned_subcontainer_fill_border_and_padding",
    "array_widget_placement_aura_posture": "Array widget selection aura is the external placement envelope of the complete container including index_display, element_region, scrollbars, frame, and container background; it is distinct from internal cell selection and contained widget placement_bounds",
    "array_label_aura_posture": "caption/label may render a separate IDE aura above the Array body aura; the Array body aura stays the grid-snapped placement reference for the whole widget",
    "element_fit_part_posture": "reviewed_widget_backed_cells_fit_to_contained_widget_placement_bounds; other fit parts are opt_in_variant_postures_not_the_default",
    "element_padding_posture": "contained_widget_placement_bounds_cells_use_zero_array_padding_because_the_contained_widget_aura_already_provides_the_band_around_its_body",
    "contained_widget_boundary_posture": "widget_backed_cells_respect_the_contained_widget_placement_aura; hover and selection belong to the array cell, not to the contained widget focus ring",
    "numeric_control_indicator_color_posture": "reviewed Default Numeric-backed Array controls use white editable value faces with increment/decrement controls; indicators use the Default Numeric indicator gray #E8EBED and hide increment/decrement controls; both keep the compact Numeric value_face border #A8ABAE at 1px; reviewed Array container body fill is #EEF4F6 with white index value surfaces; Array frame/region borders and scrollbar helper borders/thumbs use #A8ABAE with #DDE1E4 helper faces unless source overrides them",
    "virtualization_posture": "allowed_if_public_viewport_state_is_preserved"
  },
  "validation_expectations": [
    "target class must exist in Libraries/Widgets/Array.md",
    "all declared public parts must exist in the array class law",
    "shell resource must resolve",
    "all subobject resources must resolve",
    "element class must be compatible with element model",
    "element default value must be provided by source-owned element model when materialization is allowed",
    "element widget overlays must align to Array element_region and element_slot parts",
    "array frame styling must remain source-owned, stay separate from visible index display subcontainers, and stay separate from contained widget frame styling",
    "Array widget selection aura must cover the complete Array placement envelope, not only element_region, not only visible cells, and not any contained widget focus ring",
    "Array caption/label aura must remain separate from the Array body placement aura while preserving the shared grid law",
    "index display container fill, border, padding, arrow spacing, and value spacing must remain source-owned and aligned to the published index_display part",
    "index display frame, separator, arrow, and text details must remain data-frog-detail internals rather than additional public data-frog-part entries",
    "element fit parts must be published by the contained widget realization when used; reviewed widget-backed cells use placement_bounds",
    "element layout padding must remain source-owned and must inset the contained widget instance rather than create an array-local surrogate visual; reviewed contained_widget_placement_bounds cells use padding 0",
    "widget-backed element cell size must come from the contained widget placement bounds or explicit source-owned cell dimensions that match that aura",
    "widget-backed element cells must respect contained-widget placement bounds and the common grid/aura law documented in Libraries/Widgets/PlacementGrid.md",
    "Numeric-backed Array controls and indicators must keep distinct source-owned value-face fills so editability is visible without hardcoded runtime heuristics",
    "Numeric-backed Array cells must keep the contained Numeric value_face border visible via element.props.style.value_face.* rather than an Array-local fake frame",
    "Numeric-backed Array examples must keep reviewed frame/region, scrollbar, helper, and selection colors source-owned rather than mixing legacy green or blue-gray runtime defaults",
    "selection and hover state on widget-backed cells must cover the Array cell placement surface, not the contained widget focus ring",
    "selection state must not resize cells, shift contained widgets, or add runtime-local selection geometry unless source-owned style declares it",
    "element cells must not become the only semantic storage for array value",
    "scrollbar helpers must not be treated as array semantics"
  ]
}

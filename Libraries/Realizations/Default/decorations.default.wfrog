{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_decorations_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.decorations",
    "name": "FROG Default decorations Realization",
    "namespace": "frog.realizations.default.decorations",
    "family": "default",
    "category": "support",
    "role_posture": "decorative support",
    "summary": "Machine-readable default realization manifest for standardized decorations widgets."
  },
  "ownership_boundary": {
    "owns": [
      "default decorations realization records",
      "decorations realization resources",
      "decorations part bindings",
      "decorations host hints",
      "decorations validation expectations"
    ],
    "does_not_own": [
      "decorations widget class law",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private host handles",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Decorations.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.flat_box",
      "role": "support"
    },
    {
      "class_id": "frog.widgets.horizontal_line",
      "role": "support"
    },
    {
      "class_id": "frog.widgets.vertical_line",
      "role": "support"
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.decorations"
    ],
    "resources": [
      "frog.realizations.default.decorations.assets.flat_box_svg",
      "frog.realizations.default.decorations.assets.horizontal_line_svg",
      "frog.realizations.default.decorations.assets.vertical_line_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.decorations",
      "family": "default",
      "target_classes": [
        "frog.widgets.flat_box",
        "frog.widgets.horizontal_line",
        "frog.widgets.vertical_line"
      ],
      "supported_parts": [
        "root",
        "shape",
        "line"
      ],
      "fallbacks": {
        "missing_resource": "host_native_or_generic_compatible_rendering",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.decorations.assets.flat_box_svg",
      "kind": "svg",
      "path": "./assets/decorations/templates/flat_box.svg",
      "target_class": "frog.widgets.flat_box"
    },
    {
      "id": "frog.realizations.default.decorations.assets.horizontal_line_svg",
      "kind": "svg",
      "path": "./assets/decorations/templates/horizontal_line.svg",
      "target_class": "frog.widgets.horizontal_line"
    },
    {
      "id": "frog.realizations.default.decorations.assets.vertical_line_svg",
      "kind": "svg",
      "path": "./assets/decorations/templates/vertical_line.svg",
      "target_class": "frog.widgets.vertical_line"
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "shape",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='shape']"
    },
    {
      "part": "line",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='line']"
    }
  ],
  "property_bindings": [
    {
      "member": "style.*",
      "target_part": "shape",
      "target_operation": "apply_decoration_style"
    },
    {
      "member": "style.*",
      "target_part": "line",
      "target_operation": "apply_line_style"
    }
  ],
  "state_maps": [
    {
      "state": "normal"
    }
  ],
  "composition": null,
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_widget",
    "style_application_posture": "apply_property_bindings_before_render"
  },
  "validation_expectations": [
    "target classes must exist in the referenced widget class-law document",
    "all declared public parts must exist in widget class law",
    "resources must resolve relative to this package file",
    "resources must not become semantic owners of widget value",
    "runtime-private host handles must not be exposed as public widget members"
  ]
}

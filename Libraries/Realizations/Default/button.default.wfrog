{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_button_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.button",
    "name": "FROG Default Button Realization",
    "namespace": "frog.realizations.default.button",
    "family": "default",
    "category": "action",
    "role_posture": "command",
    "summary": "Machine-readable default realization manifest for the standardized button widget."
  },
  "ownership_boundary": {
    "owns": [
      "default button realization record",
      "button realization variant declarations",
      "button realization resource references",
      "button part bindings",
      "button state maps",
      "button anchors and overlay alignment surfaces",
      "button mechanical-action realization posture",
      "button host hints",
      "button realization validation expectations"
    ],
    "does_not_own": [
      "button widget class law",
      "button value semantics",
      "button mechanical-action semantics",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private button handles",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Button.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.button",
      "role": "command",
      "primary_value": {
        "present": true,
        "type": "bool",
        "mechanical_action_dependent": true
      }
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.button"
    ],
    "variants": [
      "frog.realizations.default.button.rectangular"
    ],
    "resources": [
      "frog.realizations.default.button.assets.rectangular_template_svg",
      "frog.realizations.default.button.assets.state.false_svg",
      "frog.realizations.default.button.assets.state.true_svg",
      "frog.realizations.default.button.assets.state.hover_false_svg",
      "frog.realizations.default.button.assets.state.hover_true_svg",
      "frog.realizations.default.button.assets.state.transition_false_to_true_svg",
      "frog.realizations.default.button.assets.state.transition_true_to_false_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.button",
      "family": "default",
      "target_class": "frog.widgets.button",
      "variant_property": "realization.variant",
      "default_variant": "rectangular",
      "supported_variants": [
        "rectangular"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "frame",
        "face",
        "state_face",
        "state_text",
        "focus_ring"
      ],
      "supported_visual_states": [
        "false",
        "true",
        "hover_false",
        "hover_true",
        "pressed_false",
        "pressed_true",
        "disabled_false",
        "disabled_true",
        "focused_false",
        "focused_true",
        "transition_false_to_true",
        "transition_true_to_false"
      ],
      "supported_mechanical_actions": [
        "switch_when_pressed",
        "switch_when_released",
        "switch_until_released",
        "latch_when_pressed",
        "latch_when_released",
        "latch_until_released"
      ],
      "fallbacks": {
        "missing_state_override": "parameterized_rectangular_template",
        "missing_focus_ring": "host_native_focus_ring",
        "missing_caption": "host_external_caption_region",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "variants": [
    {
      "id": "frog.realizations.default.button.rectangular",
      "variant": "rectangular",
      "target_class": "frog.widgets.button",
      "resource_ref": "frog.realizations.default.button.assets.rectangular_template_svg",
      "geometry_posture": {
        "shape_family": "rectangular_button",
        "layout_source": "front_panel_layout_rectangle",
        "scales_to_layout": true,
        "supports_caption": true,
        "supports_state_text_centering": true,
        "supports_host_input_overlay": true,
        "host_input_overlay_alignment_part": "face"
      },
      "fallback": "host_button_only_when_svg_resource_is_missing"
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.button.assets.rectangular_template_svg",
      "kind": "svg",
      "path": "./assets/button/templates/button_rectangular.svg",
      "target_class": "frog.widgets.button",
      "target_variant": "rectangular",
      "template_markers": {
        "template": "frog.realizations.default.button.rectangular",
        "variant": "rectangular",
        "part_attribute": "data-frog-part",
        "binding_attribute": "data-frog-bind",
        "member_attribute": "data-frog-member",
        "anchor_attribute": "data-frog-anchor"
      }
    },
    {
      "id": "frog.realizations.default.button.assets.state.false_svg",
      "kind": "svg",
      "path": "./assets/button/states/button_false.svg",
      "target_class": "frog.widgets.button",
      "target_state": "false",
      "override_posture": "optional_state_resource"
    },
    {
      "id": "frog.realizations.default.button.assets.state.true_svg",
      "kind": "svg",
      "path": "./assets/button/states/button_true.svg",
      "target_class": "frog.widgets.button",
      "target_state": "true",
      "override_posture": "optional_state_resource"
    },
    {
      "id": "frog.realizations.default.button.assets.state.hover_false_svg",
      "kind": "svg",
      "path": "./assets/button/states/button_hover_false.svg",
      "target_class": "frog.widgets.button",
      "target_state": "hover_false",
      "override_posture": "optional_state_resource"
    },
    {
      "id": "frog.realizations.default.button.assets.state.hover_true_svg",
      "kind": "svg",
      "path": "./assets/button/states/button_hover_true.svg",
      "target_class": "frog.widgets.button",
      "target_state": "hover_true",
      "override_posture": "optional_state_resource"
    },
    {
      "id": "frog.realizations.default.button.assets.state.transition_false_to_true_svg",
      "kind": "svg",
      "path": "./assets/button/states/button_transition_false_to_true.svg",
      "target_class": "frog.widgets.button",
      "target_state": "transition_false_to_true",
      "override_posture": "optional_transition_resource"
    },
    {
      "id": "frog.realizations.default.button.assets.state.transition_true_to_false_svg",
      "kind": "svg",
      "path": "./assets/button/states/button_transition_true_to_false.svg",
      "target_class": "frog.widgets.button",
      "target_state": "transition_true_to_false",
      "override_posture": "optional_transition_resource"
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "label",
      "binding_kind": "svg_text_or_metadata",
      "binding_selector": "[data-frog-part='label']",
      "semantic_member": "label.text",
      "visibility_member": "label.visible",
      "placement_role": "structural_label"
    },
    {
      "part": "caption",
      "binding_kind": "svg_text_or_host_text",
      "binding_selector": "[data-frog-part='caption']",
      "semantic_member": "caption.text",
      "visibility_member": "caption.visible",
      "placement_role": "front_panel_caption"
    },
    {
      "part": "frame",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='frame']",
      "style_binding_group": "style.frame"
    },
    {
      "part": "face",
      "binding_kind": "svg_shape_or_host_input_overlay_alignment",
      "binding_selector": "[data-frog-part='face']",
      "style_binding_group": "style.face",
      "state_sensitive": true,
      "host_overlay_role": "input_hit_area"
    },
    {
      "part": "state_face",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='state_face']",
      "style_binding_group": "style.state_face",
      "state_sensitive": true
    },
    {
      "part": "state_text",
      "binding_kind": "svg_text_or_host_text",
      "binding_selector": "[data-frog-part='state_text']",
      "semantic_members": [
        "state_text.false_text",
        "state_text.true_text"
      ],
      "visibility_member": "state_text.visible",
      "placement_role": "internal_state_text"
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_shape",
      "binding_selector": "[data-frog-part='focus_ring']",
      "style_binding_group": "style.focus_ring",
      "state_sensitive": true
    }
  ],
  "property_bindings": [
    {
      "member": "label.text",
      "target_part": "label",
      "target_operation": "set_text_content"
    },
    {
      "member": "label.visible",
      "target_part": "label",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.text",
      "target_part": "caption",
      "target_operation": "set_text_content"
    },
    {
      "member": "caption.visible",
      "target_part": "caption",
      "target_operation": "set_visibility"
    },
    {
      "member": "caption.anchor.x",
      "target_part": "caption",
      "target_operation": "set_anchor_x"
    },
    {
      "member": "caption.anchor.y",
      "target_part": "caption",
      "target_operation": "set_anchor_y"
    },
    {
      "member": "caption.align.horizontal",
      "target_part": "caption",
      "target_operation": "set_text_anchor_alignment"
    },
    {
      "member": "caption.style.text_color",
      "target_part": "caption",
      "target_operation": "set_text_fill"
    },
    {
      "member": "caption.style.font_family",
      "target_part": "caption",
      "target_operation": "set_font_family"
    },
    {
      "member": "caption.style.font_size",
      "target_part": "caption",
      "target_operation": "set_font_size"
    },
    {
      "member": "caption.style.font_weight",
      "target_part": "caption",
      "target_operation": "set_font_weight"
    },
    {
      "member": "value",
      "target_part": "state_face",
      "target_operation": "resolve_button_state"
    },
    {
      "member": "state_text.visible",
      "target_part": "state_text",
      "target_operation": "set_visibility"
    },
    {
      "member": "state_text.*",
      "target_part": "state_text",
      "target_operation": "render_state_text"
    },
    {
      "member": "state_text.style.*",
      "target_part": "state_text",
      "target_operation": "apply_text_style"
    },
    {
      "member": "style.frame.*",
      "target_part": "frame",
      "target_operation": "apply_frame_style"
    },
    {
      "member": "style.face.*",
      "target_part": "face",
      "target_operation": "apply_face_style"
    },
    {
      "member": "style.state_face.*",
      "target_part": "state_face",
      "target_operation": "apply_state_face_style"
    },
    {
      "member": "style.focus_ring.*",
      "target_part": "focus_ring",
      "target_operation": "apply_focus_ring_style"
    },
    {
      "member": "style.pressed.inset",
      "target_part": "face",
      "target_operation": "apply_pressed_transform"
    },
    {
      "member": "style.transition.*",
      "target_part": "root",
      "target_operation": "apply_transition_timing"
    },
    {
      "member": "behavior.mechanical_action",
      "target_part": "root",
      "target_operation": "configure_mechanical_action"
    }
  ],
  "state_maps": [
    {
      "state": "false",
      "value_condition": {
        "value": false
      },
      "resource_ref": "frog.realizations.default.button.assets.state.false_svg"
    },
    {
      "state": "true",
      "value_condition": {
        "value": true
      },
      "resource_ref": "frog.realizations.default.button.assets.state.true_svg"
    },
    {
      "state": "hover_false",
      "value_condition": {
        "value": false,
        "interaction.hovered": true
      },
      "inherits": "false",
      "resource_ref": "frog.realizations.default.button.assets.state.hover_false_svg"
    },
    {
      "state": "hover_true",
      "value_condition": {
        "value": true,
        "interaction.hovered": true
      },
      "inherits": "true",
      "resource_ref": "frog.realizations.default.button.assets.state.hover_true_svg"
    },
    {
      "state": "transition_false_to_true",
      "transition_condition": {
        "from": false,
        "to": true
      },
      "resource_ref": "frog.realizations.default.button.assets.state.transition_false_to_true_svg",
      "optional": true
    },
    {
      "state": "transition_true_to_false",
      "transition_condition": {
        "from": true,
        "to": false
      },
      "resource_ref": "frog.realizations.default.button.assets.state.transition_true_to_false_svg",
      "optional": true
    }
  ],
  "mechanical_action_model": {
    "property": "behavior.mechanical_action",
    "values": [
      "switch_when_pressed",
      "switch_when_released",
      "switch_until_released",
      "latch_when_pressed",
      "latch_when_released",
      "latch_until_released"
    ],
    "latch_reset_policy": {
      "default": "reset_on_natural_value_consumption",
      "property_read_resets_latch": false
    }
  },
  "anchors": [
    {
      "id": "frog.realizations.default.button.label.anchor",
      "target_part": "label",
      "source_selector": "[data-frog-anchor='label.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.button.caption.anchor",
      "target_part": "caption",
      "source_selector": "[data-frog-anchor='caption.anchor']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "start",
      "default_vertical_alignment": "baseline"
    },
    {
      "id": "frog.realizations.default.button.state_text.center",
      "target_part": "state_text",
      "source_selector": "[data-frog-anchor='state_text.center']",
      "anchor_kind": "text_anchor",
      "default_horizontal_alignment": "center",
      "default_vertical_alignment": "middle"
    },
    {
      "id": "frog.realizations.default.button.face.bounds",
      "target_part": "face",
      "source_selector": "[data-frog-anchor='face.bounds']",
      "anchor_kind": "part_bounds",
      "default_horizontal_alignment": "stretch",
      "default_vertical_alignment": "stretch",
      "host_overlay_alignment": true
    },
    {
      "id": "frog.realizations.default.button.state_face.bounds",
      "target_part": "state_face",
      "source_selector": "[data-frog-anchor='state_face.bounds']",
      "anchor_kind": "part_bounds",
      "default_horizontal_alignment": "stretch",
      "default_vertical_alignment": "stretch"
    }
  ],
  "host_hints": {
    "preferred_host_kind": "svg_template_host",
    "resize_posture": "scale_template_to_front_panel_layout_rectangle",
    "text_rendering_posture": "host_may_replace_template_text_content",
    "state_rendering_posture": "resolve_state_map_before_render",
    "style_application_posture": "apply_property_bindings_before_render",
    "input_overlay_posture": {
      "host_overlay_allowed": true,
      "target_part": "face",
      "alignment_anchor": "frog.realizations.default.button.face.bounds",
      "overlay_must_not_replace_svg_visual": true
    },
    "accessibility_posture": {
      "role": "button",
      "value_source": "value",
      "label_source": "label.text",
      "caption_source": "caption.text"
    }
  },
  "validation_expectations": [
    "target class must exist in Libraries/Widgets/Button.md",
    "all declared public parts must exist in the button class law",
    "resources must resolve relative to this package file",
    "optional state resources may fall back to the rectangular template when unavailable",
    "button value semantics and mechanical-action semantics must remain owned by the button class law",
    "SVG resources must not become semantic owners of button value or mechanical action",
    "property bindings must target public button members declared by class law",
    "variant selection must not create a new widget class"
  ]
}

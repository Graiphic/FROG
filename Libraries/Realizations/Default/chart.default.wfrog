  },
  "validation_expectations": [
    "target class must exist in Libraries/Widgets/Chart.md",
    "all declared public parts must exist in the chart class law",
    "shell resource must resolve",
    "all subobject resources must resolve",
    "subobject slots must reference declared resources",
    "resource SVG templates should expose data-frog-part or data-frog-slot markers",
    "plot_layer must not be treated as semantic storage for history data",
    "host-native plotting handles must remain realization-private"
  ]
}

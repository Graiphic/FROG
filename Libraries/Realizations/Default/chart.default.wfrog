      "frog.realizations.default.chart.assets.threshold_band_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.waveform_chart",
      "family": "default",
      "target_class": "frog.widgets.waveform_chart",
      "variant_property": "realization.variant",
      "default_variant": "rectangular",
      "supported_variants": [
        "rectangular"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "frame",
        "plot_area",
        "history_region",
        "plot_layer",
        "plot_polyline",
        "plot_marker",
        "grid",
        "axis_tick",
        "x_scale",
        "y_scale",
        "x_scale_label",
        "y_scale_label",
        "plot_legend",
        "scale_legend",
        "cursor_legend",
        "graph_palette",
        "x_scrollbar",
        "y_scrollbar",
        "cursor_layer",
        "cursor_readout",
        "plot_image_back",
        "plot_image_middle",
        "plot_image_front",
        "annotation_layer",
        "threshold_band",
        "focus_ring"
      ],
      "supported_payload_kinds": [
        "single_sample",
        "sample_array",
        "multi_plot_sample",
        "multi_plot_arrays",
        "waveform",
        "history_replace"
      ],
      "supported_timebase_modes": [
        "sample_index",
        "relative_time",
        "absolute_time"
      ],
      "supported_interpolations": [
        "none",
        "linear",
        "step_left",
        "step_right"
      ],
      "supported_cursor_snap_modes": [
        "free",
        "nearest_sample"
      ],
      "subobject_strategy": "separate_svg_assets_composed_by_shell_slots",
      "fallbacks": {
        "missing_subobject_asset": "host_native_subobject_or_hide_optional_part",
        "missing_plot_layer": "host_native_plot_surface",
        "missing_cursor_layer": "hide_cursor_layer",
        "missing_legend": "hide_legend",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "variants": [
    {
      "id": "frog.realizations.default.waveform_chart.rectangular",
      "variant": "rectangular",
      "target_class": "frog.widgets.waveform_chart",
      "shell_resource_ref": "frog.realizations.default.chart.assets.shell_svg",
      "geometry_posture": {
        "shape_family": "rectangular",
        "layout_source": "front_panel_layout_rectangle",
        "scales_to_layout": true,
        "uses_subobject_slots": true
      },
      "fallback": "host_rectangle_waveform_chart"
    }
  ],

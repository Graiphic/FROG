{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_chart_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.chart",
    "name": "FROG Default Chart Realization",
    "namespace": "frog.realizations.default.chart",
    "family": "default",
    "category": "visual data",
    "role_posture": "indicator",
    "summary": "Machine-readable default realization manifest for the composite waveform chart widget."
  },
  "ownership_boundary": {
    "owns": [
      "default waveform chart realization record",
      "chart realization variant declaration",
      "chart subobject resources",
      "chart subobject slots",
      "chart part bindings",
      "chart state maps",
      "chart property bindings",
      "chart anchors",
      "chart host hints",
      "chart realization validation expectations"
    ],
    "does_not_own": [
      "chart widget class law",
      "chart history semantics",
      "chart plot semantics",
      "chart scale semantics",
      "chart cursor semantics",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private plotting handles",
      "host-native canvas handles",
      "GPU surfaces",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Chart.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.waveform_chart",
      "role": "indicator",
      "primary_value": {
        "present": true,
        "kind": "frog.waveform_chart_value"
      }
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.waveform_chart"
    ],
    "variants": [
      "frog.realizations.default.waveform_chart.rectangular"
    ],
    "resources": [
      "frog.realizations.default.chart.assets.shell_svg",
      "frog.realizations.default.chart.assets.plot_area_svg",
      "frog.realizations.default.chart.assets.grid_svg",

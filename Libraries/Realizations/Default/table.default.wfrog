{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_table_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.table",
    "name": "FROG Default table Realization",
    "namespace": "frog.realizations.default.table",
    "family": "default",
    "category": "structured data",
    "role_posture": "control / indicator",
    "summary": "Machine-readable default realization manifest for standardized table widgets."
  },
  "ownership_boundary": {
    "owns": [
      "default table realization records",
      "table realization resources",
      "table part bindings",
      "table host hints",
      "table validation expectations"
    ],
    "does_not_own": [
      "table widget class law",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private host handles",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Table.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.table_control",
      "role": "control"
    },
    {
      "class_id": "frog.widgets.table_indicator",
      "role": "indicator"
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.table"
    ],
    "resources": [
      "frog.realizations.default.table.assets.shell_svg",
      "frog.realizations.default.table.assets.header_region_svg",
      "frog.realizations.default.table.assets.grid_region_svg",
      "frog.realizations.default.table.assets.cell_svg",
      "frog.realizations.default.table.assets.selection_face_svg",
      "frog.realizations.default.table.assets.vertical_scrollbar_svg",
      "frog.realizations.default.table.assets.horizontal_scrollbar_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.table",
      "family": "default",
      "target_classes": [
        "frog.widgets.table_control",
        "frog.widgets.table_indicator"
      ],
      "supported_parts": [
        "root",
        "label",
        "caption",
        "frame",
        "header_region",
        "grid_region",
        "cell",
        "selection_face",
        "vertical_scrollbar",
        "horizontal_scrollbar",
        "focus_ring"
      ],
      "fallbacks": {
        "missing_resource": "host_native_or_generic_compatible_rendering",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.table.assets.shell_svg",
      "kind": "svg",
      "path": "./assets/table/templates/table_shell.svg",
      "role": "assembly_shell"
    },
    {
      "id": "frog.realizations.default.table.assets.header_region_svg",
      "kind": "svg",
      "path": "./assets/table/subobjects/header_region.svg",
      "target_part": "header_region"
    },
    {
      "id": "frog.realizations.default.table.assets.grid_region_svg",
      "kind": "svg",
      "path": "./assets/table/subobjects/grid_region.svg",
      "target_part": "grid_region"
    },
    {
      "id": "frog.realizations.default.table.assets.cell_svg",
      "kind": "svg",
      "path": "./assets/table/subobjects/cell.svg",
      "target_part": "cell"
    },
    {
      "id": "frog.realizations.default.table.assets.selection_face_svg",
      "kind": "svg",
      "path": "./assets/table/subobjects/selection_face.svg",
      "target_part": "selection_face"
    },
    {
      "id": "frog.realizations.default.table.assets.vertical_scrollbar_svg",
      "kind": "svg",
      "path": "./assets/table/subobjects/vertical_scrollbar.svg",
      "target_part": "vertical_scrollbar"
    },
    {
      "id": "frog.realizations.default.table.assets.horizontal_scrollbar_svg",
      "kind": "svg",
      "path": "./assets/table/subobjects/horizontal_scrollbar.svg",
      "target_part": "horizontal_scrollbar"
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "label",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='label']"
    },
    {
      "part": "caption",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='caption']"
    },
    {
      "part": "frame",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='frame']"
    },
    {
      "part": "header_region",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='header_region']"
    },
    {
      "part": "grid_region",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='grid_region']"
    },
    {
      "part": "cell",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='cell']"
    },
    {
      "part": "selection_face",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='selection_face']"
    },
    {
      "part": "vertical_scrollbar",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='vertical_scrollbar']"
    },
    {
      "part": "horizontal_scrollbar",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='horizontal_scrollbar']"
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='focus_ring']"
    }
  ],
  "property_bindings": [
    {
      "member": "value",
      "target_part": "grid_region",
      "target_operation": "render_table_value"
    },
    {
      "member": "columns.headers",
      "target_part": "header_region",
      "target_operation": "render_headers"
    },
    {
      "member": "selection.*",
      "target_part": "selection_face",
      "target_operation": "render_selection"
    }
  ],
  "state_maps": [
    {
      "state": "normal"
    }
  ],
  "composition": {
    "shell": "frog.realizations.default.table.assets.shell_svg",
    "slots": [
      {
        "slot": "header_region",
        "resource_ref": "frog.realizations.default.table.assets.header_region_svg"
      },
      {
        "slot": "grid_region",
        "resource_ref": "frog.realizations.default.table.assets.grid_region_svg"
      },
      {
        "slot": "vertical_scrollbar",
        "resource_ref": "frog.realizations.default.table.assets.vertical_scrollbar_svg"
      },
      {
        "slot": "horizontal_scrollbar",
        "resource_ref": "frog.realizations.default.table.assets.horizontal_scrollbar_svg"
      }
    ],
    "nested_slots": [
      {
        "parent_part": "grid_region",
        "slot": "cell",
        "resource_ref": "frog.realizations.default.table.assets.cell_svg"
      },
      {
        "parent_part": "grid_region",
        "slot": "selection_face",
        "resource_ref": "frog.realizations.default.table.assets.selection_face_svg"
      }
    ]
  },
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_widget",
    "style_application_posture": "apply_property_bindings_before_render"
  },
  "validation_expectations": [
    "target classes must exist in the referenced widget class-law document",
    "all declared public parts must exist in widget class law",
    "resources must resolve relative to this package file",
    "resources must not become semantic owners of widget value",
    "runtime-private host handles must not be exposed as public widget members"
  ]
}

{
  "format": "frog.wfrog",
  "kind": "widget_realization_library",
  "publication_role": "default_splitter_realization_manifest",
  "version_governance_ref": "../../../Versioning/Readme.md",
  "package": {
    "id": "frog.realizations.default.splitter",
    "name": "FROG Default splitter Realization",
    "namespace": "frog.realizations.default.splitter",
    "family": "default",
    "category": "layout",
    "role_posture": "layout",
    "summary": "Machine-readable default realization manifest for standardized splitter widgets."
  },
  "ownership_boundary": {
    "owns": [
      "default splitter realization records",
      "splitter realization resources",
      "splitter part bindings",
      "splitter host hints",
      "splitter validation expectations"
    ],
    "does_not_own": [
      "splitter widget class law",
      "canonical .frog source",
      "frog.ui primitive semantics",
      "runtime-private host handles",
      "IDE-private editing behavior"
    ],
    "class_law_refs": [
      "../../../Libraries/Widgets/Splitter.md",
      "../../../Libraries/Widgets/Readme.md"
    ],
    "interaction_refs": [
      "../../../Libraries/UI.md",
      "../../../Expression/Widget interaction.md"
    ],
    "package_posture_ref": "./Package.md"
  },
  "targets": [
    {
      "class_id": "frog.widgets.horizontal_splitter",
      "role": "layout"
    },
    {
      "class_id": "frog.widgets.vertical_splitter",
      "role": "layout"
    }
  ],
  "exports": {
    "realizations": [
      "frog.realizations.default.splitter"
    ],
    "resources": [
      "frog.realizations.default.splitter.assets.horizontal_svg",
      "frog.realizations.default.splitter.assets.vertical_svg"
    ]
  },
  "realizations": [
    {
      "id": "frog.realizations.default.splitter",
      "family": "default",
      "target_classes": [
        "frog.widgets.horizontal_splitter",
        "frog.widgets.vertical_splitter"
      ],
      "supported_parts": [
        "root",
        "separator",
        "handle",
        "focus_ring"
      ],
      "fallbacks": {
        "missing_resource": "host_native_or_generic_compatible_rendering",
        "unsupported_style_member": "preserve_semantics_ignore_visual_hint"
      }
    }
  ],
  "resources": [
    {
      "id": "frog.realizations.default.splitter.assets.horizontal_svg",
      "kind": "svg",
      "path": "./assets/splitter/templates/horizontal_splitter.svg",
      "target_class": "frog.widgets.horizontal_splitter"
    },
    {
      "id": "frog.realizations.default.splitter.assets.vertical_svg",
      "kind": "svg",
      "path": "./assets/splitter/templates/vertical_splitter.svg",
      "target_class": "frog.widgets.vertical_splitter"
    }
  ],
  "part_bindings": [
    {
      "part": "root",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='root']"
    },
    {
      "part": "separator",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='separator']"
    },
    {
      "part": "handle",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='handle']"
    },
    {
      "part": "focus_ring",
      "binding_kind": "svg_or_host_surface",
      "binding_selector": "[data-frog-part='focus_ring']"
    }
  ],
  "property_bindings": [
    {
      "member": "position",
      "target_part": "handle",
      "target_operation": "set_splitter_position"
    },
    {
      "member": "style.handle.*",
      "target_part": "handle",
      "target_operation": "apply_handle_style"
    },
    {
      "member": "style.separator.*",
      "target_part": "separator",
      "target_operation": "apply_separator_style"
    }
  ],
  "state_maps": [
    {
      "state": "normal"
    }
  ],
  "composition": null,
  "host_hints": {
    "preferred_host_kind": "svg_template_host_or_host_native_widget",
    "style_application_posture": "apply_property_bindings_before_render"
  },
  "validation_expectations": [
    "target classes must exist in the referenced widget class-law document",
    "all declared public parts must exist in widget class law",
    "resources must resolve relative to this package file",
    "resources must not become semantic owners of widget value",
    "runtime-private host handles must not be exposed as public widget members"
  ]
}

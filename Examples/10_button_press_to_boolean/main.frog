{
  "spec_version": "0.1",
  "metadata": {
    "name": "10_button_press_to_boolean",
    "summary": "Button command press to Boolean indicator roundtrip with .frog-owned Button and Boolean widget instances and Default SVG realization assets.",
    "description": "Reads the pressed state from one .frog front-panel Button command control, exposes that event-derived bool through the public input surface, copies it to one public output, and publishes it to one Boolean indicator. This example intentionally validates the Button widget and its Default Button SVG realization, not the rectangular Boolean value-control realization from Example 06. The .frog source owns the widget instances, layout, bindings, initial values, labels, mechanical-action posture, and per-instance appearance. The .wfrog package owns Default realization references, host requirements, and SVG asset references consumed by the C++ runtime.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "widget_value",
      "button_command",
      "button",
      "boolean",
      "roundtrip",
      "wfrog",
      "widget_realization_package",
      "cpp_first"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "trigger_pressed",
        "type": "bool",
        "binding_origin": "widget.trigger_button.pressed"
      }
    ],
    "outputs": [
      {
        "id": "pressed",
        "type": "bool"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "trigger_button_pressed",
        "kind": "widget_event_value",
        "widget": "trigger_button",
        "event": "pressed",
        "value_type": "bool"
      },
      {
        "id": "pressed_indicator_value",
        "kind": "widget_value",
        "widget": "pressed_indicator"
      },
      {
        "id": "output_pressed",
        "kind": "interface_output",
        "interface_port": "pressed"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "trigger_button_pressed",
          "port": "value"
        },
        "to": {
          "node": "pressed_indicator_value",
          "port": "value"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "trigger_button_pressed",
          "port": "value"
        },
        "to": {
          "node": "output_pressed",
          "port": "value"
        }
      }
    ]
  },
  "front_panel": {
    "canvas": {
      "width": 420,
      "height": 150,
      "coordinate_space": "panel_pixels"
    },
    "package_refs": [
      "./ui/button_panel.wfrog"
    ],
    "widgets": [
      {
        "id": "trigger_button",
        "role": "control",
        "class_ref": "frog.widgets.button",
        "instance_ref": "trigger_button",
        "value_type": "bool",
        "layout": {
          "x": 20,
          "y": 32,
          "width": 160,
          "height": 80
        },
        "props": {
          "value": false,
          "pressed": false,
          "label.text": "Trigger",
          "label.visible": false,
          "caption.text": "Trigger",
          "caption.visible": true,
          "caption.anchor.x": 170,
          "caption.anchor.y": 28,
          "caption.align.horizontal": "center",
          "caption.style.text_color": "#111827",
          "caption.style.font_family": "system-ui, Segoe UI, Arial, sans-serif",
          "caption.style.font_size": "18px",
          "caption.style.font_weight": "600",
          "state_text.false_text": "OFF",
          "state_text.true_text": "ON",
          "state_text.visible": true,
          "state_text.style.text_color.false": "#111827",
          "state_text.style.text_color.true": "#111827",
          "state_text.style.font_size": "18px",
          "state_text.style.font_weight": "400",
          "behavior.mechanical_action": "switch_until_released",
          "style.frame.fill_color": "transparent",
          "style.frame.border_color": "transparent",
          "style.frame.border_width": "0px",
          "style.face.fill_color.false": "#e2e8f0",
          "style.face.fill_color.true": "#e2e8f0",
          "style.face.fill_color.hover_false": "#dbeafe",
          "style.face.fill_color.hover_true": "#dbeafe",
          "style.face.fill_color.pressed_false": "#bfdbfe",
          "style.face.fill_color.pressed_true": "#bfdbfe",
          "style.face.border_color.false": "#334155",
          "style.face.border_color.true": "#334155",
          "style.face.border_width": "1px",
          "style.state_face.fill_color.false": "transparent",
          "style.state_face.fill_color.true": "transparent",
          "style.state_face.fill_color.hover_false": "transparent",
          "style.state_face.fill_color.hover_true": "transparent",
          "style.state_face.fill_color.pressed_false": "transparent",
          "style.state_face.fill_color.pressed_true": "transparent",
          "style.state_face.border_color.false": "transparent",
          "style.state_face.border_color.true": "transparent",
          "style.state_face.border_color.hover_false": "transparent",
          "style.state_face.border_color.hover_true": "transparent",
          "style.state_face.border_color.pressed_false": "transparent",
          "style.state_face.border_color.pressed_true": "transparent",
          "style.state_face.border_width": "0px",
          "style.focus_ring.visible": true,
          "style.focus_ring.color": "#2563eb",
          "style.focus_ring.width": "3px",
          "style.pressed.inset": "2px",
          "style.transition.duration_ms": 120,
          "style.transition.timing": "ease-out",
          "interaction.enabled": true,
          "interaction.read_only": false,
          "realization.variant": "rectangular"
        },
        "visual": {
          "asset_ref": "asset:button_rectangular_svg"
        },
        "binding": {
          "mode": "widget_event_value",
          "event": "pressed",
          "public_input_id": "trigger_pressed"
        }
      },
      {
        "id": "pressed_indicator",
        "role": "indicator",
        "class_ref": "frog.widgets.boolean_indicator",
        "instance_ref": "pressed_indicator",
        "value_type": "bool",
        "layout": {
          "x": 240,
          "y": 32,
          "width": 160,
          "height": 80
        },
        "props": {
          "value": false,
          "label.text": "Pressed",
          "caption.text": "Pressed",
          "caption.align.horizontal": "center",
          "caption.anchor.x": 80,
          "caption.anchor.y": 16,
          "caption.visible": true,
          "caption.style.text_color": "#111827",
          "caption.style.font_family": "system-ui, Segoe UI, Arial, sans-serif",
          "caption.style.font_size": "18px",
          "caption.style.font_weight": "600",
          "state_text.true_text": "TRUE",
          "state_text.false_text": "FALSE",
          "state_text.visible": true,
          "state_text.style.text_color.false": "#111827",
          "state_text.style.text_color.true": "#06381c",
          "state_text.style.font_size": "12px",
          "state_text.style.font_weight": "400",
          "style.outer.border_color.false": "transparent",
          "style.outer.border_color.true": "transparent",
          "style.frame.visible": false,
          "style.inner.left": "60px",
          "style.inner.top": "31px",
          "style.inner.width": "40px",
          "style.inner.height": "40px",
          "style.inner.fill_color.false": "#ef4444",
          "style.inner.fill_color.true": "#22c55e",
          "style.inner.border_color.false": "transparent",
          "style.inner.border_color.true": "transparent",
          "style.inner.border_width": "0px",
          "style.transition.duration_ms": 120,
          "style.transition.timing": "ease-out",
          "interaction.enabled": false,
          "interaction.read_only": true,
          "realization.variant": "circular"
        },
        "visual": {
          "asset_ref": "asset:boolean_circular_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_output_id": "pressed"
        }
      }
    ],
    "panel_id": "main_panel",
    "title": "Button Press to Boolean",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "reference_host_default"
  }
}

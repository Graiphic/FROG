    "svg": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<svg id=\"Calque_1\" xmlns=\"http://www.w3.org/2000/svg\" version=\"1.1\" viewBox=\"0 0 48 48\" data-frog-shape-standard=\"square\">\n  <defs>\n    <style>\n      .st0, .st1, .st2 {\n        isolation: isolate;\n      }\n\n      .st1 {\n        font-size: 22px;\n      }\n\n      .st1, .st2 {\n        fill: #f8fafc;\n        font-family: SegoeUI-Bold, 'Segoe UI';\n        font-weight: 700;\n      }\n\n      .st3 {\n        fill: #4b5563;\n        stroke: #aab4c0;\n        stroke-linecap: round;\n        stroke-linejoin: round;\n        stroke-width: 1.8px;\n      }\n\n      .st2 {\n        font-size: 13px;\n      }\n    </style>\n  </defs>\n  <rect x=\"1\" y=\"1\" width=\"46\" height=\"46\" rx=\"4.5\" fill=\"#4B5563\" stroke=\"#AAB4C0\" stroke-width=\"1.8\" /><g transform=\"matrix(1.148325 0 0 1.148325 -3.559809 -3.559809) translate(3.1 3.1)\" data-frog-body-glyph-profile=\"square-v1\">\n  <g class=\"st0\">\n    <text class=\"st1\" transform=\"translate(5.24 26.9)\"><tspan x=\"0\" y=\"0\">÷</tspan></text>\n  </g>\n  <g class=\"st0\">\n    <text class=\"st2\" transform=\"translate(25.96 17.9)\"><tspan x=\"0\" y=\"0\">R</tspan></text>\n  </g>\n  <g class=\"st0\">\n    <text class=\"st2\" transform=\"translate(22.33 34.9)\"><tspan x=\"0\" y=\"0\">IQ</tspan></text>\n  </g>\n</g></svg>\n"

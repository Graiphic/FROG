it private Simulation; not a compiled-native claim.\u000aExpected:\u000aoutput-quotient (i32) = -2\u000aoutput-remainder (i32) = -3\u000a","documentation_uri":"","name":"Quotient & Remainder — signed x7 yneg3","name_source":"document","program_version":"0.0.0.0","tags":["numeric-math","typed-values","independent-oracle","explicit-private-simulation","example"]},"storage":{"array_mode":"automatic","version":1},"title":"Quotient & Remainder — signed x7 yneg3"}

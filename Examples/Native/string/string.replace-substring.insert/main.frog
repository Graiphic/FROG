  "icon": {
    "svg": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg id=\"Calque_1\" xmlns=\"http://www.w3.org/2000/svg\" version=\"1.1\" viewBox=\"0 0 48 48\">\n  <title>Remplacer une portion de chaîne</title>\n<defs>\n    <style>\n      .st0 {\n        fill: #4b5563;\n        stroke: #aab4c0;\n        stroke-width: 1.8px;\n      }\n\n      .st1, .st2 {\n        stroke-width: 2.3px;\n      }\n\n      .st1, .st2, .st3, .st4 {\n        fill: none;\n        stroke-linecap: round;\n        stroke-linejoin: round;\n      }\n\n      .st1, .st4 {\n        stroke: #f8fafc;\n      }\n\n      .st2, .st3 {\n        stroke: #f017f0;\n      }\n\n      .st3, .st4 {\n        stroke-width: 2px;\n      }\n\n      .st5, .st6 {\n        isolation: isolate;\n      }\n\n      .st6 {\n        fill: #f8fafc;\n        font-family: Arial-BoldMT, Arial;\n        font-size: 11px;\n        font-weight: 700;\n      }\n    </style>\n  </defs>\n  <rect class=\"st0\" x=\"1\" y=\"1\" width=\"46\" height=\"46\" rx=\"4.5\" ry=\"4.5\"/>\n  <line class=\"st1\" x1=\"27.39\" y1=\"8.34\" x2=\"42.24\" y2=\"8.34\"/>\n  <line class=\"st1\" x1=\"27.39\" y1=\"14\" x2=\"42.24\" y2=\"14\"/>\n  <g class=\"st5\">\n    <text class=\"st6\" transform=\"translate(5.08 16.68)\"><tspan x=\"0\" y=\"0\">abc</tspan></text>\n  </g>\n  <line class=\"st1\" x1=\"6.58\" y1=\"21.17\" x2=\"33.31\" y2=\"21.17\"/>\n  <line class=\"st3\" x1=\"6.58\" y1=\"41.43\" x2=\"42.68\" y2=\"41.43\"/>\n  <g>\n    <line class=\"st4\" x1=\"24.63\" y1=\"36.35\" x2=\"24.63\" y2=\"27.42\"/>\n    <path class=\"st4\" d=\"M22.03,30.21l2.6-3.9,2.6,3.9\"/>\n  </g>\n  <line class=\"st2\" x1=\"32.93\" y1=\"35.35\" x2=\"42.68\" y2=\"35.35\"/>\n</svg>\n"

  "icon": {
    "svg": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg id=\"Calque_2\" data-name=\"Calque 2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 47.8 47.8\">\n  <defs>\n    <style>\n      .cls-1 {\n        stroke-width: 1.5px;\n      }\n\n      .cls-1, .cls-2 {\n        fill: none;\n      }\n\n      .cls-1, .cls-2, .cls-3 {\n        stroke-miterlimit: 10;\n      }\n\n      .cls-1, .cls-4, .cls-5 {\n        stroke: #aab4c0;\n      }\n\n      .cls-2, .cls-3 {\n        stroke: #fff;\n      }\n\n      .cls-4, .cls-3 {\n        fill: #4b5563;\n      }\n\n      .cls-4, .cls-5 {\n        stroke-width: 1.8px;\n      }\n\n      .cls-6 {\n        fill: #fff;\n        font-family: SourceSansPro-Bold, 'Source Sans Pro';\n        font-size: 14px;\n        font-weight: 700;\n      }\n\n      .cls-3 {\n        stroke-width: 1.06px;\n      }\n\n      .cls-5 {\n        fill: #aab4c0;\n      }\n    </style>\n  </defs>\n  <g id=\"Calque_1-2\" data-name=\"Calque 1\">\n    <g>\n      <g>\n        <rect class=\"cls-4\" x=\".9\" y=\".9\" width=\"46\" height=\"46\" rx=\"4.5\" ry=\"4.5\"/>\n        <path class=\"cls-5\" d=\"M5.88,1.21h12.03v17.01H.9V6.19C.9,3.44,3.13,1.21,5.88,1.21Z\"/>\n        <text class=\"cls-6\" transform=\"translate(6.58 13.87)\"><tspan x=\"0\" y=\"0\">∑</tspan></text>\n      </g>\n      <line class=\"cls-1\" x1=\"7.94\" y1=\"43.71\" x2=\"7.94\" y2=\"21.44\"/>\n      <line class=\"cls-2\" x1=\"7.94\" y1=\"40.42\" x2=\"39.45\" y2=\"16.66\"/>\n      <line class=\"cls-1\" x1=\"43.75\" y1=\"40.42\" x2=\"4.05\" y2=\"40.42\"/>\n      <path class=\"cls-3\" d=\"M35.17,28.98l-11.99,6.93s.46-3.63-2.06-7.17-4.87-4.83-4.87-4.83l11.99-6.93s3.12,2.12,5.32,5.51c2.2,3.38,1.6,6.49,1.6,6.49Z\"/>\n      <path class=\"cls-3\" d=\"M39.38,28.98l-11.99,6.93s.46-3.63-2.06-7.17-4.87-4.83-4.87-4.83l11.99-6.93s3.12,2.12,5.32,5.51c2.2,3.38,1.6,6.49,1.6,6.49Z\"/>\n    </g>\n  </g>\n</svg>"

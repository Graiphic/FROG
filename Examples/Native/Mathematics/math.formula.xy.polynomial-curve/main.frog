  "icon": {
    "svg": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg id=\"Calque_2\" data-name=\"Calque 2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 47.8 47.8\">\n  <defs>\n    <style>\n      .cls-1 {\n        fill: #00bc85;\n      }\n\n      .cls-2 {\n        stroke-linecap: round;\n        stroke-linejoin: round;\n        stroke-width: .75px;\n      }\n\n      .cls-2, .cls-3, .cls-4 {\n        stroke: #aab4c0;\n      }\n\n      .cls-2, .cls-4 {\n        fill: #aab4c0;\n      }\n\n      .cls-5 {\n        fill: none;\n        stroke: #fff;\n        stroke-miterlimit: 10;\n      }\n\n      .cls-3 {\n        fill: #4b5563;\n      }\n\n      .cls-3, .cls-4 {\n        stroke-width: 1.8px;\n      }\n\n      .cls-6 {\n        fill: #fff;\n        font-family: SourceSansPro-Bold, 'Source Sans Pro';\n        font-size: 14px;\n        font-weight: 700;\n      }\n\n      .cls-7 {\n        fill: #f8fafc;\n      }\n    </style>\n  </defs>\n  <g id=\"Calque_1-2\" data-name=\"Calque 1\">\n    <g>\n      <g>\n        <rect class=\"cls-3\" x=\".9\" y=\".9\" width=\"46\" height=\"46\" rx=\"4.5\" ry=\"4.5\"/>\n        <path class=\"cls-4\" d=\"M5.88,1.21h12.03v17.01H.9V6.19C.9,3.44,3.13,1.21,5.88,1.21Z\"/>\n        <text class=\"cls-6\" transform=\"translate(6.58 13.87)\"><tspan x=\"0\" y=\"0\">∑</tspan></text>\n      </g>\n      <g>\n        <g>\n          <rect class=\"cls-2\" x=\"7.38\" y=\"30.67\" width=\"32.23\" height=\".56\"/>\n          <polygon class=\"cls-2\" points=\"36.91 34.64 40.04 30.9 40.22 30.69 40.04 30.48 36.91 26.74 36.25 27.17 39.19 30.69 36.25 34.21 36.91 34.64\"/>\n        </g>\n        <g>\n          <rect class=\"cls-2\" x=\"23.47\" y=\"15.08\" width=\".56\" height=\"29.34\"/>\n          <polygon class=\"cls-2\" points=\"27.7 17.51 23.96 14.38 23.75 14.21 23.53 14.38 19.8 17.51 20.23 18.18 23.75 15.24 27.27 18.18 27.7 17.51\"/>\n        </g>\n      </g>\n      <g>\n        <path class=\"cls-1\" d=\"M30.72,21.15c-.92,0-1.67-.75-1.67-1.67s.75-1.67,1.67-1.67,1
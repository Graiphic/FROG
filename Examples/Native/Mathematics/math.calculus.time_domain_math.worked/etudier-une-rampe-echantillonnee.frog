  "title": "Édition uniquement — Étudier une rampe échantillonnée",
  "metadata": {
    "name": "Édition uniquement — Étudier une rampe échantillonnée",
    "name_source": "document",
    "description": "Quatre échantillons d’une rampe, espacés de 0,25 s, permettent d’examiner le signal en entrée et en sortie. Montage éditable avec des données d’exercice. La sauvegarde et la réouverture sont vérifiées. Le Run de ce scénario reste non qualifié.",
    "author": "",
    "automatic_versioning": false,
    "program_version": "0.0.0.0",

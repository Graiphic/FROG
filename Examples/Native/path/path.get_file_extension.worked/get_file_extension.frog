  "title": "Get File Extension",
  "metadata": {
    "name": "Get File Extension",
    "name_source": "document",
    "description": "With file = \"notes.TXT\", error_in = {\"status\": false, \"code\": 0, \"source\": \"\"}, Run displays lowercase_extension = \"txt\", unmodified_extension = \"TXT\", error_out = {\"status\": false, \"code\": 0, \"source\": \"\"}.\n\nWith file = \"notes.TXT\", error_in = {\"status\": false, \"code\": 0, \"source\": \"\"}, Run displays lowercase_extension = \"txt\", unmodified_extension = \"TXT\", error_out = {\"status\": false, \"code\": 0, \"source\": \"\"}.\n\nMode: execution. Profile: studio-draft. Capability: studio.native.composed@1.\nExpected:\nlowercase_extension (string) = \"txt\"\nunmodified_extension (string) = \"TXT\"\nerror_out (cluster<\"status\":bool,\"code\":i32,\"source\":string>) = {\"code\":0,\"source\":\"\",\"status\":false}\n",
    "author": "",
    "automatic_versioning": false,
    "program_version": "0.0.0.0",

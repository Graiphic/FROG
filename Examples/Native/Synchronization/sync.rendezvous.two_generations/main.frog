  "language": "FROG",
  "title": "Rendezvous : trois participants, deux générations",
  "metadata": {
    "name": "Rendezvous : trois participants, deux générations",
    "name_source": "document",
    "description": "Run this document. Each of three independent branches crosses generation 1, then generation 2 on the same reference. Cleanup waits for all second-generation outcomes. The scheduler may choose any branch first; this model does not manufacture a prescribed timing gap between participants.\n\nRendezvous : trois participants, deux générations\n\nMode: execution. Profile: studio-draft. Capability: windows-x64/structured-program.\nExpected:\ntimed_out_0_0 (bool) = false\ntimed_out_0_1 (bool) = false\ntimed_out_1_0 (bool) = false\ntimed_out_1_1 (bool) = false\ntimed_out_2_0 (bool) = false\ntimed_out_2_1 (bool) = false\n",
    "author": "",
    "automatic_versioning": false,
    "program_version": "0.0.0.0",
    "tags": ["native", "typed", "resources", "example"],
    "documentation_uri": ""
  },
  "host": {
    "version": 1,
    "launch": {
      "trigger": "manual"
    },

  "icon": {
    "svg": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<svg id=\"Calque_2\" data-name=\"Calque 2\" xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 47.8 47.8\">\n  <defs>\n    <style>\n      .cls-1 {\n        stroke: #aab4c0;\n        stroke-width: 1.8px;\n      }\n\n      .cls-1, .cls-2 {\n        fill: #4b5563;\n      }\n\n      .cls-3 {\n        fill: #fffffe;\n        stroke-width: .86px;\n      }\n\n      .cls-3, .cls-2 {\n        stroke: #f8fafc;\n        stroke-linecap: round;\n        stroke-linejoin: round;\n      }\n\n      .cls-4 {\n        fill: #f8fafc;\n      }\n\n      .cls-2 {\n        stroke-width: 1.3px;\n      }\n    </style>\n  </defs>\n  <g id=\"Calque_1-2\" data-name=\"Calque 1\">\n    <g>\n      <rect class=\"cls-1\" x=\".9\" y=\".9\" width=\"46\" height=\"46\" rx=\"4.5\" ry=\"4.5\"/>\n      <g>\n        <rect class=\"cls-3\" x=\"23.09\" y=\"19.62\" width=\".82\" height=\"30.8\" transform=\"translate(-11.52 58.52) rotate(-90)\"/>\n        <polygon class=\"cls-3\" points=\"36.45 39.44 39.53 35.26 39.7 35.02 39.53 34.78 36.45 30.6 35.8 31.08 38.69 35.02 35.8 38.96 36.45 39.44\"/>\n      </g>\n      <rect class=\"cls-2\" x=\"14.99\" y=\"28.16\" width=\"5.71\" height=\"12.47\"/>\n      <rect class=\"cls-2\" x=\"20.7\" y=\"28.16\" width=\"5.71\" height=\"12.47\"/>\n      <rect class=\"cls-2\" x=\"26.41\" y=\"28.16\" width=\"5.71\" height=\"12.47\"/>\n      <path class=\"cls-4\" d=\"M12.72,21.47l-1.1-4.86-3.74,2.18c-.4.25-.87-.21-.61-.61l2.18-3.74-4.86-1.1c-.46-.1-.46-.76,0-.87l4.86-1.1-2.19-3.75c-.25-.4.21-.87.61-.61l3.75,2.19,1.1-4.86c.1-.46.76-.46.87,0l1.1,4.86,3.75-2.18c.4-.25.87.21.61.61l-2.18,3.75,4.86,1.1c.46.1.46.76,0,.87l-4.86,1.1,2.18,3.74c.25.4-.21.87-.61.61l-3.74-2.18-1.1,4.86c-.1.46-.76.46-.87,0Z\"/>\n    </g>\n  </g>\n</svg>"

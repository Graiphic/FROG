      {
        "id": "example-explanation",
        "kind": "comment",
        "comment_auto_size": false,
        "text": "Rendezvous : erreur standard et exception de destruction\nRendezvous : erreur standard et exception de destruction\nEntrées -> opération -> indicateurs. Résultat attendu : timed_out (bool) = true\nsize (i32) = 2\nwaiting (i32) = 0\nerror_status (bool) = true\nerror_code (i32) = 77\n",
        "vertical_arrangement": "none",
        "font": {
          "family": "",
          "style": "plain",
          "use_default_size": false,
          "geometry_initialized": false,

        "props": {
          "label.text": "Behavior explanation",
          "text.value": "Behavior Explanation\nA Label is front-panel support text. Its visible content is text.value, while position and styling live on the .frog widget instance.\n\nThe Default Label SVG publishes background, frame, text_surface, and focus_ring parts.",
          "text.visible": true,
          "text.multiline": true,
          "text.wrap_enabled": true,
          "text.horizontal_alignment": "left",
          "text.vertical_alignment": "top",
          "text.padding": "14px",

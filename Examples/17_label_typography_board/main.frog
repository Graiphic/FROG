{
  "spec_version": "0.1",
  "metadata": {
    "name": "17_label_typography_board",
    "summary": "Standalone static Label support widgets rendered from .frog instance text and Default Label .wfrog realization assets.",
    "description": "Places several standalone Label widgets on the front panel as title text, section text, annotations, and typography samples. Label text, position, color, font choices, wrapping, alignment, and placement_bounds are source-owned by .frog instances. The Default Label SVG stays minimal and publishes only root, placement_bounds, and text_surface.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "review": {
      "last_reviewed": "2026-06-25",
      "review_scope": "Static Label simplification, placement_bounds aura, minimal text_surface SVG contract, and C++ browser-host rendering."
    },
    "tags": [
      "example",
      "ui",
      "label",
      "support_widget",
      "typography",
      "annotation",
      "static_text",
      "placement_bounds",
      "placement_aura",
      "ide_view",
      "wfrog",
      "widget_realization_package",
      "post_public_runtime_boundary"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "scene_ready_request",
        "type": "bool",
        "default": true,
        "binding_origin": "runtime.host_scene_request"
      }
    ],
    "outputs": [
      {
        "id": "scene_ready",
        "type": "bool"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "scene_ready_request",
        "kind": "interface_input",
        "interface_port": "scene_ready_request"
      },
      {
        "id": "output_scene_ready",
        "kind": "interface_output",
        "interface_port": "scene_ready"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "scene_ready_request",
          "port": "value"
        },
        "to": {
          "node": "output_scene_ready",
          "port": "value"
        }
      }
    ]
  },
  "front_panel": {
    "canvas": {
      "width": 760,
      "height": 470,
      "coordinate_space": "panel_pixels",
      "presentation_mode": "ide_view",
      "selected_widget_id": "behavior_explanation",
      "grid": {
        "visible": true,
        "pitch": 16,
        "origin": {
          "x": 0,
          "y": 0
        },
        "snap": "placement_bounds"
      },
      "ide.style.aura.selected.border_color": "#00ADEF",
      "ide.style.aura.selected.fill_color": "rgba(14,165,233,0.025)",
      "ide.style.aura.selected.border_width": "1px",
      "ide.style.aura.hover.border_color": "rgba(0,173,239,0.42)",
      "ide.style.aura.hover.fill_color": "rgba(14,165,233,0.012)",
      "ide.style.aura.hover.border_width": "2px"
    },
    "package_refs": [
      "./ui/label_panel.wfrog"
    ],
    "widgets": [
      {
        "id": "board_title",
        "role": "support",
        "class_ref": "frog.widgets.label",
        "instance_ref": "board_title",
        "layout": {
          "x": 24,
          "y": 18,
          "width": 600,
          "height": 54
        },
        "props": {
          "label.text": "Board title",
          "text.value": "FROG Label Typography Board",
          "text.visible": true,
          "text.multiline": false,
          "text.wrap_enabled": false,
          "text.horizontal_alignment": "left",
          "text.vertical_alignment": "middle",
          "text.padding": "0px",
          "text.clip_overflow": true,
          "style.text.color": "#111827",
          "style.text.font_family": "Segoe UI, Arial, sans-serif",
          "style.text.font_size": "28px",
          "style.text.font_weight": "700",
          "style.text.font_style": "normal",
          "style.text.text_decoration": "none",
          "interaction.visible": true,
          "interaction.enabled": false,
          "interaction.read_only": true,
          "realization.variant": "rectangular"
        },
        "visual": {
          "asset_ref": "asset:label_rectangular_svg"
        },
        "binding": {
          "mode": "support_text"
        }
      },

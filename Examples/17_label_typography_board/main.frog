{
  "spec_version": "0.1",
  "metadata": {
    "name": "17_label_typography_board",
    "summary": "Standalone Label support widgets rendered from .frog instance typography and Default Label .wfrog realization assets.",
    "description": "Places several standalone Label widgets on the front panel as title text, section text, LabVIEW-like explanation rectangles, and small annotations. Label text, position, colors, frames, font choices, wrapping, and alignment are source-owned by .frog instances. The .wfrog package references the Default Label realization and SVG asset. Runtime implementation for this post-boundary example continues in Graiphic/FROG-Runtime unless explicitly promoted later.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "label",
      "support_widget",
      "typography",
      "annotation",
      "wfrog",
      "widget_realization_package",
      "post_public_runtime_boundary"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "scene_ready_request",
        "type": "bool",
        "default": true,
        "binding_origin": "runtime.host_scene_request"
      }
    ],
    "outputs": [
      {
        "id": "scene_ready",
        "type": "bool"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "scene_ready_request",
        "kind": "interface_input",
        "interface_port": "scene_ready_request"
      },
      {
        "id": "output_scene_ready",
        "kind": "interface_output",
        "interface_port": "scene_ready"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "scene_ready_request",
          "port": "value"
        },
        "to": {
          "node": "output_scene_ready",
          "port": "value"
        }
      }
    ]
  },
  "front_panel": {
    "canvas": {
      "width": 760,
      "height": 470,
      "coordinate_space": "panel_pixels"
    },
    "package_refs": [
      "./ui/label_panel.wfrog"
    ],
    "widgets": [
      {
        "id": "board_title",
        "role": "support",
        "class_ref": "frog.widgets.label",
        "instance_ref": "board_title",
        "layout": {
          "x": 24,
          "y": 18,
          "width": 600,
          "height": 54
        },
        "props": {
          "label.text": "Board title",
          "text.value": "FROG Label Typography Board",
          "text.visible": true,
          "text.multiline": false,
          "text.wrap_enabled": false,
          "text.horizontal_alignment": "left",
          "text.vertical_alignment": "middle",
          "text.padding": "0px",
          "text.clip_overflow": true,
          "style.text.color": "#111827",
          "style.text.font_family": "Segoe UI, Arial, sans-serif",
          "style.text.font_size": "28px",
          "style.text.font_weight": "700",
          "style.text.font_style": "normal",
          "style.text.text_decoration": "none",
          "style.background.visible": false,
          "style.background.fill_color": "transparent",
          "style.frame.visible": false,
          "style.frame.border_color": "transparent",
          "style.frame.border_width": "0px",
          "style.frame.corner_radius": "0px",
          "interaction.visible": true,
          "interaction.enabled": false,
          "interaction.read_only": true,
          "realization.variant": "rectangular"
        },
        "visual": {
          "asset_ref": "asset:label_rectangular_svg"
        },
        "binding": {
          "mode": "support_text"
        }
      },

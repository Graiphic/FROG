{
  "spec_version": "0.1",
  "metadata": {
    "name": "08_enum_value_roundtrip",
    "summary": "Mode enum control-to-indicator value roundtrip using a .frog front-panel instance and Default Enum .wfrog realization assets.",
    "description": "Reads one enum item value from a Mode enum control, exposes that value through the public input surface, copies it to one public output, and publishes it to one enum indicator. The first reference closure is C++ and consumes the .frog front-panel instance, Default Enum .wfrog realization assets/defaults, and an LLVM-produced native enum kernel through an explicit manifest.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "review": {
      "last_reviewed": "2026-06-06",
      "scope": "Example 08 Enum closed selector skin, optional increment/decrement command parts, dropdown list SVG skin, and C++ browser-host rendering.",
      "visible_runtime_fact": "Reviewed 2026-06-06"
    },
    "tags": [
      "example",
      "ui",
      "widget_value",
      "enum",
      "mode",
      "roundtrip",
      "wfrog",
      "widget_realization_package"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "mode_value",
        "type": "enum_item_id",
        "enum_domain": "example08.mode",
        "binding_origin": "widget.mode_input.value"
      }
    ],
    "outputs": [
      {
        "id": "result_mode",
        "type": "enum_item_id",
        "enum_domain": "example08.mode"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "mode_input_value",
        "kind": "widget_value",
        "widget": "mode_input"
      },
      {
        "id": "mode_result_value",
        "kind": "widget_value",
        "widget": "mode_result"
      },
      {
        "id": "output_result_mode",
        "kind": "interface_output",
        "interface_port": "result_mode"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "mode_input_value",
          "port": "value"
        },
        "to": {
          "node": "mode_result_value",
          "port": "value"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "mode_input_value",
          "port": "value"
        },
        "to": {
          "node": "output_result_mode",
          "port": "value"
        }
      }
    ]
  },
  "front_panel": {
    "canvas": {
      "width": 620,
      "height": 180,
      "coordinate_space": "panel_pixels"
    },
    "package_refs": [
      "./ui/enum_panel.wfrog"
    ],
    "widgets": [
      {
        "id": "mode_input",
        "role": "control",
        "class_ref": "frog.widgets.enum_control",
        "instance_ref": "mode_input",
        "value_type": "enum_item_id",
        "layout": {
          "x": 20,
          "y": 0,
          "width": 260,
          "height": 110
        },
        "props": {
          "value": "run",
          "enum.domain_id": "example08.mode",
          "label.text": "Mode",
          "caption.text": "Mode input",
          "caption.visible": true,
          "caption.anchor.x": 22,
          "caption.anchor.y": 68,
          "caption.align.horizontal": "left",
          "caption.style.text_color": "#111827",
          "caption.style.font_family": "system-ui, Segoe UI, Arial, sans-serif",
          "caption.style.font_size": "14px",
          "caption.style.font_weight": "600",
          "items": [
            {
              "id": "idle",
              "text": "Idle",
              "numeric_value": 0,
              "enabled": true
            },
            {
              "id": "run",
              "text": "Run",
              "numeric_value": 1,
              "enabled": true
            },
            {
              "id": "fault",
              "text": "Fault",
              "numeric_value": 2,
              "enabled": true
            }
          ],
          "display.selector_visible": true,
          "display.increment_buttons_visible": true,
          "data_entry.increment_wrap": false,
          "style.scale.reference_width": 260,
          "style.scale.reference_height": 110,
          "style.value_face.fill_color": "#ffffff",
          "style.value_face.fill_color.hover": "#eef6ff",
          "style.value_face.border_color": "#64748b",
          "style.value_face.border_color.hover": "#64748b",
          "style.value_face.border_width": "1px",
          "style.value_display.color": "#111827",
          "style.value_display.font_size": "16px",
          "style.value_display.font_size_mode": "scale_with_widget",
          "style.value_display.font_weight": "400",
          "style.value_display.vertical_offset": "-2px",
          "style.value_display.vertical_offset_mode": "scale_with_widget",
          "style.value_display.padding_inline": "8px",
          "style.value_display.padding_inline_mode": "scale_with_widget",
          "style.selector_face.fill_color": "#f1f5f9",
          "style.selector_face.fill_color.hover": "#60a5fa",
          "style.selector_face.border_color": "#64748b",
          "style.selector_face.border_color.hover": "#2563eb",
          "style.selector_face.border_width": "1px",
          "style.selector_face.border_width_mode": "scale_with_widget",
          "style.selector_face.border_radius": "1px",
          "style.selector_face.border_radius_mode": "scale_with_widget",
          "style.selector_face.symbol_color": "#111827",
          "style.selector_face.symbol_color.hover": "#ffffff",
          "style.selector_face.symbol_width": "10px",
          "style.selector_face.symbol_height": "7px",
          "style.selector_face.symbol_size_mode": "scale_with_widget",
          "style.increment_button.fill_color.normal": "#edf2f7",
          "style.increment_button.fill_color.hover": "#dbeafe",
          "style.increment_button.fill_color.pressed": "#bfdbfe",
          "style.increment_button.border_color.normal": "#94a3b8",
          "style.increment_button.border_color.hover": "#64748b",
          "style.increment_button.border_color.pressed": "#2563eb",
          "style.increment_button.symbol_color.normal": "#334e68",
          "style.increment_button.symbol_color.hover": "#1d4ed8",
          "style.increment_button.symbol_color.pressed": "#1e40af",
          "style.dropdown.fill_color": "#ffffff",
          "style.dropdown.border_color": "#64748b",
          "style.dropdown.border_width": "1px",
          "style.dropdown.border_width_mode": "scale_with_widget",
          "style.dropdown.option.fill_color": "#ffffff",
          "style.dropdown.option.text_color": "#111827",
          "style.dropdown.option.hover_fill_color": "#dbeafe",
          "style.dropdown.option.hover_text_color": "#111827",
          "style.dropdown.option.selected_fill_color": "#3b6db5",
          "style.dropdown.option.selected_text_color": "#ffffff",
          "style.dropdown.option.font_family": "Segoe UI,Arial,sans-serif",
          "style.dropdown.option.font_size": "14px",
          "style.dropdown.option.font_size_mode": "scale_with_widget",
          "style.dropdown.option.font_weight": "400",
          "style.dropdown.option.font_style": "normal",
          "style.dropdown.option.padding_inline": "7px",
          "style.dropdown.option.padding_inline_mode": "scale_with_widget",
          "style.dropdown.option.height": "24px",
          "style.dropdown.option.height_mode": "scale_with_widget",
          "interaction.enabled": true,
          "interaction.read_only": false,
          "realization.variant": "rectangular_ring"
        },
        "visual": {
          "asset_ref": "asset:enum_rectangular_ring_svg",
          "popup_asset_ref": "asset:enum_dropdown_list_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_input_id": "mode_value"
        }
      },
      {
        "id": "mode_result",
        "role": "indicator",
        "class_ref": "frog.widgets.enum_indicator",
        "instance_ref": "mode_result",
        "value_type": "enum_item_id",
        "layout": {
          "x": 340,
          "y": 0,
          "width": 260,
          "height": 110
        },
        "props": {
          "value": "run",
          "enum.domain_id": "example08.mode",
          "label.text": "Mode result",
          "caption.text": "Mode result",
          "caption.visible": true,
          "caption.anchor.x": 22,
          "caption.anchor.y": 68,
          "caption.align.horizontal": "left",
          "caption.style.text_color": "#111827",
          "caption.style.font_family": "system-ui, Segoe UI, Arial, sans-serif",
          "caption.style.font_size": "14px",
          "caption.style.font_weight": "600",
          "items": [
            {
              "id": "idle",
              "text": "Idle",
              "numeric_value": 0,
              "enabled": true
            },
            {
              "id": "run",
              "text": "Run",
              "numeric_value": 1,
              "enabled": true
            },
            {
              "id": "fault",
              "text": "Fault",
              "numeric_value": 2,
              "enabled": true
            }
          ],
          "display.selector_visible": false,
          "style.scale.reference_width": 260,
          "style.scale.reference_height": 110,
          "style.value_face.fill_color": "#f8fafc",
          "style.value_face.border_color": "#64748b",
          "style.value_face.border_width": "1px",
          "style.value_display.color": "#111827",
          "style.value_display.font_size": "16px",
          "style.value_display.font_size_mode": "scale_with_widget",
          "style.value_display.font_weight": "400",
          "style.value_display.vertical_offset": "-2px",
          "style.value_display.vertical_offset_mode": "scale_with_widget",
          "style.value_display.padding_inline": "8px",
          "style.value_display.padding_inline_mode": "scale_with_widget",
          "style.selector_face.fill_color": "transparent",
          "style.selector_face.border_color": "transparent",
          "style.selector_face.border_width": "0px",
          "style.selector_face.symbol_color": "transparent",
          "interaction.enabled": false,
          "interaction.read_only": true,
          "realization.variant": "rectangular_ring"
        },
        "visual": {
          "asset_ref": "asset:enum_rectangular_ring_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_output_id": "result_mode"
        }
      }
    ],
    "panel_id": "main_panel",
    "title": "Enum Mode Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "reference_host_default"
  }
}

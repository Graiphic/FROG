  },
  "ownership_boundary": {
    "owns": [
      "example-local Enum widget realization references",
      "example-local Default Enum SVG asset references",
      "example-local host binding requirements for the reference browser host"
    ],
    "does_not_own": [
      "canonical source semantics",
      "front-panel widget instance layout",
      "front-panel widget instance visual customization",
      "Enum item vocabulary",
      "FIR semantics",
      "lowering semantics",
      "runtime-private execution behavior",
      "widget class law"
    ]
  },
  "widget_classes": [
    {
      "class_id": "frog.widgets.enum_control",
      "role": "control",
      "value_type": "enum_item_id"
    },
    {
      "class_id": "frog.widgets.enum_indicator",
      "role": "indicator",
      "value_type": "enum_item_id"
    }
  ],
  "host_bindings": [
    {
      "binding_id": "reference_host_default",
      "host_family": "reference_browser_host",
      "target": "reference_browser_host",
      "required_capabilities": [
        "window",
        "basic_widget_rendering",
        "widget_value_binding"
      ]
    }
  ],
  "realization_refs": [
    {
      "package_ref": "Libraries/Realizations/Default/enum.default.wfrog",
      "target_classes": [
        "frog.widgets.enum_control",
        "frog.widgets.enum_indicator"
      ]
    }
  ],
  "svg_assets": [
    {
      "asset_id": "enum_rectangular_ring_svg",
      "kind": "svg",
      "path": "../../../Libraries/Realizations/Default/assets/enum/templates/enum_rectangular_ring.svg",
      "target_classes": [
        "frog.widgets.enum_control",
        "frog.widgets.enum_indicator"
      ]
    }
  ]
}

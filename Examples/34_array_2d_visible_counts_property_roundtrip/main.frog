    "panel_id": "main_panel",
    "title": "Array 2D Visible Counts Property Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "array_runtime_host_default",
    "documentation": {
      "title": "Array 2D Visible Counts Property Roundtrip",
      "summary": "Reviewed 2026-06-08. Two Numeric U8 controls write the visible row and visible column counts of a two-dimensional Array through explicit diagram property nodes. The Array remains a widget container whose visible cells instantiate Default Numeric widgets.",
      "sections": [
        {
          "title": "Visible-count properties",
          "body": "Execute consumes Visible rows and Visible columns, then writes numeric_array.viewport.visible_counts[0]/[1] and published_array.viewport.visible_counts[0]/[1]."
        },
        {
          "title": "Numeric element",
          "body": "Each visible cell instantiates a Numeric element template. Control cells keep increment/decrement buttons; indicator cells are read-only and visually greyed."
        },
        {
          "title": "Execute",
          "body": "Execute consumes the selected Numeric element value through the native manifest corridor and publishes the value and matrix records to the read-only Array indicator."
        }
      ]
    }
  }
}

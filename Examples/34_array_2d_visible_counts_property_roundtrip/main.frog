{
  "spec_version": "0.1",
  "metadata": {
    "name": "34_array_2d_visible_counts_property_roundtrip",
    "summary": "2D Array container visible row/column count property roundtrip using two Numeric U8 controls and Default Array cells that instantiate Default Numeric element widgets.",
    "description": "Places two Numeric U8 controls, one two-dimensional Array control, and one read-only Array indicator on the front panel. Execute consumes the Numeric U8 row and column values through explicit diagram property-write nodes that update Array viewport.visible_counts[0] and viewport.visible_counts[1]. The Array owns rank, shape, viewport, index displays, scrolling, and materialization. Each visible cell is a contained Numeric widget whose per-cell editing/display behavior comes from the Default Numeric realization. The .frog source owns property nodes, element class binding, element default value, cell sizing, labels, bindings, initial values, and instance-level visual overrides. The .wfrog package references Default Array and Default Numeric realization assets.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "array",
      "array_control",
      "array_indicator",
      "rank_2",
      "selected_element",
      "roundtrip",
      "wfrog",
      "widget_realization_package",
      "post_public_runtime_boundary",
      "array_container",
      "numeric_element_template",
      "default_numeric_realization",
      "widget_container",
      "two_dimensional_array",
      "property_node",
      "visible_counts",
      "visible_row_count",
      "visible_column_count",
      "numeric_u8_controls"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "element_value",
        "type": "u16",

{
  "format": "frog.wfrog",
  "kind": "front_panel_package",
  "package_id": "example05.accumulator_panel",
  "title": "Bounded UI Accumulator",
  "artifact_governance_ref": {
    "path": "Versioning/Readme.md"
  },
  "source_ref": {
    "example_id": "05_bounded_ui_accumulator",
    "source_path": "Examples/05_bounded_ui_accumulator/main.frog",
    "fir_path": "Examples/05_bounded_ui_accumulator/main.fir.json",
    "lowering_path": "Examples/05_bounded_ui_accumulator/main.lowering.json"
  },
  "ownership_boundary": {
    "owns": [
      "example-local front-panel package identity",
      "example-local widget realization references",
      "example-local widget initial presentation properties",
      "example-local SVG asset references"
    ],
    "does_not_own": [
      "canonical source semantics",
      "FIR semantics",
      "lowering semantics",
      "backend contract semantics",
      "runtime-private execution behavior",
      "widget class law"
    ]
  },
  "widget_classes": [
    {
      "class_id": "frog.widgets.numeric_control",
      "role": "control",
      "value_type": "u16"
    },
    {
      "class_id": "frog.widgets.numeric_indicator",
      "role": "indicator",
      "value_type": "u16"
    }
  ],
  "host_bindings": [
    {
      "binding_id": "reference_host_default",
      "host_family": "reference_browser_host",
      "target": "reference_browser_host",
      "required_capabilities": [
        "window",
        "basic_widget_rendering",
        "property_write",
        "widget_value_binding",
        "widget_reference_binding"
      ]
    }
  ],
  "realization_refs": [
    {
      "package_ref": "Libraries/Realizations/Default/numeric.default.wfrog",
      "target_classes": [
        "frog.widgets.numeric_control",
        "frog.widgets.numeric_indicator"
      ]
    }
  ],
  "svg_assets": [
    {
      "asset_id": "numeric_rectangular_svg",
      "kind": "svg",
      "path": "../../../Libraries/Realizations/Default/assets/numeric/templates/numeric_rectangular.svg",
      "target_classes": [
        "frog.widgets.numeric_control",
        "frog.widgets.numeric_indicator"
      ]
    }
  ],
  "front_panels": [
    {
      "panel_id": "main_panel",
      "title": "Bounded UI Accumulator",
      "class_ref": "frog.widgets.panel",
      "host_binding_ref": "reference_host_default",
      "layout": {
        "width": 500,
        "height": 170,
        "coordinate_space": "panel_pixels"
      },
      "widgets": [
        {
          "instance_id": "ctrl_input",
          "class_ref": "frog.widgets.numeric_control",
          "role": "control",
          "value_type": "u16",
          "layout": {
            "x": 20,
            "y": 24,
            "width": 220,
            "height": 88
          },
          "props": {
            "value": 3,
            "label": "Input",
            "caption.text": "Input",
            "caption.visible": true,
            "caption.anchor.x": 22,
            "caption.anchor.y": 68,
            "caption.align.horizontal": "left",
            "representation.kind": "uint16",
            "data_entry.minimum": 0,
            "data_entry.maximum": 65535,
            "data_entry.increment_step": 1,
            "display.increment_buttons_visible": true,
            "display.radix_visible": false,
            "unit_label.visible": false,
            "style.caption.font_weight": "400",
            "style.frame.border_color": "transparent",
            "style.increment_button.fill_color.normal": "#5B9BD5",
            "style.increment_button.fill_color.pressed": "#2B4F7B",
            "style.increment_button.border_color.normal": "#2B4F7B",
            "style.increment_button.border_color.pressed": "#17324F",
            "style.increment_button.symbol_color.normal": "#FFFFFF",
            "style.increment_button.symbol_color.pressed": "#FFFFFF",
            "label_color": "#111827",
            "visible": true,
            "enabled": true,
            "foreground_color": "#D8D8D8"
          },
          "visual": {
            "asset_ref": "asset:numeric_rectangular_svg"
          },
          "binding": {
            "mode": "widget_value",
            "public_input_id": "input_value",
            "widget_reference": true,
            "supported_members": [
              "foreground_color"
            ]
          }
        },
        {
          "instance_id": "ind_result",
          "class_ref": "frog.widgets.numeric_indicator",
          "role": "indicator",
          "value_type": "u16",
          "layout": {
            "x": 260,
            "y": 24,
            "width": 220,
            "height": 88
          },
          "props": {
            "value": 0,
            "label": "Accumulated result",
            "caption.text": "Accumulated result",
            "caption.visible": true,
            "caption.anchor.x": 22,
            "caption.anchor.y": 68,
            "caption.align.horizontal": "left",
            "representation.kind": "uint16",
            "display.increment_buttons_visible": false,
            "display.radix_visible": false,
            "unit_label.visible": false,
            "style.caption.font_weight": "400",
            "style.frame.border_color": "transparent",
            "label_color": "#111827",
            "visible": true,
            "enabled": true,
            "foreground_color": "#D8D8D8"
          },
          "visual": {
            "asset_ref": "asset:numeric_rectangular_svg"
          },
          "binding": {
            "mode": "widget_value",
            "public_output_id": "result",
            "widget_reference": true,
            "supported_members": [
              "foreground_color"
            ]
          }
        }
      ]
    }
  ]
}

{
  "format": "frog.wfrog",
  "kind": "front_panel_package",
  "package_id": "example05.accumulator_panel",
  "title": "Bounded UI Accumulator",
  "artifact_governance_ref": {
    "path": "Versioning/Readme.md"
  },
  "source_ref": {
    "example_id": "05_bounded_ui_accumulator",
    "source_path": "Examples/05_bounded_ui_accumulator/main.frog",
    "fir_path": "Examples/05_bounded_ui_accumulator/main.fir.json",
    "lowering_path": "Examples/05_bounded_ui_accumulator/main.lowering.json"
  },
  "ownership_boundary": {
    "owns": [
      "example-local front-panel package identity",
      "example-local widget realization references",
      "example-local widget initial presentation properties",
      "example-local SVG asset references"
    ],
    "does_not_own": [
      "canonical source semantics",
      "FIR semantics",
      "lowering semantics",
      "backend contract semantics",
      "runtime-private execution behavior",
      "widget class law"
    ]
  },
  "widget_classes": [
    {
      "class_id": "frog.widgets.numeric_control",
      "role": "control",
      "value_type": "u16"
    },
    {
      "class_id": "frog.widgets.numeric_indicator",
      "role": "indicator",
      "value_type": "u16"
    }
  ],
  "host_bindings": [
    {
      "binding_id": "reference_host_default",
      "host_family": "reference_browser_host",
      "required_capabilities": [
        "window",
        "basic_widget_rendering",
        "property_write",
        "widget_value_binding",
        "widget_reference_binding"
      ]
    }
  ],
  "svg_assets": [
    {
      "asset_id": "numeric_control_svg",
      "path": "assets/numeric_control.svg",
      "target_class": "frog.widgets.numeric_control"
    },
    {
      "asset_id": "numeric_indicator_svg",
      "path": "assets/numeric_indicator.svg",
      "target_class": "frog.widgets.numeric_indicator"
    }
  ],
  "front_panels": [
    {
      "panel_id": "main_panel",
      "title": "Bounded UI Accumulator",
      "class_ref": "frog.widgets.panel",
      "layout": {
        "width": 460,
        "height": 170,
        "coordinate_space": "panel_pixels"
      },
      "widgets": [
        {
          "instance_id": "ctrl_input",
          "class_ref": "frog.widgets.numeric_control",
          "role": "control",
          "value_type": "u16",
          "layout": {
            "x": 20,
            "y": 24,
            "width": 140,
            "height": 32
          },
          "props": {
            "value": 3,
            "label": "Input",
            "visible": true,
            "enabled": true,
            "foreground_color": "#D8D8D8"
          },
          "visual": {
            "asset_ref": "asset:numeric_control_svg"
          },
          "binding": {
            "mode": "widget_value",
            "public_input_id": "input_value",
            "widget_reference": true,
            "supported_members": [
              "foreground_color"
            ]
          }
        },
        {
          "instance_id": "ind_result",
          "class_ref": "frog.widgets.numeric_indicator",
          "role": "indicator",
          "value_type": "u16",
          "layout": {
            "x": 240,
            "y": 24,
            "width": 160,
            "height": 32
          },
          "props": {
            "value": 0,
            "label": "Accumulated result",
            "visible": true,
            "enabled": true,
            "foreground_color": "#D8D8D8"
          },
          "visual": {
            "asset_ref": "asset:numeric_indicator_svg"
          },
          "binding": {
            "mode": "widget_value",
            "public_output_id": "result",
            "widget_reference": true,
            "supported_members": [
              "foreground_color"
            ]
          }
        }
      ]
    }
  ]
}

{
  "format": "frog.ui.panel",
  "kind": "panel_definition",
  "panel_id": "example05.accumulator_panel",
  "title": "Bounded UI Accumulator",
  "widgets": [
    {
      "id": "input_value",
      "class_id": "frog.widgets.numeric_control",
      "layout": {
        "x": 24,
        "y": 24,
        "width": 220,
        "height": 56
      },
      "properties": {
        "label.text": "input_value",
        "label.visible": false,
        "caption.text": "Input",
        "caption.visible": true,
        "value": 3,
        "representation.kind": "int32",
        "data_entry.minimum": 0,
        "data_entry.maximum": 100,
        "data_entry.increment_step": 1,
        "data_entry.coerce_on_commit": true,
        "display.format_kind": "decimal",
        "display.increment_buttons_visible": true,
        "display.radix_visible": false,
        "unit_label.visible": false,
        "style.frame.border_width": 2,
        "style.frame.border_color": "#000000",
        "style.value_face.fill_color": "#5b9bd5",
        "style.text_value.color": "#000000"
      }
    },
    {
      "id": "result_value",
      "class_id": "frog.widgets.numeric_indicator",
      "layout": {
        "x": 24,
        "y": 104,
        "width": 220,
        "height": 56
      },
      "properties": {
        "label.text": "result_value",
        "label.visible": false,
        "caption.text": "Result",
        "caption.visible": true,
        "value": 15,
        "representation.kind": "int32",
        "display.format_kind": "decimal",
        "display.radix_visible": false,
        "unit_label.visible": false,
        "style.frame.border_width": 2,
        "style.frame.border_color": "#000000",
        "style.value_face.fill_color": "#90d26d",
        "style.text_value.color": "#000000"
      }
    }
  ]
}

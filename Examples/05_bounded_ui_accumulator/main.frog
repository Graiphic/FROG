{
  "spec_version": "0.1",
  "metadata": {
    "name": "05_bounded_ui_accumulator",
    "summary": "Bounded front-panel accumulation example with .frog-owned numeric widget instances and Default Numeric .wfrog realization assets.",
    "description": "Reads one u16 numeric control value from the .frog front panel, exposes that value through the example public input surface, executes a bounded loop of exactly five iterations, carries explicit state through frog.core.delay initialized to 0, and writes the final accumulated value both to one public output and to one u16 numeric indicator. The .frog source owns program meaning, front-panel widget instances, layout, binding, and per-instance appearance. The .wfrog package owns the published Default Numeric widget realization, host requirements, and SVG asset references consumed by the runtimes.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "widget_value",
      "widget_reference",
      "bounded_loop",
      "state",
      "delay",
      "accumulator",
      "vertical_slice",
      "u16",
      "property_write",
      "foreground_color",
      "wfrog",
      "widget_realization_package"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "input_value",
        "type": "u16",
        "binding_origin": "widget.ctrl_input.value"
      }
    ],
    "outputs": [
      {
        "id": "result",
        "type": "u16"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "ctrl_input_value",
        "kind": "widget_value",
        "widget": "ctrl_input"
      },
      {
        "id": "ctrl_input_ref",
        "kind": "widget_reference",
        "widget": "ctrl_input"
      },
      {
        "id": "ind_result_ref",
        "kind": "widget_reference",
        "widget": "ind_result"
      },
      {
        "id": "const_zero",
        "kind": "constant",
        "type": "u16",
        "value": 0
      },
      {
        "id": "const_five",
        "kind": "constant",
        "type": "i32",
        "value": 5
      },
      {
        "id": "const_ctrl_foreground_color",
        "kind": "constant",
        "type": "frog.color.rgba8",
        "value": "#5B9BD5"
      },
      {
        "id": "const_ind_foreground_color",
        "kind": "constant",
        "type": "frog.color.rgba8",
        "value": "#70AD47"
      },
      {
        "id": "write_ctrl_foreground_color",
        "kind": "primitive",
        "type": "frog.ui.property_write",
        "widget_member": {
          "member": "foreground_color"
        }
      },
      {
        "id": "write_ind_foreground_color",
        "kind": "primitive",
        "type": "frog.ui.property_write",
        "widget_member": {
          "member": "foreground_color"
        }
      },
      {
        "id": "loop_accumulate",
        "kind": "for_loop",
        "count_from": {
          "node": "const_five",
          "port": "value"
        },
        "region": {
          "nodes": [
            {
              "id": "delay_state",
              "kind": "primitive",
              "type": "frog.core.delay"
            },
            {
              "id": "add_step",
              "kind": "primitive",
              "type": "frog.core.add"
            }
          ],
          "edges": [
            {
              "id": "r_e1",
              "from": {
                "node": "loop_input_value",
                "port": "value"
              },
              "to": {
                "node": "add_step",
                "port": "a"
              }
            },
            {
              "id": "r_e2",
              "from": {
                "node": "delay_state",
                "port": "out"
              },
              "to": {
                "node": "add_step",
                "port": "b"
              }
            },
            {
              "id": "r_e3",
              "from": {
                "node": "add_step",
                "port": "result"
              },
              "to": {
                "node": "delay_state",
                "port": "in"
              }
            },
            {
              "id": "r_e4",
              "from": {
                "node": "loop_initial_state",
                "port": "value"
              },
              "to": {
                "node": "delay_state",
                "port": "initial"
              }
            }
          ],
          "inputs": [
            {
              "id": "loop_input_value",
              "type": "u16"
            },
            {
              "id": "loop_initial_state",
              "type": "u16"
            }
          ],
          "outputs": [
            {
              "id": "loop_final_state",
              "from": {
                "node": "add_step",
                "port": "result"
              },
              "type": "u16"
            }
          ]
        }
      },
      {
        "id": "ind_result_value",
        "kind": "widget_value",
        "widget": "ind_result"
      },
      {
        "id": "output_result",
        "kind": "interface_output",
        "interface_port": "result"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "ctrl_input_value",
          "port": "value"
        },
        "to": {
          "node": "loop_accumulate",
          "port": "loop_input_value"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "const_zero",
          "port": "value"
        },
        "to": {
          "node": "loop_accumulate",
          "port": "loop_initial_state"
        }
      },
      {
        "id": "e3",
        "from": {
          "node": "loop_accumulate",
          "port": "loop_final_state"
        },
        "to": {
          "node": "ind_result_value",
          "port": "value"
        }
      },
      {
        "id": "e4",
        "from": {
          "node": "loop_accumulate",
          "port": "loop_final_state"
        },
        "to": {
          "node": "output_result",
          "port": "value"
        }
      },
      {
        "id": "e5",
        "from": {
          "node": "ctrl_input_ref",
          "port": "ref"
        },
        "to": {
          "node": "write_ctrl_foreground_color",
          "port": "ref"
        }
      },
      {
        "id": "e6",
        "from": {
          "node": "const_ctrl_foreground_color",
          "port": "value"
        },
        "to": {
          "node": "write_ctrl_foreground_color",
          "port": "value"
        }
      },
      {
        "id": "e7",
        "from": {
          "node": "ind_result_ref",
          "port": "ref"
        },
        "to": {
          "node": "write_ind_foreground_color",
          "port": "ref"
        }
      },
      {
        "id": "e8",
        "from": {
          "node": "const_ind_foreground_color",
          "port": "value"
        },
        "to": {
          "node": "write_ind_foreground_color",
          "port": "value"
        }
      }
    ]
  },
  "front_panel": {
    "canvas": {
      "width": 500,
      "height": 170,
      "coordinate_space": "panel_pixels"
    },
    "package_refs": [
      "./ui/accumulator_panel.wfrog"
    ],
    "widgets": [
      {
        "id": "ctrl_input",
        "role": "control",
        "class_ref": "frog.widgets.numeric_control",
        "instance_ref": "ctrl_input",
        "value_type": "u16",
        "layout": {
          "x": 20,
          "y": 24,
          "width": 220,
          "height": 88
        },
        "props": {
          "value": 3,
          "label": "Input",
          "caption.text": "Input",
          "caption.visible": true,
          "caption.anchor.x": 22,
          "caption.anchor.y": 68,
          "caption.align.horizontal": "left",
          "representation.kind": "uint16",
          "data_entry.minimum": 0,
          "data_entry.maximum": 65535,
          "data_entry.increment_step": 1,
          "display.increment_buttons_visible": true,
          "display.radix_visible": false,
          "unit_label.visible": false,
          "style.caption.text_color": "#111827",
          "style.caption.font_family": "system-ui, Segoe UI, Arial, sans-serif",
          "style.caption.font_size": "12px",
          "style.caption.font_weight": "400",
          "style.text_value.color": "#111827",
          "style.text_value.font_family": "Consolas, Segoe UI Mono, monospace",
          "style.text_value.font_size": "11px",
          "style.text_value.font_weight": "700",
          "style.frame.border_color": "transparent",
          "style.increment_button.fill_color.normal": "#5B9BD5",
          "style.increment_button.fill_color.pressed": "#2B4F7B",
          "style.increment_button.border_color.normal": "#2B4F7B",
          "style.increment_button.border_color.pressed": "#17324F",
          "style.increment_button.symbol_color.normal": "#FFFFFF",
          "style.increment_button.symbol_color.pressed": "#FFFFFF",
          "label_color": "#111827",
          "visible": true,
          "enabled": true,
          "foreground_color": "#D8D8D8"
        },
        "parts": {
          "root": {},
          "label": {},
          "value_display": {}
        },
        "visual": {
          "asset_ref": "asset:numeric_rectangular_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_input_id": "input_value",
          "widget_reference": true,
          "supported_members": [
            "foreground_color"
          ]
        }
      },
      {
        "id": "ind_result",
        "role": "indicator",
        "class_ref": "frog.widgets.numeric_indicator",
        "instance_ref": "ind_result",
        "value_type": "u16",
        "layout": {
          "x": 260,
          "y": 24,
          "width": 220,
          "height": 88
        },
        "props": {
          "value": 0,
          "label": "Accumulated result",
          "caption.text": "Accumulated result",
          "caption.visible": true,
          "caption.anchor.x": 22,
          "caption.anchor.y": 68,
          "caption.align.horizontal": "left",
          "representation.kind": "uint16",
          "display.increment_buttons_visible": false,
          "display.radix_visible": false,
          "unit_label.visible": false,
          "style.caption.text_color": "#111827",
          "style.caption.font_family": "system-ui, Segoe UI, Arial, sans-serif",
          "style.caption.font_size": "12px",
          "style.caption.font_weight": "400",
          "style.text_value.color": "#111827",
          "style.text_value.font_family": "Consolas, Segoe UI Mono, monospace",
          "style.text_value.font_size": "11px",
          "style.text_value.font_weight": "700",
          "style.frame.border_color": "transparent",
          "label_color": "#111827",
          "visible": true,
          "enabled": true,
          "foreground_color": "#D8D8D8"
        },
        "parts": {
          "root": {},
          "label": {},
          "value_display": {}
        },
        "visual": {
          "asset_ref": "asset:numeric_rectangular_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_output_id": "result",
          "widget_reference": true,
          "supported_members": [
            "foreground_color"
          ]
        }
      }
    ],
    "panel_id": "main_panel",
    "title": "Bounded UI Accumulator",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "reference_host_default"
  }
}

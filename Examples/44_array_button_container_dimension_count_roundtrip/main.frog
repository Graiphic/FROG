    ],
    "panel_id": "main_panel",
    "title": "Button Array Dimension Count Property Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "array_runtime_host_default",
    "documentation": {
      "title": "Button Array Dimension Count Property Roundtrip",
      "summary": "A Numeric U8 control writes Array dimensions.rank and index_display.rank while two Numeric U8 controls continue to write visible row and column counts. The Array adapts as an N-dimensional widget and each visible cell instantiates a Default Button widget.",
      "sections": [
        {
          "title": "Dimension property",
          "body": "Execute consumes Dimensions, then writes button_array.dimensions.rank / published_array.dimensions.rank and their index_display.rank mirrors."
        },
        {
          "title": "Visible-count properties",
          "body": "Execute consumes Visible rows and Visible columns, then writes button_array.viewport.visible_counts[0]/[1] and published_array.viewport.visible_counts[0]/[1]."
        },
        {
          "title": "Button element",
          "body": "Each visible cell instantiates a Button element template. Control cells toggle true/false directly; indicator cells are read-only and visually greyed."
        },
        {
          "title": "Execute",
          "body": "Execute consumes the selected Button element value through the native manifest corridor and publishes the value and matrix records to the read-only Array indicator."
        }
      ]
    }
  }
}

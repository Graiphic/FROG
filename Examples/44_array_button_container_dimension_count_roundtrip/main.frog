          "value_type": "frog.array<bool,rank=N>",
          "dimensions.default_element_value": false,
          "dimensions.materialize_out_of_range_edits": true,
          "viewport.orientation": "matrix",
          "element.template_ref": "frog.realizations.default.button",
          "element.asset_ref": "asset:button_rectangular_svg",
          "element.default_value": false,
          "element.cell_width": 148,
          "element.cell_height": 56,
          "element.layout.fit_part": "placement_bounds",
          "element.layout.boundary_policy": "contained_widget_placement_bounds",
          "element.props.caption.visible": false,
          "element.props.label.visible": false,
          "element.props.interaction.read_only": true,
          "element.props.behavior.mechanical_action": "switch_when_pressed",
          "element.props.style.pressed.inset": "0px",
          "element.props.style.pressed.apply_when_value_true": true,
          "element.props.style.pressed.apply_while_active": false,
          "element.props.style.hover.apply_when_value_false_only": false,
          "dimensions.rank_profile.1.shape": [
            30
          ],
          "dimensions.rank_profile.2.shape": [
            5,
            6
          ],
          "dimensions.rank_profile.3.shape": [
            1,
            5,
            6
          ],
          "dimensions.rank_profile.default.leading_extent": 1,
          "dimensions.rank_profile.default.trailing_shape": [
            5,
            6
          ],
          "dimensions.rank_profile.default.vector_length": 30,
          "dimensions.rank_command.source": "widget.dimension_count.value",
          "dimensions.rank_command.domain": "u8_positive_rank_N",
          "dimensions.rank_command.max_rank": 255,
          "dimensions.rank_command.default_shape_policy": "leading_singletons_preserve_last_two_axes",
          "dimensions.rank_command.value_projection": "row_major_preserve_existing_values_then_default",
          "element.props.interaction.enabled": false,
          "element.props.style.text.color": "#111827",
          "element.props.style.text.font_size": "13px",
          "element.props.style.text.font_weight": "400",
          "element.props.state_text.visible": true,
          "element.props.state_text.true_text": "ON",
          "element.props.state_text.false_text": "OFF",
          "element.props.state_text.style.font_size": "13px",
          "element.props.state_text.style.font_weight": "600",
          "element.props.realization.variant": "rectangular",
          "element.props.style.focus_ring.visible": false,
          "element.props.style.button_face.border_width": "1px",

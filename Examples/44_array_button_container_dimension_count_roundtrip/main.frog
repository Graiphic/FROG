{
  "spec_version": "0.1",
  "metadata": {
    "name": "44_array_button_container_dimension_count_roundtrip",
    "summary": "Button Array dynamic dimension-count property roundtrip using Default Button cells, one Numeric U8 dimension control, and two Numeric U8 visible row/column controls.",
    "description": "Places Numeric U8 controls for dimensions and visible row/column counts around an Array control and Array indicator whose contained element widget is the Default rectangular Button. Execute consumes the selected Button cell through the native Boolean manifest corridor, while dimensions.rank, index_display.rank, and viewport.visible_counts keep the same N-dimensional behavior validated by the Numeric Array example.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "review": {
      "last_reviewed": "2026-06-17",
      "reviewer": "Codex + Graiphic",
      "visible_runtime_fact": "Reviewed 2026-06-17"
    },

{
  "spec_version": "0.1",
  "metadata": {
    "name": "13_button_latch_when_pressed",
    "summary": "Button latch-when-pressed value to Boolean indicator roundtrip with .frog-owned Button and Boolean widget instances and Default SVG realization assets.",
    "description": "Reads the stored value from one .frog front-panel Button control using latch_when_pressed mechanical action, exposes that bool through the public input surface, copies it to one public output, and publishes it to one read-only Boolean indicator. This example validates one bounded Button mechanical action across the C++, Python, and Rust reference runtime source surfaces and does not generalize every Button behavior. The .frog source owns the widget instances, layout, bindings, initial values, labels, mechanical-action posture, and per-instance appearance. The .wfrog package owns Default realization references, host requirements, and SVG asset references consumed by the reference runtimes.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "review": {
      "last_reviewed": "2026-06-16",
      "scope": "Default Button semantic button_face SVG contract, Boolean state_face indicator vocabulary, and C++ browser-host rendering for this bounded Button mechanical-action example",
      "visible_runtime_fact": "Reviewed 2026-06-16",
      "public_posture": "Review evidence is public; Graiphic runtime implementation code remains outside the public publication scope."
    },    "tags": [
      "example",
      "ui",
      "widget_value",
      "button_control",
      "button",
      "boolean",
      "latch_when_pressed",
      "roundtrip",
      "wfrog",
      "widget_realization_package",
      "cpp_runtime_validation"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "trigger_value",
        "type": "bool",
        "binding_origin": "widget.trigger_button.value"
      }
    ],
    "outputs": [
      {
        "id": "latched",
        "type": "bool"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "trigger_button_value",
        "kind": "widget_value",
        "widget": "trigger_button",
        "value_type": "bool"
      },
      {
        "id": "latched_indicator_value",
        "kind": "widget_value",
        "widget": "latched_indicator"
      },
      {
        "id": "output_latched",
        "kind": "interface_output",
        "interface_port": "latched"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "trigger_button_value",
          "port": "value"
        },
        "to": {
          "node": "latched_indicator_value",
          "port": "value"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "trigger_button_value",
          "port": "value"
        },
        "to": {
          "node": "output_latched",
          "port": "value"
        }
      }
    ]
  },
  "front_panel": {
    "canvas": {
      "width": 420,
      "height": 150,
      "coordinate_space": "panel_pixels"
    },
    "package_refs": [
      "./ui/button_panel.wfrog"
    ],
    "widgets": [
      {
        "id": "trigger_button",
        "role": "control",
        "class_ref": "frog.widgets.button",
        "instance_ref": "trigger_button",
        "value_type": "bool",
        "layout": {
          "x": 20,
          "y": 32,
          "width": 160,
          "height": 80
        },
        "props": {
          "value": false,
          "pressed": false,
          "label.text": "Trigger",
          "label.visible": false,
          "caption.text": "Trigger",
          "caption.visible": true,
          "caption.anchor.x": 170,
          "caption.anchor.y": 28,
          "caption.align.horizontal": "center",
          "caption.style.text_color": "#111827",
          "caption.style.font_family": "system-ui, Segoe UI, Arial, sans-serif",
          "caption.style.font_size": "18px",
          "caption.style.font_weight": "600",
          "state_text.false_text": "OFF",
          "state_text.true_text": "ON",
          "state_text.visible": true,
          "state_text.style.text_color.false": "#111827",
          "state_text.style.text_color.true": "#111827",
          "state_text.style.font_size": "18px",
          "state_text.style.font_weight": "400",
          "behavior.mechanical_action": "latch_when_pressed",
          "behavior.latch_reset_policy": "reset_on_natural_value_consumption",
          "behavior.output_pulse.duration_ms": 220,
          "style.frame.fill_color": "transparent",
          "style.frame.border_color": "transparent",
          "style.frame.border_width": "0px",
          "style.button_face.fill_color.false": "#e2e8f0",
          "style.button_face.fill_color.true": "#cbd5e1",
          "style.button_face.fill_color.hover_false": "#f1f5f9",
          "style.button_face.fill_color.hover_true": "#dbeafe",
          "style.button_face.fill_color.pressed_false": "#e2e8f0",
          "style.button_face.fill_color.pressed_true": "#cbd5e1",
          "style.button_face.border_color.false": "#334155",
          "style.button_face.border_color.true": "#334155",
          "style.button_face.border_width": "1px",
          "style.pressed.inset": "0px",
          "style.pressed.apply_when_value_true": true,
          "style.pressed.apply_while_active": false,
          "style.hover.apply_when_value_false_only": false,
          "style.transition.duration_ms": 120,
          "style.transition.timing": "ease-out",
          "interaction.enabled": true,
          "interaction.read_only": false,
          "realization.variant": "rectangular"
        },
        "visual": {
          "asset_ref": "asset:button_rectangular_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_input_id": "trigger_value"
        }
      },
      {
        "id": "latched_indicator",

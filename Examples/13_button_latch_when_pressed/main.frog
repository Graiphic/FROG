          "state_text.style.font_weight": "400",
          "style.outer.border_color.false": "transparent",
          "style.outer.border_color.true": "transparent",
          "style.frame.visible": false,
          "style.state_face.left": "60px",
          "style.state_face.top": "31px",
          "style.state_face.width": "40px",

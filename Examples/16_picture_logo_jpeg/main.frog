{
  "spec_version": "0.1",
  "metadata": {
    "name": "16_picture_logo_jpeg",
    "summary": "Picture indicator display driven by a Path control, the standard frog.image.decode_file_rgba8 primitive, and the Default Path/Picture .wfrog realization assets.",
    "description": "Reads an image path from a .frog-owned Path control, decodes the selected PNG/JPEG/BMP image through the standard frog.image.decode_file_rgba8 primitive, publishes the decoded RGBA8 image buffer to a read-only Picture indicator, and exposes decode status through public outputs. The initial path points to the FROG logo asset. This example remains repository-visible public specification and widget material beyond the current public reference runtime closure; runtime implementation continues in Graiphic/FROG-Runtime unless explicitly promoted later.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "widget_value",
      "path",
      "picture",
      "picture_indicator",
      "image",
      "jpeg",
      "png",
      "frog.image",
      "wfrog",
      "widget_realization_package",
      "post_public_runtime_boundary"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "image_path",
        "type": "path",
        "binding_origin": "widget.image_path.value"
      }
    ],
    "outputs": [
      {
        "id": "preview_image",
        "type": "frog.image.buffer_rgba8"
      },
      {
        "id": "decode_success",
        "type": "bool"
      },
      {
        "id": "decode_error_code",
        "type": "string"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "image_path_value",
        "kind": "widget_value",
        "widget": "image_path"
      },
      {
        "id": "decode_image",
        "kind": "primitive",
        "type": "frog.image.decode_file_rgba8"
      },
      {
        "id": "preview_picture_value",
        "kind": "widget_value",
        "widget": "preview_picture"
      },
      {
        "id": "output_preview_image",
        "kind": "interface_output",
        "interface_port": "preview_image"
      },
      {
        "id": "output_decode_success",
        "kind": "interface_output",
        "interface_port": "decode_success"
      },
      {
        "id": "output_decode_error_code",
        "kind": "interface_output",
        "interface_port": "decode_error_code"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "image_path_value",
          "port": "value"
        },
        "to": {
          "node": "decode_image",
          "port": "path"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "decode_image",
          "port": "image"
        },
        "to": {
          "node": "preview_picture_value",
          "port": "value"
        }
      },
      {
        "id": "e3",
        "from": {
          "node": "decode_image",
          "port": "image"
        },
        "to": {
          "node": "output_preview_image",
          "port": "value"
        }
      },
      {
        "id": "e4",
        "from": {
          "node": "decode_image",
          "port": "success"
        },
        "to": {
          "node": "output_decode_success",
          "port": "value"
        }
      },
      {
        "id": "e5",
        "from": {
          "node": "decode_image",
          "port": "error_code"
        },
        "to": {
          "node": "output_decode_error_code",
          "port": "value"
        }
      }
    ]
  },
  "front_panel": {
    "canvas": {
      "width": 560,
      "height": 520,
      "coordinate_space": "panel_pixels"
    },
    "package_refs": [
      "./ui/picture_panel.wfrog"
    ],
    "widgets": [
      {
        "id": "image_path",
        "role": "control",
        "class_ref": "frog.widgets.path_control",
        "instance_ref": "image_path",
        "value_type": "path",
        "layout": {
          "x": 20,
          "y": 20,
          "width": 520,
          "height": 90
        },
        "props": {
          "value": "./assets/frog_logo.jpg",
          "path.kind": "file",
          "path.display_value": "./assets/frog_logo.jpg",
          "path.validation_state": "unknown",
          "path.accepted_media_types": [
            "image/png",
            "image/jpeg",
            "image/bmp"
          ],
          "label.text": "Image path",
          "caption.text": "Image path",
          "caption.visible": true,
          "caption.anchor.x": 12.75,
          "caption.anchor.y": 19.09,
          "caption.align.horizontal": "left",
          "caption.style.text_color": "#111827",
          "caption.style.font_family": "system-ui, Segoe UI, Arial, sans-serif",
          "caption.style.font_size": "18px",
          "caption.style.font_weight": "400",
          "display.icon_visible": true,
          "display.validation_marker_visible": false,
          "display.text_overflow_visible": false,
          "browse.enabled": true,
          "browse.button_visible": true,
          "browse.accept": ".png,.jpg,.jpeg,.bmp,image/png,image/jpeg,image/bmp",
          "style.path_face.fill_color": "#ffffff",
          "style.path_face.fill_color.hover": "#eef6ff",
          "style.path_face.border_color": "#000000",
          "style.path_face.border_color.hover": "#000000",
          "style.path_face.border_width": "0.5px",
          "style.path_display.color": "#111827",
          "style.path_display.font_size": "18px",
          "style.path_display.font_weight": "400",
          "style.path_display.padding_inline": "8px",
          "style.path_display.baseline_offset": "0px",
          "style.path_icon.fill_color": "#facc15",
          "style.path_icon.front_fill_color": "#fde68a",
          "style.path_icon.stroke_color": "#b45309",
          "style.path_icon.highlight_color": "#fff7cc",
          "style.browse_button.fill_color": "#ffffff",
          "style.browse_button.fill_color.hover": "#eef4fb",
          "style.browse_button.border_color": "#000000",
          "style.browse_button.border_color.hover": "#000000",
          "style.browse_button.border_width": "0.5px",
          "style.browse_button.text_color": "#111827",
          "style.browse_button.text_font_size": "14px",
          "interaction.enabled": true,
          "interaction.read_only": false,
          "realization.variant": "rectangular_field"
        },
        "visual": {
          "asset_ref": "asset:path_rectangular_field_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_input_id": "image_path"
        }
      },
      {
        "id": "preview_picture",
        "role": "indicator",
        "class_ref": "frog.widgets.picture_indicator",
        "instance_ref": "preview_picture",
        "value_type": "frog.image.buffer_rgba8",
        "layout": {
          "x": 20,
          "y": 130,
          "width": 520,
          "height": 330
        },
        "props": {
          "value": {
            "kind": "image_buffer",
            "pixel_format": "rgba8",
            "width": 0,
            "height": 0,
            "stride_bytes": 0,
            "pixels": [],
            "color_space": "srgb",
            "origin": "top_left"
          },
          "image.source_path": "./assets/frog_logo.jpg",
          "image.pixel_format": "rgba8",
          "image.color_space": "srgb",
          "image.origin": "top_left",
          "label.text": "Preview",
          "label.visible": false,
          "caption.text": "Preview",
          "caption.visible": true,
          "caption.anchor.x": 260,
          "caption.anchor.y": 28,
          "caption.align.horizontal": "center",
          "caption.style.text_color": "#111827",
          "caption.style.font_family": "system-ui, Segoe UI, Arial, sans-serif",
          "caption.style.font_size": "16px",
          "caption.style.font_weight": "600",
          "viewport.origin.x": 0,
          "viewport.origin.y": 0,
          "viewport.scale": 1,
          "viewport.fit_mode": "fit",
          "display.preserve_aspect_ratio": true,
          "display.interpolation": "linear",
          "display.background_color": "#f8fafc",
          "display.empty_state_visible": true,
          "overlay.visible": false,
          "roi.visible": false,
          "crosshair.visible": false,
          "cursor_readout.visible": false,
          "style.frame.fill_color": "transparent",
          "style.frame.border_color": "transparent",
          "style.frame.border_width": "0px",
          "style.picture_region.fill_color": "#f8fafc",
          "style.picture_region.border_color": "#cbd5e1",
          "style.picture_region.border_width": "1px",
          "style.focus_ring.visible": true,
          "style.focus_ring.color": "#2563eb",
          "style.focus_ring.width": "3px",
          "interaction.enabled": false,
          "interaction.read_only": true,
          "realization.variant": "rectangular"
        },
        "visual": {
          "asset_ref": "asset:picture_rectangular_svg"
        },
        "binding": {
          "mode": "decoded_image_value",
          "source_primitive_id": "decode_image",
          "public_output_id": "preview_image"
        }
      }
    ],
    "panel_id": "main_panel",
    "title": "Picture Path Image Preview",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "picture_path_runtime_host_default"
  }
}

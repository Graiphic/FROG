{
  "format": "frog.wfrog",
  "kind": "widget_realization_package",
  "package_id": "example16.picture_panel",
  "title": "Example 16 Default Picture realization package",
  "artifact_governance_ref": {
    "path": "Versioning/Readme.md"
  },
  "source_ref": {
    "example_id": "16_picture_logo_jpeg",
    "source_path": "Examples/16_picture_logo_jpeg/main.frog",
    "fir_path": "Examples/16_picture_logo_jpeg/main.fir.json",
    "lowering_path": "Examples/16_picture_logo_jpeg/main.lowering.json"
  },
  "ownership_boundary": {
    "owns": [
      "Default Picture realization references",
      "Default Picture SVG asset references",
      "host binding requirements for Picture runtime validation"
    ],
    "does_not_own": [
      "canonical source semantics",
      "front-panel widget instance layout",
      "front-panel widget instance visual customization",
      "Picture value payload",
      "JPEG source image path",
      "FIR semantics",
      "lowering semantics",
      "runtime-private execution behavior",
      "widget class law",
      "Default Picture SVG geometry"
    ]
  },
  "widget_classes": [
    {
      "class_id": "frog.widgets.picture_indicator",
      "role": "indicator",
      "value_type": "picture"
    }
  ],
  "host_bindings": [
    {
      "binding_id": "picture_runtime_host_default",
      "host_family": "frog_conforming_picture_runtime_host",
      "target": "frog_conforming_picture_runtime_host",
      "required_capabilities": [
        "window",
        "basic_widget_rendering",
        "widget_value_binding",
        "encoded_image_payload_loading",
        "picture_viewport_fit",
        "svg_part_overlay_alignment",
        "svg_style_property_binding"
      ]
    }
  ],
  "realization_refs": [
    {
      "package_ref": "Libraries/Realizations/Default/picture.default.wfrog",
      "target_classes": [
        "frog.widgets.picture_indicator"
      ]
    }
  ],
  "svg_assets": [
    {
      "asset_id": "picture_rectangular_svg",
      "kind": "svg",
      "path": "../../../Libraries/Realizations/Default/assets/picture/templates/picture_rectangular.svg",
      "target_classes": [
        "frog.widgets.picture_indicator"
      ]
    }
  ]
}

    "panel_id": "main_panel",
    "title": "Array 1D Visible Count Property Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "array_runtime_host_default",
    "documentation": {
      "title": "Array 1D Visible Count Property Roundtrip",
      "summary": "A Numeric U8 control writes the visible-cell count of a one-dimensional Array through an explicit diagram property node. The Array still acts as a widget container whose visible cells instantiate Default Numeric widgets.",
      "sections": [
        {
          "title": "Visible-count property",
          "body": "The Numeric U8 control is front-panel state until Execute consumes it and writes numeric_array.viewport.visible_counts[0] and published_array.viewport.visible_counts[0]."
        },
        {
          "title": "Numeric element",
          "body": "Each cell instantiates a Numeric element template. The Numeric widget owns per-cell value editing, value text, and numeric visual parts."
        },
        {
          "title": "Execute",
          "body": "Execute consumes the selected Numeric element value through the native manifest corridor and publishes the value and vector records to the read-only Array indicator."
        }
      ]
    }
  }
}

{
  "spec_version": "0.1",
  "metadata": {
    "name": "31_array_1d_visible_count_property_roundtrip",
    "summary": "1D Array container visible-count property roundtrip using a Numeric U8 control and Default Array cells that instantiate Default Numeric element widgets.",
    "description": "Places a Numeric U8 control, one 1D Array control, and one read-only Array indicator on the front panel. The Numeric U8 value is consumed by a diagram property-write node that updates the Array viewport visible count when Execute runs. The Array owns rank, shape, viewport, index display, scrolling, and materialization. Each visible cell is a contained Numeric widget whose per-cell editing/display behavior comes from the Default Numeric realization. The .frog source owns the property node, element class binding, element default value, cell sizing, labels, bindings, initial values, and instance-level visual overrides. The .wfrog package references Default Array and Default Numeric realization assets.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "array",
      "array_control",
      "array_indicator",
      "rank_1",
      "vertical_array",
      "selected_element",
      "roundtrip",
      "wfrog",
      "widget_realization_package",
      "post_public_runtime_boundary",
      "array_container",
      "numeric_element_template",
      "default_numeric_realization",
      "widget_container",
      "property_node",
      "visible_count",
      "numeric_u8_control"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "element_value",
        "type": "u16",
        "binding_origin": "widget.numeric_array.value.selected_element_value"
      },
      {
        "id": "visible_item_count",
        "type": "u8",
        "binding_origin": "widget.visible_cell_count.value"
      },
      {
        "id": "array_records",
        "type": "frog.array.records<u16,rank=1>",
        "binding_origin": "widget.numeric_array.elements.*"
      }
    ],
    "outputs": [
      {
        "id": "selected_element_value",
        "type": "u16"
      },
      {
        "id": "published_array_records",
        "type": "frog.array.records<u16,rank=1>"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "numeric_array_element_value",
        "kind": "widget_value",
        "widget": "numeric_array",
        "member": "value.selected_element_value",
        "type": "u16"
      },
      {
        "id": "published_array_element_value",
        "kind": "widget_value",
        "widget": "published_array",
        "member": "value.selected_element_value",
        "type": "u16"
      },
      {
        "id": "numeric_array_records",
        "kind": "widget_value",
        "widget": "numeric_array",
        "member": "elements.*",
        "type": "frog.array.records<u16,rank=1>"
      },
      {
        "id": "visible_cell_count_value",
        "kind": "widget_value",
        "widget": "visible_cell_count",
        "member": "value",
        "type": "u8"
      },
      {
        "id": "numeric_array_visible_count_property",
        "kind": "property_write",
        "widget": "numeric_array",
        "member": "viewport.visible_counts[0]",
        "type": "u8"
      },
      {
        "id": "published_array_visible_count_property",
        "kind": "property_write",
        "widget": "published_array",
        "member": "viewport.visible_counts[0]",
        "type": "u8"
      },
      {
        "id": "published_array_records",
        "kind": "widget_value",
        "widget": "published_array",
        "member": "elements.*",
        "type": "frog.array.records<u16,rank=1>"
      },
      {
        "id": "output_selected_element_value",
        "kind": "interface_output",
        "interface_port": "selected_element_value"
      },
      {
        "id": "output_published_array_records",
        "kind": "interface_output",
        "interface_port": "published_array_records"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "numeric_array_element_value",
          "port": "value"
        },
        "to": {
          "node": "published_array_element_value",
          "port": "value"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "numeric_array_element_value",
          "port": "value"
        },
        "to": {
          "node": "output_selected_element_value",
          "port": "value"
        }
      },
      {
        "id": "e3",
        "from": {
          "node": "numeric_array_records",
          "port": "records"
        },
        "to": {
          "node": "published_array_records",
          "port": "records"
        }
      },
      {
        "id": "e4",
        "from": {
          "node": "numeric_array_records",
          "port": "records"
        },
        "to": {
          "node": "output_published_array_records",
          "port": "records"
        }
      },
      {
        "id": "e5",
        "from": {
          "node": "visible_cell_count_value",
          "port": "value"
        },
        "to": {
          "node": "numeric_array_visible_count_property",
          "port": "value"
        }
      },
      {
        "id": "e6",
        "from": {
          "node": "visible_cell_count_value",
          "port": "value"
        },
        "to": {
          "node": "published_array_visible_count_property",
          "port": "value"
        }
      }
    ]
  },

{
  "example_id": "31_array_1d_visible_count_property_roundtrip",
  "title": "Array 1D Visible Count Property Roundtrip",
  "snapshot_role": "accepted_public_reference_snapshot",
  "runtime_scope": {
    "accepted_runtime": "C++ Graiphic private runtime",
    "python_runtime": "deferred",
    "rust_runtime": "deferred"
  },
  "visible_surface": [
    {
      "widget_id": "visible_cell_count",
      "class_id": "frog.widgets.numeric_control",
      "role": "control",
      "semantic_value": "requested visible cell count"
    },
    {
      "widget_id": "numeric_array",
      "class_id": "frog.widgets.array_control",
      "role": "control",
      "semantic_value": "editable 1D numeric Array"
    },
    {
      "widget_id": "published_array",
      "class_id": "frog.widgets.array_indicator",
      "role": "indicator",
      "semantic_value": "read-only published 1D numeric Array"
    }
  ],
  "property_write_contract": {
    "trigger": "Execute",
    "input_widget": "visible_cell_count",
    "input_type": "u8",
    "targets": [
      "numeric_array.viewport.visible_counts[0]",
      "published_array.viewport.visible_counts[0]"
    ],
    "local_edit_rule": "Numeric control edits update front-panel state only until Execute consumes the value.",
    "design_time_boundary": "Immediate IDE live-edit behavior is intentionally out of scope for this execution-mode example."
  },
  "source_owned_properties": [
    "rank",
    "shape",
    "element.default_value",
    "viewport.first_indices[]",
    "viewport.visible_counts[]",
    "style.frame.*",
    "style.index_display.*",
    "element.class_id",
    "element.template_ref",
    "element.props.*",
    "property_write.targets[]"
  ],
  "consumed_default_assets": [
    "asset:array_shell_svg",
    "asset:numeric_rectangular_svg"
  ],
  "validation_notes": [
    "The Array is a container widget, not a hardcoded numeric grid.",
    "The visible-count property is written by diagram flow on Execute.",
    "Changing Visible cells without Execute must not resize the Array viewport.",
    "Runtime overlays must align to Default Array and Default Numeric published parts.",
    "No local Example SVG skin is duplicated."
  ]
}

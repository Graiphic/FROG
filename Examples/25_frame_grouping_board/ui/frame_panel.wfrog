{
  "format": "frog.wfrog",
  "kind": "widget_realization_package",
  "package_id": "example25.frame_panel",
  "title": "Example 25 Default Frame realization package",
  "artifact_governance_ref": {
    "path": "Versioning/Readme.md"
  },
  "source_ref": {
    "example_id": "25_frame_grouping_board",
    "source_path": "Examples/25_frame_grouping_board/main.frog",
    "fir_path": "Examples/25_frame_grouping_board/main.fir.json",
    "lowering_path": "Examples/25_frame_grouping_board/main.lowering.json"
  },
  "ownership_boundary": {
    "owns": [
      "Default Frame realization references",
      "Default Frame SVG asset references",
      "host binding requirements for simple Frame rendering and runtime validation"
    ],
    "does_not_own": [
      "canonical source semantics",
      "front-panel widget instance layout",
      "front-panel widget instance visual customization",
      "FIR semantics",
      "lowering semantics",
      "runtime-private execution behavior",
      "widget class law",
      "Default Frame SVG geometry"
    ]
  },
  "widget_classes": [
    {
      "class_id": "frog.widgets.frame",
      "role": "support",
      "value_type": null
    }
  ],
  "host_bindings": [
    {
      "binding_id": "frame_runtime_host_default",
      "host_family": "frog_conforming_frame_runtime_host",
      "target": "frog_conforming_frame_runtime_host",
      "required_capabilities": [
        "window",
        "basic_widget_rendering",
        "frame_rendering",
        "svg_part_overlay_alignment",
        "svg_style_property_binding",
        "native_kernel_manifest"
      ]
    }
  ],
  "realization_refs": [
    {
      "package_ref": "Libraries/Realizations/Default/frame.default.wfrog",
      "target_classes": [
        "frog.widgets.frame"
      ]
    }
  ],
  "svg_assets": [
    {
      "asset_id": "frame_rectangular_svg",
      "kind": "svg",
      "path": "../../../Libraries/Realizations/Default/assets/frame/templates/frame_rectangular.svg",
      "target_classes": [
        "frog.widgets.frame"
      ]
    }
  ],
  "notes": [
    "This package references the Default Frame realization instead of duplicating local SVG skins.",
    "The .frog source owns Frame instance layout and visual overrides.",
    "The .wfrog package resolves Default realization assets and declares host capabilities."
  ]
}

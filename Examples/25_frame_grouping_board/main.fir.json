{
  "format": "frog.fir",
  "version": "0.1",
  "source": {
    "example_id": "25_frame_grouping_board",
    "path": "Examples/25_frame_grouping_board/main.frog"
  },
  "front_panel_realization": {
    "package_path": "Examples/25_frame_grouping_board/ui/frame_panel.wfrog"
  },

{
  "spec_version": "0.1",
  "metadata": {
    "name": "06_boolean_value_roundtrip",
    "summary": "Boolean value-control to Boolean indicator roundtrip with clean square/round Default Boolean SVG skins.",
    "description": "Reads a bool value from one .frog-owned Boolean control, copies it to a Boolean indicator, and validates the Default Boolean semantic SVG contract. Boolean remains one widget family; square and round are realization skins.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "review": {
      "last_reviewed": "2026-06-11",
      "scope": "Example 06 clean Boolean state_face/placement_bounds SVG contract and C++ browser-host rendering",
      "visible_runtime_fact": "Reviewed 2026-06-11",
      "public_posture": "Review evidence is public; Graiphic runtime implementation code remains outside the public publication scope."
    },
    "tags": [
      "example",
      "ui",
      "widget_value",
      "boolean",
      "boolean_value_control",
      "boolean_square",
      "boolean_round",
      "roundtrip",
      "wfrog",
      "widget_realization_package"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "input_value",
        "type": "bool",
        "binding_origin": "widget.bool_input.value"
      }
    ],
    "outputs": [
      {
        "id": "result",
        "type": "bool"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "bool_input_value",
        "kind": "widget_value",
        "widget": "bool_input"
      },
      {
        "id": "bool_result_value",
        "kind": "widget_value",
        "widget": "bool_result"
      },
      {
        "id": "output_result",
        "kind": "interface_output",
        "interface_port": "result"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "bool_input_value",
          "port": "value"
        },
        "to": {
          "node": "bool_result_value",
          "port": "value"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "bool_input_value",
          "port": "value"
        },
        "to": {
          "node": "output_result",
          "port": "value"
        }
      }
    ]
  },
  "front_panel": {
    "canvas": {
      "width": 360,
      "height": 160,
      "coordinate_space": "panel_pixels"
    },
    "package_refs": [
      "./ui/boolean_panel.wfrog"
    ],
    "widgets": [
      {
        "id": "bool_input",
        "role": "control",
        "class_ref": "frog.widgets.boolean_control",
        "instance_ref": "bool_input",
        "value_type": "bool",
        "layout": {
          "x": 56,
          "y": 56,
          "width": 72,
          "height": 72,
          "origin": "placement_bounds.top_left",
          "bounds_ref": "placement_bounds"
        },
        "props": {
          "value": true,
          "label.text": "Boolean value control",
          "caption.text": "Square control",
          "caption.visible": true,
          "state_text.visible": true,
          "state_text.true_text": "On",
          "state_text.false_text": "Off",
          "interaction.enabled": true,
          "realization.variant": "rectangular"
        },
        "visual": {
          "asset_ref": "asset:boolean_rectangular_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_input_id": "input_value"
        }
      },
      {
        "id": "bool_result",
        "role": "indicator",
        "class_ref": "frog.widgets.boolean_indicator",
        "instance_ref": "bool_result",
        "value_type": "bool",
        "layout": {
          "x": 224,
          "y": 56,
          "width": 72,
          "height": 72,
          "origin": "placement_bounds.top_left",
          "bounds_ref": "placement_bounds"
        },
        "props": {
          "value": false,
          "label.text": "Boolean value result",
          "caption.text": "Round indicator",
          "caption.visible": true,
          "state_text.visible": false,
          "state_text.true_text": "On",
          "state_text.false_text": "Off",
          "interaction.enabled": false,
          "realization.variant": "circular"
        },
        "visual": {
          "asset_ref": "asset:boolean_circular_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_output_id": "result"
        }
      }
    ],
    "panel_id": "main_panel",
    "title": "Boolean Value Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "reference_host_default"
  }
}

{
  "spec_version": "0.1",
  "metadata": {
    "name": "06_boolean_value_roundtrip",
    "summary": "Bounded Boolean value-control to Boolean indicator roundtrip with .frog-owned Boolean widget instances and Default Boolean rectangular/circular SVG assets.",
    "description": "Reads a bool value from one .frog front-panel Boolean value control, exposes that value through the public input surface, copies it to one public output, and publishes it to one Boolean indicator. This example intentionally validates Boolean value widgets, not the Button command widget. The .frog source owns the Boolean widget instances, layout, binding, state labels, and per-instance appearance. The .wfrog package owns the published Default Boolean widget realization, host requirements, and SVG asset references consumed by the runtimes.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "review": {
      "last_reviewed": "2026-06-06",
      "scope": "Example 06 Boolean rectangular/circular SVG focus_ring posture and C++ browser-host rendering",
      "visible_runtime_fact": "Reviewed 2026-06-06",
      "public_posture": "Review evidence is public; Graiphic runtime implementation code remains outside the public publication scope."
    },
    "tags": [
      "example",
      "ui",
      "widget_value",
      "boolean",
      "boolean_value_control",
      "boolean_rectangular",
      "boolean_circular",
      "roundtrip",
      "wfrog",
      "widget_realization_package"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "input_value",
        "type": "bool",
        "binding_origin": "widget.bool_input.value"
      }
    ],
    "outputs": [
      {
        "id": "result",
        "type": "bool"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "bool_input_value",
        "kind": "widget_value",
        "widget": "bool_input"
      },
      {
        "id": "bool_result_value",
        "kind": "widget_value",
        "widget": "bool_result"
      },
      {
        "id": "output_result",
        "kind": "interface_output",
        "interface_port": "result"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "bool_input_value",
          "port": "value"
        },
        "to": {
          "node": "bool_result_value",
          "port": "value"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "bool_input_value",
          "port": "value"
        },
        "to": {
          "node": "output_result",
          "port": "value"
        }
      }
    ]
  },
  "front_panel": {
    "canvas": {
      "width": 420,
      "height": 150,
      "coordinate_space": "panel_pixels"
    },
    "package_refs": [
      "./ui/boolean_panel.wfrog"
    ],
    "widgets": [
      {
        "id": "bool_input",
        "role": "control",
        "class_ref": "frog.widgets.boolean_control",
        "instance_ref": "bool_input",
        "value_type": "bool",
        "layout": {
          "x": 20,
          "y": 32,
          "width": 160,
          "height": 80
        },
        "props": {
          "value": true,
          "label.text": "Boolean value control",
          "caption.text": "Boolean value",
          "caption.align.horizontal": "center",
          "caption.anchor.x": 80,
          "caption.anchor.y": 16,
          "caption.visible": true,
          "caption.style.text_color": "#111827",
          "caption.style.font_family": "system-ui, Segoe UI, Arial, sans-serif",
          "caption.style.font_size": "18px",
          "caption.style.font_weight": "600",
          "state_text.true_text": "TRUE",
          "state_text.false_text": "FALSE",
          "state_text.visible": true,
          "state_text.style.text_color.false": "#111827",
          "state_text.style.text_color.true": "#0b3d19",
          "state_text.style.font_size": "18px",
          "state_text.style.font_weight": "700",
          "style.outer.border_color.false": "transparent",
          "style.outer.border_color.true": "transparent",
          "style.outer.border_color.hover_false": "transparent",
          "style.outer.border_color.hover_true": "transparent",
          "style.outer.border_color.pressed_false": "transparent",
          "style.outer.border_color.pressed_true": "transparent",
          "style.frame.visible": false,
          "style.inner.border_color.false": "transparent",
          "style.inner.border_color.true": "transparent",
          "style.inner.border_color.hover_false": "transparent",
          "style.inner.border_color.hover_true": "transparent",
          "style.inner.border_color.pressed_false": "transparent",
          "style.inner.border_color.pressed_true": "transparent",
          "style.inner.fill_color.false": "#e5e7eb",
          "style.inner.fill_color.true": "#8bd86f",
          "style.inner.fill_color.hover_false": "#eef6ff",
          "style.inner.fill_color.hover_true": "#9be884",
          "style.inner.fill_color.pressed_false": "#dbeafe",
          "style.inner.fill_color.pressed_true": "#6fc657",
          "style.focus_ring.visible": true,
          "style.focus_ring.color": "#2563eb",
          "style.focus_ring.width": "3px",
          "style.pressed.inset": "1px",
          "style.transition.duration_ms": 120,
          "style.transition.timing": "ease-out",
          "interaction.enabled": true,
          "realization.variant": "rectangular"
        },
        "visual": {
          "asset_ref": "asset:boolean_rectangular_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_input_id": "input_value"
        }
      },
      {
        "id": "bool_result",
        "role": "indicator",
        "class_ref": "frog.widgets.boolean_indicator",
        "instance_ref": "bool_result",
        "value_type": "bool",
        "layout": {
          "x": 240,
          "y": 32,
          "width": 160,
          "height": 80
        },
        "props": {
          "value": false,
          "label.text": "Boolean value result",
          "caption.text": "Boolean indicator",
          "caption.align.horizontal": "center",
          "caption.anchor.x": 80,
          "caption.anchor.y": 16,
          "caption.visible": true,
          "caption.style.text_color": "#111827",
          "caption.style.font_family": "system-ui, Segoe UI, Arial, sans-serif",
          "caption.style.font_size": "18px",
          "caption.style.font_weight": "600",
          "state_text.true_text": "TRUE",
          "state_text.false_text": "FALSE",
          "state_text.visible": false,
          "state_text.style.text_color.false": "#111827",
          "state_text.style.text_color.true": "#0b3d19",
          "state_text.style.font_size": "18px",
          "state_text.style.font_weight": "700",
          "style.outer.border_color.false": "transparent",
          "style.outer.border_color.true": "transparent",
          "style.outer.border_color.hover_false": "transparent",
          "style.outer.border_color.hover_true": "transparent",
          "style.outer.border_color.pressed_false": "transparent",
          "style.outer.border_color.pressed_true": "transparent",
          "style.frame.visible": false,
          "style.inner.border_color.false": "transparent",
          "style.inner.border_color.true": "transparent",
          "style.inner.border_color.hover_false": "transparent",
          "style.inner.border_color.hover_true": "transparent",
          "style.inner.border_color.pressed_false": "transparent",
          "style.inner.border_color.pressed_true": "transparent",
          "style.inner.left": "60px",
          "style.inner.top": "31px",
          "style.inner.width": "40px",
          "style.inner.height": "40px",
          "style.inner.fill_color.false": "#ef4444",
          "style.inner.fill_color.true": "#22c55e",
          "style.transition.duration_ms": 120,
          "style.transition.timing": "ease-out",
          "interaction.enabled": false,
          "realization.variant": "circular"
        },
        "visual": {
          "asset_ref": "asset:boolean_circular_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_output_id": "result"
        }
      }
    ],
    "panel_id": "main_panel",
    "title": "Boolean Value Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "reference_host_default"
  }
}

{
  "format": "frog.wfrog",
  "kind": "widget_realization_package",
  "package_id": "example06.boolean_panel",
  "title": "Example 06 Default Boolean realization package",
  "artifact_governance_ref": {
    "path": "Versioning/Readme.md"
  },
  "source_ref": {
    "example_id": "06_boolean_value_roundtrip",
    "source_path": "Examples/06_boolean_value_roundtrip/main.frog",
    "fir_path": "Examples/06_boolean_value_roundtrip/main.fir.json",
    "lowering_path": "Examples/06_boolean_value_roundtrip/main.lowering.json"
  },
  "ownership_boundary": {
    "owns": [
      "Default Boolean realization references",
      "Default Boolean SVG asset references",
      "reference host binding requirements"
    ],
    "does_not_own": [
      "canonical source semantics",
      "front-panel widget instance layout",
      "front-panel widget instance visual customization",
      "front-panel widget values",
      "FIR/lowering/runtime behavior",
      "boolean widget law"
    ]
  },
  "widget_classes": [
    {
      "class_id": "frog.widgets.boolean_control",
      "role": "control",
      "value_type": "bool"
    },
    {
      "class_id": "frog.widgets.boolean_indicator",
      "role": "indicator",
      "value_type": "bool"
    }
  ],
  "host_bindings": [
    {
      "binding_id": "reference_host_default",
      "host_family": "reference_browser_host",
      "target": "reference_browser_host",
      "required_capabilities": [
        "window",
        "basic_widget_rendering",
        "widget_value_binding"
      ]
    }
  ],
  "realization_refs": [
    {
      "package_ref": "Libraries/Realizations/Default/boolean.default.wfrog",
      "target_classes": [
        "frog.widgets.boolean_control",
        "frog.widgets.boolean_indicator"
      ]
    }
  ],
  "svg_assets": [
    {
      "asset_id": "boolean_rectangular_svg",
      "kind": "svg",
      "path": "../../../Libraries/Realizations/Default/assets/boolean/templates/boolean_rectangular.svg",
      "target_class": "frog.widgets.boolean_control"
    },
    {
      "asset_id": "boolean_circular_svg",
      "kind": "svg",
      "path": "../../../Libraries/Realizations/Default/assets/boolean/templates/boolean_circular.svg",
      "target_class": "frog.widgets.boolean_indicator"
    }
  ]
}

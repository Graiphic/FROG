{
  "spec_version": "0.1",
  "metadata": {
    "name": "23_table_cell_selection_roundtrip",
    "summary": "Table control-to-indicator selected-cell numeric value roundtrip using .frog-owned table data and Default Table .wfrog realization assets.",
    "description": "Places one Table control and one Table indicator on the front panel. The .frog source owns column schema, row ids, cell values, selected cell state, layout, labels, bindings, and instance-level visual overrides. The .wfrog package references the Default Table realization and SVG asset. Runtime implementation for this post-boundary example continues in Graiphic/FROG-Runtime unless explicitly promoted later.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "table",
      "table_control",
      "table_indicator",
      "cell_selection",
      "roundtrip",
      "wfrog",
      "widget_realization_package",
      "post_public_runtime_boundary"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "cell_value",
        "type": "u16",
        "binding_origin": "widget.measurement_table.value.selected_cell_value"
      }
    ],
    "outputs": [
      {
        "id": "selected_cell_value",
        "type": "u16"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "measurement_table_cell_value",
        "kind": "widget_value",
        "widget": "measurement_table",
        "member": "value.selected_cell_value"
      },
      {
        "id": "published_table_cell_value",
        "kind": "widget_value",
        "widget": "published_table",
        "member": "value.selected_cell_value"
      },
      {
        "id": "output_selected_cell_value",
        "kind": "interface_output",
        "interface_port": "selected_cell_value"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "measurement_table_cell_value",
          "port": "value"
        },
        "to": {
          "node": "published_table_cell_value",
          "port": "value"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "measurement_table_cell_value",
          "port": "value"
        },
        "to": {
          "node": "output_selected_cell_value",
          "port": "value"
        }
      }
    ]
  },

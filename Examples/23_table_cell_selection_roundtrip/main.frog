    "documentation": {
      "title": "Table cell selection",
      "summary": "A Table presents flat row-and-column data. This example publishes the selected numeric cell value while keeping column schema, row ids, cells, selection posture, visible-item posture, layout, and style source-owned.",
      "legend": [
        {
          "label": "Table control",
          "description": "Clicking a numeric cell patches front-panel selection state only."
        },
        {
          "label": "Execute",
          "description": "Execute consumes the selected cell value through the native manifest corridor."
        },
        {
          "label": "Table indicator",
          "description": "Read-only cell selection display updated from the diagram output after Execute."
        }
      ],
      "note": "The runtime may provide hitbox overlays for cells, headers, and scrollbars, but they must align to the Default Table SVG parts and consume .frog-owned schema, display, selection, interaction, and style data."

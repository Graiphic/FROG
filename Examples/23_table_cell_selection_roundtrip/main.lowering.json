  },
  "fir_ref": {
    "path": "Examples/23_table_cell_selection_roundtrip/main.fir.json",
    "unit_id": "main"
  },
  "lowering_intent": {
    "summary": "make one post-boundary Table numeric selected-cell example consumable through a manifest-declared LLVM/native u16 proof boundary and Default Table realization",
    "backend_family_target": "llvm_native_kernel",
    "capability_targets": [
      "native_kernel_manifest",
      "private_runtime_table_cell_selection_binding",
      "svg_part_overlay_alignment",
      "table_state_patch_interaction",
      "svg_style_property_binding"
    ],
    "native_artifact_ref": {
      "manifest": "Implementations/Reference/LLVM/examples/23_table_cell_selection_roundtrip/native_kernel_manifest.json",
      "llvm_ir": "Implementations/Reference/LLVM/examples/23_table_cell_selection_roundtrip/kernel.ll"
    },
    "public_reference_runtime_source_added": false
  },
  "lowered_units": [
    {
      "unit_id": "main",
      "kind": "table_cell_selection_roundtrip_with_ui_bindings",
      "public_io": {
        "inputs": [
          {
            "id": "cell_value",
            "type": "u16"
          }
        ],
        "outputs": [
          {
            "id": "selected_cell_value",
            "type": "u16"
          }
        ]
      },
      "ui_bindings": {
        "value_bindings": [
          {
            "widget_id": "measurement_table",
            "widget_class": "frog.widgets.table_control",
            "mode": "widget_value",
            "semantic_value_member": "value.selected_cell_value",
            "ui_identity_member": "value.selected_cell_id",
            "realization_asset_ref": "asset:table_shell_svg"
          },
          {
            "widget_id": "published_table",
            "widget_class": "frog.widgets.table_indicator",
            "mode": "widget_value",
            "semantic_value_member": "value.selected_cell_value",
            "ui_identity_member": "value.selected_cell_id",
            "realization_asset_ref": "asset:table_shell_svg"
          }
        ],
        "host_overlays": [
          {
            "widget_id": "measurement_table",
            "part": "grid_region",
            "source_members": [
              "columns.*",
              "rows.*",
              "cells.*",
              "value.*",
              "selection.*",
              "viewport.*",
              "interaction.*",
              "display.*",
              "style.*"
            ]
          },
          {
            "widget_id": "published_table",
            "part": "grid_region",
            "source_members": [
              "columns.*",
              "rows.*",
              "cells.*",
              "value.*",
              "selection.*",
              "viewport.*",
              "display.*",
              "style.*"
            ],
            "host_state_rule": "selection_state_is_instance_local_not_dataflow"
          },
          {
            "widget_id": "measurement_table",
            "part": "cell",
            "source_members": [
              "cells.*",
              "style.cell.*",
              "style.selection_face.*",
              "style.active_cell.*"
            ]
          }
        ]
      },
      "execution_kernel": {
        "operation": "identity_u16",
        "native_manifest": "Implementations/Reference/LLVM/examples/23_table_cell_selection_roundtrip/native_kernel_manifest.json",
        "inputs": {
          "cell_value": "widget.measurement_table.value.selected_cell_value"
        },
        "outputs": {
          "selected_cell_value": "selected_cell_value"
        },
        "final_publication": [
          {
            "target": "widget.published_table.value.selected_cell_value",
            "source": "native_kernel.selected_cell_value"
          },
          {
            "target": "public_output.selected_cell_value",
            "source": "native_kernel.selected_cell_value"
          }
        ]
      }
    }

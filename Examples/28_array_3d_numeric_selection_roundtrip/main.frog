    "panel_id": "main_panel",
    "title": "Array 3D Numeric Selection Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "array_runtime_host_default",
    "documentation": {
      "title": "Array 3D Numeric Selection Roundtrip",
      "summary": "A three-dimensional numeric Array is a stack of 2D matrices. The index display exposes layer, row, and column indices; the visible grid shows one layer at a time.",
      "sections": [
        {
          "title": "Array control",
          "body": "Editing a visible or out-of-range numeric cell materializes the 3D rectangular volume up to [layer,row,column] and fills new numeric elements with 0."
        },
        {
          "title": "Execute",
          "body": "Execute consumes the selected 3D element value through the native manifest corridor and publishes the value plus record flow to the read-only Array indicator."
        },
        {
          "title": "Array indicator",
          "body": "The indicator is read-only. Its scrollbars and layer index are local viewport inspection state; semantic data changes only after Execute."
        }
      ]
    }
  }
}

{
  "spec_version": "0.1",
  "metadata": {
    "name": "28_array_3d_numeric_selection_roundtrip",
    "summary": "3D numeric Array control-to-indicator selected-element roundtrip using .frog-owned layer,row,column data and Default Array .wfrog realization assets.",
    "description": "Places one 3D numeric Array control and one read-only Array indicator on the front panel. The .frog source owns rank, shape, elements, selected element, three index displays, viewport, layout, labels, bindings, and instance-level visual overrides. The .wfrog package references the Default Array realization and SVG assets. Runtime implementation for this post-boundary example continues in Graiphic/FROG-Runtime unless explicitly promoted later.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "array",
      "array_control",
      "array_indicator",
      "numeric_array",
      "3d_array",
      "selected_element",
      "roundtrip",
      "wfrog",
      "widget_realization_package",
      "post_public_runtime_boundary"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "element_value",
        "type": "u16",
        "binding_origin": "widget.numeric_array.value.selected_element_value"
      },
      {
        "id": "array_records",
        "type": "frog.array.records<u16,rank=3>",
        "binding_origin": "widget.numeric_array.elements.*"
      }
    ],
    "outputs": [
      {
        "id": "selected_element_value",
        "type": "u16"
      },
      {
        "id": "published_array_records",
        "type": "frog.array.records<u16,rank=3>"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "numeric_array_element_value",
        "kind": "widget_value",
        "widget": "numeric_array",
        "member": "value.selected_element_value",
        "type": "u16"
      },
      {
        "id": "published_array_element_value",
        "kind": "widget_value",
        "widget": "published_array",
        "member": "value.selected_element_value",
        "type": "u16"
      },
      {
        "id": "numeric_array_records",
        "kind": "widget_value",
        "widget": "numeric_array",
        "member": "elements.*",
        "type": "frog.array.records<u16,rank=3>"
      },
      {
        "id": "published_array_records",
        "kind": "widget_value",
        "widget": "published_array",
        "member": "elements.*",
        "type": "frog.array.records<u16,rank=3>"
      },
      {
        "id": "output_selected_element_value",
        "kind": "interface_output",
        "interface_port": "selected_element_value"
      },
      {
        "id": "output_published_array_records",
        "kind": "interface_output",
        "interface_port": "published_array_records"
      }
    ],

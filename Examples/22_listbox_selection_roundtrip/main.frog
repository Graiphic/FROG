    "documentation": {
      "title": "Listbox selection",
      "summary": "A Listbox presents a finite visible item list. This example publishes the selected numeric item value while keeping item labels and selection posture source-owned.",
      "legend": [
        {
          "label": "Listbox control",
          "description": "Clicking an enabled item patches front-panel selection state only."
        },
        {
          "label": "Execute",
          "description": "Execute consumes the selected item value through the native manifest corridor."
        },
        {
          "label": "Listbox indicator",
          "description": "Read-only selection display updated from the diagram output after Execute."
        }
      ],
      "note": "The runtime may provide hitbox overlays for item rows, but they must align to the Default Listbox SVG parts and consume .frog-owned item/style data."
    }
  }
}

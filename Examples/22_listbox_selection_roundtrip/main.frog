{
  "spec_version": "0.1",
  "metadata": {
    "name": "22_listbox_selection_roundtrip",
    "summary": "Listbox control-to-indicator selected-value roundtrip using .frog-owned item data and Default Listbox .wfrog realization assets.",
    "description": "Places one Listbox control and one Listbox indicator on the front panel. The .frog source owns item ids, labels, numeric item values, selection, viewport, layout, labels, bindings, and instance-level visual overrides. The .wfrog package references the Default Listbox realization and SVG asset. Runtime implementation for this post-boundary example continues in Graiphic/FROG-Runtime unless explicitly promoted later.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "listbox",
      "listbox_control",
      "listbox_indicator",
      "selection",
      "roundtrip",
      "wfrog",
      "widget_realization_package",
      "post_public_runtime_boundary"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "item_value",
        "type": "u16",
        "binding_origin": "widget.mode_listbox.value.selected_value"
      }
    ],
    "outputs": [
      {
        "id": "selected_item_value",
        "type": "u16"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "mode_listbox_value",
        "kind": "widget_value",
        "widget": "mode_listbox",
        "member": "value.selected_value"
      },
      {
        "id": "selected_listbox_value",
        "kind": "widget_value",
        "widget": "selected_listbox",
        "member": "value.selected_value"
      },
      {
        "id": "output_selected_item_value",
        "kind": "interface_output",
        "interface_port": "selected_item_value"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "mode_listbox_value",
          "port": "value"
        },
        "to": {
          "node": "selected_listbox_value",
          "port": "value"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "mode_listbox_value",
          "port": "value"
        },
        "to": {
          "node": "output_selected_item_value",
          "port": "value"
        }
      }
    ]
  },

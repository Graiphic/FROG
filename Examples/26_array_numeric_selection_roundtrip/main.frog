    "panel_id": "main_panel",
    "title": "Array 2D Numeric Selection Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "array_runtime_host_default",
    "documentation": {
      "title": "Array numeric selection",
      "summary": "An Array presents a homogeneous collection. This example uses a 2D u16 Array control and read-only indicator. Selecting or editing an element changes front-panel state; Execute consumes the selected element through the native manifest and publishes the declared array-record flow to the indicator.",
      "legend": [
        {
          "label": "Array control",
          "description": "Click or edit an element. Index displays and scrollbars adjust only viewport state until Execute."
        },
        {
          "label": "Execute",
          "description": "Execute reads the selected u16 element through the manifest-backed native corridor."
        },
        {
          "label": "Array indicator",
          "description": "Read-only Array display patched from the declared dataflow output after Execute."
        }
      ],
      "note": "The runtime may provide host overlays for element cells, index displays, and scrollbars, but they must align to Default Array SVG parts and consume .frog-owned dimensions, elements, viewport, interaction, and style data."
    }
  }
}

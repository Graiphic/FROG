{
  "spec_version": "0.1",
  "metadata": {
    "name": "26_array_numeric_selection_roundtrip",
    "summary": "2D numeric Array control-to-indicator selected-element roundtrip using .frog-owned array data and Default Array .wfrog realization assets.",
    "description": "Places one 2D numeric Array control and one read-only Array indicator on the front panel. The .frog source owns rank, shape, elements, selected element, index display, viewport, layout, labels, bindings, and instance-level visual overrides. The .wfrog package references the Default Array realization and SVG assets. Runtime implementation for this post-boundary example continues in Graiphic/FROG-Runtime unless explicitly promoted later.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "array",
      "array_control",
      "array_indicator",
      "numeric_array",
      "selected_element",
      "roundtrip",
      "wfrog",
      "widget_realization_package",
      "post_public_runtime_boundary",
      "deprecated",
      "historical_milestone",
      "non_widget_composed_array",
      "rigid_array"
    ],
    "is_example": true,
    "lifecycle": {
      "status": "deprecated",
      "deprecated_on": "2026-06-04",
      "deprecated_reason": "Historical rigid/non-widget-composed Array milestone retained for regression and traceability; superseded by widget-composed Array container examples.",
      "superseded_by": [
        "29_array_1d_numeric_container_roundtrip",
        "30_array_1d_horizontal_numeric_container_roundtrip",
        "31_array_1d_visible_count_property_roundtrip",

          "element.props.style.value_display.vertical_offset": "-2px",
          "element.props.style.value_display.padding_inline": "9px",
          "element.props.style.selector_face.fill_color": "transparent",
          "element.props.style.selector_face.border_color": "transparent",
          "element.props.style.selector_face.border_width": "0px",
          "element.props.style.selector_face.symbol_color": "transparent",
          "element.props.style.focus_ring.color": "#2563eb",
          "element.props.style.focus_ring.width": "2px",
          "element.props.interaction.visible": true,
          "element.props.interaction.enabled": false,
          "element.props.interaction.read_only": true,
          "element.props.interaction.focusable": false,
          "element.props.realization.variant": "rectangular",
          "element.props.style.focus_ring.visible": false
        },
        "visual": {
          "asset_ref": "asset:array_shell_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_output_id": "selected_element_value"
        },
        "label": "Ring Array indicator"
      }
    ],
    "panel_id": "main_panel",
    "title": "Ring Array Dimension Count Property Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "array_runtime_host_default",
    "documentation": {
      "title": "Ring Array Dimension Count Property Roundtrip",
      "summary": "A Numeric U8 control writes Array dimensions.rank and index_display.rank while two Numeric U8 controls continue to write visible row and column counts. The Array adapts as an N-dimensional widget and each visible cell instantiates a Default Ring widget.",
      "sections": [
        {
          "title": "Dimension property",
          "body": "Execute consumes Dimensions, then writes ring_array.dimensions.rank / published_array.dimensions.rank and their index_display.rank mirrors."
        },
        {
          "title": "Visible-count properties",
          "body": "Execute consumes Visible rows and Visible columns, then writes ring_array.viewport.visible_counts[0]/[1] and published_array.viewport.visible_counts[0]/[1]."
        },
        {
          "title": "Ring element",
          "body": "Each visible cell instantiates a Ring element template. Control cells select source-owned ring items; indicator cells are read-only and visually greyed."
        },
        {
          "title": "Execute",
          "body": "Execute consumes the selected Ring element value through the native manifest corridor and publishes the value and matrix records to the read-only Array indicator."
        }
      ]
    }
  }
}

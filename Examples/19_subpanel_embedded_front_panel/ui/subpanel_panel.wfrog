      "host_family": "frog_conforming_subpanel_runtime_host",
      "target": "frog_conforming_subpanel_runtime_host",
      "required_capabilities": [
        "window",
        "basic_widget_rendering",
        "subpanel_embedding",
        "front_panel_reference_hosting",
        "svg_part_overlay_alignment",
        "svg_style_property_binding",
        "native_kernel_manifest"
      ]
    }
  ],
  "realization_refs": [

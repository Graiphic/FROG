            "public_input_id": "trigger_pressed",
            "value_type": "bool"
          }
        ],
        "indicator_bindings": [
          {
            "widget_id": "pressed_indicator",
            "mode": "widget_value",
            "public_output_id": "pressed",
            "value_type": "bool"

      },
      "execution_model": {
        "structure": "single_button_event_copy",
        "body_rule": {
          "kind": "copy_widget_event_to_output",
          "expression": "pressed = trigger_pressed"
        }
      },
      "publications": [
        {
          "target": "public_output.pressed",
          "source": "trigger_pressed"
        },
        {
          "target": "widget.pressed_indicator.value",
          "source": "trigger_pressed"
        }
      ],
      "notes": [
        "This FIR is an IDE placement witness for the Default Button realization.",
        "The Button control remains the same frog.widgets.button class; placement_bounds is the aura, button_face is the visible body.",

{
  "spec_version": "0.1",
  "metadata": {
    "name": "45_button_placement_ide_view",
    "summary": "IDE-view calibration example for the Default Button placement aura, button_face body, state text, and Boolean result indicator.",
    "description": "Publishes a source-owned IDE/calibration view of the Default rectangular Button posture. The Button uses placement_bounds as the selectable aura, button_face as the visible command body, a 4 px homogeneous aura band, and the shared IDE grid/selection vocabulary already validated by Numeric, Boolean, and Array widgets.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "review": {
      "last_reviewed": "2026-06-18",
      "reviewer": "Codex + Graiphic",
      "review_scope": "Default Button IDE grid, placement_bounds aura, button_face visible body, state_text centering, and click/hover/selected posture in the C++ private runtime.",
      "visible_runtime_fact": "Reviewed 2026-06-18"
    },
    "tags": [
      "example",
      "ui",
      "widget_value",
      "button",
      "button_command",
      "boolean",
      "wfrog",
      "widget_realization_package",
      "ide_view",
      "placement_grid",
      "placement_aura",
      "button_face",
      "aura_band_4px",
      "post_public_runtime_boundary"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "trigger_pressed",
        "type": "bool",
        "binding_origin": "widget.trigger_button.pressed"
      }
    ],
    "outputs": [
      {
        "id": "pressed",
        "type": "bool"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "trigger_button_pressed",
        "kind": "widget_event_value",
        "widget": "trigger_button",
        "event": "pressed",
        "value_type": "bool"
      },
      {
        "id": "pressed_indicator_value",
        "kind": "widget_value",
        "widget": "pressed_indicator"
      },
      {
        "id": "output_pressed",
        "kind": "interface_output",
        "interface_port": "pressed"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "trigger_button_pressed",
          "port": "value"
        },
        "to": {
          "node": "pressed_indicator_value",
          "port": "value"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "trigger_button_pressed",
          "port": "value"
        },
        "to": {
          "node": "output_pressed",
          "port": "value"
        }
      }
    ]
  },
  "front_panel": {
    "canvas": {
      "width": 432,
      "height": 208,
      "coordinate_space": "panel_pixels",
      "presentation_mode": "ide_view",
      "selected_widget_id": "trigger_button",
      "grid": {
        "visible": true,
        "pitch": 16,
        "origin": {
          "x": 0,
          "y": 0
        },
        "snap": "placement_bounds",
        "snap_edges": [
          "placement_bounds.top_left",
          "placement_bounds.top_right"
        ],
        "width_quantization": "grid_pitch_multiple"
      },
      "ide.style.aura.selected.border_color": "#00ADEF",
      "ide.style.aura.selected.fill_color": "rgba(14,165,233,0.025)",
      "ide.style.aura.selected.border_width": "1px",
      "ide.style.aura.hover.border_color": "rgba(0,173,239,0.42)",
      "ide.style.aura.hover.fill_color": "rgba(14,165,233,0.012)",
      "ide.style.aura.hover.border_width": "2px",
      "ide.style.label.selected.fill_color": "rgba(255,255,255,0.9)",
      "ide.style.label.hover.fill_color": "rgba(255,255,255,0.72)"
    },
    "package_refs": [
      "./ui/button_ide_panel.wfrog"
    ],
    "widgets": [
      {
        "id": "trigger_button",
        "role": "control",
        "class_ref": "frog.widgets.button",
        "instance_ref": "trigger_button",
        "value_type": "bool",
        "layout": {
          "x": 48,
          "y": 80,
          "width": 160,
          "height": 56,
          "origin": "placement_bounds.top_left",
          "bounds_ref": "placement_bounds"
        },
        "props": {
          "value": false,
          "pressed": false,
          "label.text": "Button",
          "label.visible": false,
          "caption.text": "Button",
          "caption.visible": true,
          "caption.anchor.x": 22,
          "caption.anchor.y": 74,
          "caption.align.horizontal": "left",
          "caption.style.text_color": "#2B3033",
          "caption.style.font_family": "Segoe UI, Arial, sans-serif",
          "caption.style.font_size": "18px",
          "caption.style.font_weight": "400",
          "state_text.false_text": "OFF",
          "state_text.true_text": "ON",
          "state_text.visible": true,
          "state_text.style.text_color.false": "#111827",
          "state_text.style.text_color.true": "#111827",
          "state_text.style.font_size": "22px",
          "state_text.style.font_weight": "400",
          "behavior.mechanical_action": "switch_until_released",
          "realization.crop_part": "placement_bounds",
          "realization.variant": "rectangular",
          "aura_band.px": 4,
          "style.button_face.fill_color.false": "#e2e8f0",
          "style.button_face.fill_color.true": "#cbd5e1",
          "style.button_face.fill_color.hover_false": "#f1f5f9",
          "style.button_face.fill_color.hover_true": "#dbeafe",
          "style.button_face.fill_color.pressed_false": "#cbd5e1",
          "style.button_face.fill_color.pressed_true": "#cbd5e1",
          "style.button_face.border_color.false": "#A8ABAE",
          "style.button_face.border_color.true": "#A8ABAE",
          "style.button_face.border_width": "1px",
          "style.pressed.inset": "0px",
          "style.pressed.apply_when_value_true": true,
          "style.pressed.apply_while_active": false,
          "style.hover.apply_when_value_false_only": false,
          "style.transition.duration_ms": 120,
          "style.transition.timing": "ease-out",
          "interaction.enabled": true,
          "interaction.read_only": false
        },
        "visual": {
          "asset_ref": "asset:button_rectangular_svg"
        },
        "binding": {
          "mode": "widget_event_value",
          "event": "pressed",
          "public_input_id": "trigger_pressed"
        }
      },
      {
        "id": "pressed_indicator",
        "role": "indicator",
        "class_ref": "frog.widgets.boolean_indicator",
        "instance_ref": "pressed_indicator",
        "value_type": "bool",
        "layout": {
          "x": 272,
          "y": 80,
          "width": 80,
          "height": 80,
          "origin": "placement_bounds.top_left",
          "bounds_ref": "placement_bounds"
        },
        "props": {
          "value": false,
          "label.text": "Pressed",
          "caption.text": "Pressed",
          "caption.visible": true,
          "state_text.true_text": "On",
          "state_text.false_text": "Off",
          "state_text.visible": false,
          "realization.variant": "circular",
          "aura_band.px": 4,
          "interaction.enabled": false,
          "interaction.read_only": true
        },
        "visual": {
          "asset_ref": "asset:boolean_circular_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_output_id": "pressed"
        }
      }
    ],
    "panel_id": "main_panel",
    "title": "Button Placement IDE View",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "reference_host_default"
  }
}

    "panel_id": "main_panel",
    "title": "Array 1D Horizontal Numeric Container Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "array_runtime_host_default",
    "documentation": {
      "title": "Array 1D Horizontal Numeric Container Roundtrip",
      "summary": "Reviewed 2026-06-11. A one-dimensional Array can act as a widget container. This example binds the Array element template to the Default Numeric widget so each visible cell behaves as a Numeric element inside the Array viewport.",
      "sections": [
        {
          "title": "Array container",
          "body": "The Array owns rank, shape, index display, viewport, scrolling, materialization, and repeated-cell layout."
        },
        {
          "title": "Numeric element",
          "body": "Each cell instantiates a Numeric element template. The Numeric widget owns per-cell value editing, value text, and numeric visual parts."
        },
        {
          "title": "Execute",
          "body": "Execute consumes the selected Numeric element value through the native manifest corridor and publishes the value and vector records to the read-only Array indicator."
        }
      ]
    }
  }
}

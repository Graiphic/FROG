{
  "spec_version": "0.1",
  "metadata": {
    "name": "30_array_1d_horizontal_numeric_container_roundtrip",
    "summary": "1D horizontal Array container control-to-indicator roundtrip using Default Array cells that instantiate Default Numeric element widgets.",
    "description": "Places one horizontal 1D Array control and one read-only horizontal Array indicator on the front panel. The Array owns rank, shape, viewport orientation, index display, horizontal scrolling, and materialization. Each visible cell is a contained Numeric widget whose per-cell editing/display behavior comes from the Default Numeric realization. The .frog source owns element class binding, element default value, cell sizing, labels, bindings, initial values, and instance-level visual overrides. The .wfrog package references Default Array and Default Numeric realization assets.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "array",
      "array_control",
      "array_indicator",
      "rank_1",
      "horizontal_array",
      "selected_element",
      "roundtrip",
      "wfrog",
      "widget_realization_package",
      "post_public_runtime_boundary",
      "array_container",
      "numeric_element_template",
      "default_numeric_realization",
      "widget_container"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "element_value",
        "type": "u16",
        "binding_origin": "widget.numeric_array.value.selected_element_value"
      },
      {
        "id": "array_records",
        "type": "frog.array.records<u16,rank=1>",
        "binding_origin": "widget.numeric_array.elements.*"
      }

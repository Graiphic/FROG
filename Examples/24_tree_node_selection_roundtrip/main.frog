    "panel_id": "main_panel",
    "title": "Tree Node Selection Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "tree_runtime_host_default",
    "documentation": {
      "title": "Tree node selection",
      "summary": "A Tree presents finite hierarchical data. This example publishes the selected numeric node value while keeping node ids, tags, labels, expansion state, selection posture, visible-item posture, layout, and style source-owned.",
      "legend": [
        {
          "label": "Tree control",
          "description": "Clicking a node patches front-panel selection state only."
        },
        {
          "label": "Execute",
          "description": "Execute consumes the selected node value through the native manifest corridor."
        },
        {
          "label": "Tree indicator",
          "description": "Read-only node selection and tree-record display updated from diagram outputs after Execute."
        }
      ],
      "note": "The runtime may provide hitbox overlays for tree rows and scrollbars, but they must align to the Default Tree SVG parts and consume .frog-owned nodes, tags, display, selection, expansion, interaction, and style data. Editable Tree cell records are part of the diagram dataflow: Execute publishes system_tree.nodes.* to published_tree.nodes.* instead of using an implicit UI synchronization."
    }
  }
}

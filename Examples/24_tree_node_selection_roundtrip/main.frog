{
  "spec_version": "0.1",
  "metadata": {
    "name": "24_tree_node_selection_roundtrip",
    "summary": "Tree control-to-indicator selected-node numeric value roundtrip using .frog-owned hierarchy data and Default Tree .wfrog realization assets.",
    "description": "Places one Tree control and one Tree indicator on the front panel. The .frog source owns node ids, tags, labels, values, hierarchy, expansion, selection, visible-item posture, layout, labels, bindings, and instance-level visual overrides. The .wfrog package references the Default Tree realization and SVG asset. Runtime implementation for this post-boundary example continues in Graiphic/FROG-Runtime unless explicitly promoted later.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "tree",
      "tree_control",
      "tree_indicator",
      "node_selection",
      "roundtrip",
      "wfrog",
      "widget_realization_package",
      "post_public_runtime_boundary"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {
    "inputs": [
      {
        "id": "node_value",
        "type": "u16",
        "binding_origin": "widget.system_tree.value.selected_node_value"
      },
      {
        "id": "tree_records",
        "type": "frog.tree.records",
        "binding_origin": "widget.system_tree.nodes.*"
      }
    ],
    "outputs": [
      {
        "id": "selected_node_value",
        "type": "u16"
      },
      {
        "id": "published_tree_records",
        "type": "frog.tree.records"
      }
    ]
  },
  "diagram": {
    "nodes": [
      {
        "id": "system_tree_node_value",
        "kind": "widget_value",
        "widget": "system_tree",
        "member": "value.selected_node_value"
      },
      {
        "id": "published_tree_node_value",
        "kind": "widget_value",
        "widget": "published_tree",
        "member": "value.selected_node_value"
      },
      {
        "id": "system_tree_records",
        "kind": "widget_value",
        "widget": "system_tree",
        "member": "nodes.*",
        "type": "frog.tree.records"
      },
      {
        "id": "published_tree_records",
        "kind": "widget_value",
        "widget": "published_tree",
        "member": "nodes.*",
        "type": "frog.tree.records"
      },
      {
        "id": "output_published_tree_records",
        "kind": "interface_output",
        "interface_port": "published_tree_records"
      },
      {
        "id": "output_selected_node_value",
        "kind": "interface_output",
        "interface_port": "selected_node_value"
      }
    ],
    "edges": [
      {
        "id": "e1",
        "from": {
          "node": "system_tree_node_value",
          "port": "value"
        },
        "to": {
          "node": "published_tree_node_value",
          "port": "value"
        }
      },
      {
        "id": "e2",
        "from": {
          "node": "system_tree_node_value",
          "port": "value"
        },
        "to": {
          "node": "output_selected_node_value",
          "port": "value"
        }
      },
      {
        "id": "e3",
        "from": {
          "node": "system_tree_records",
          "port": "records"
        },
        "to": {
          "node": "published_tree_records",
          "port": "records"
        }
      },
      {
        "id": "e4",
        "from": {
          "node": "system_tree_records",
          "port": "records"
        },
        "to": {
          "node": "output_published_tree_records",
          "port": "records"
        }
      }
    ]
  },

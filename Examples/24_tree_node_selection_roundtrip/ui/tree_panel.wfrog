    ],
    "does_not_own": [
      "canonical source semantics",
      "front-panel widget instance layout",
      "front-panel widget instance visual customization",
      "Tree node ids, tags, hierarchy, expansion, and selection records",
      "selected Tree node value",
      "Tree visible-item toggles and interaction posture",
      "FIR semantics",
      "lowering semantics",
      "runtime-private execution behavior",
      "widget class law",
      "Default Tree SVG geometry"
    ]
  },
  "widget_classes": [
    {
      "class_id": "frog.widgets.tree_control",
      "role": "control",
      "value_type": "u16"
    },
    {
      "class_id": "frog.widgets.tree_indicator",
      "role": "indicator",
      "value_type": "u16"
    }
  ],
  "host_bindings": [
    {
      "binding_id": "tree_runtime_host_default",
      "host_family": "frog_conforming_tree_runtime_host",
      "target": "frog_conforming_tree_runtime_host",
      "required_capabilities": [
        "window",
        "basic_widget_rendering",
        "widget_value_binding",
        "tree_node_selection_rendering",
        "tree_visible_item_rendering",
        "tree_parent_child_expansion_rendering",
        "tree_column_attribute_rendering",
        "tree_state_patch_interaction",
        "tree_expansion_patch_interaction",
        "tree_scroll_interaction",
        "tree_cell_edit_interaction",
        "svg_part_overlay_alignment",
        "svg_style_property_binding",
        "native_kernel_manifest"
      ]
    }
  ],
  "realization_refs": [
    {
      "package_ref": "Libraries/Realizations/Default/tree.default.wfrog",
      "target_classes": [
        "frog.widgets.tree_control",
        "frog.widgets.tree_indicator"
      ]
    }
  ],
  "svg_assets": [
    {
      "asset_id": "tree_shell_svg",
      "kind": "svg",

{
  "format": "frog.wfrog",
  "kind": "widget_realization_package",
  "package_id": "example18.decoration_panel",
  "title": "Example 18 Default Decoration realization package",
  "artifact_governance_ref": {
    "path": "Versioning/Readme.md"
  },
  "source_ref": {
    "example_id": "18_decoration_board",
    "source_path": "Examples/18_decoration_board/main.frog",
    "fir_path": "Examples/18_decoration_board/main.fir.json",
    "lowering_path": "Examples/18_decoration_board/main.lowering.json"
  },
  "ownership_boundary": {
    "owns": [
      "Default Decoration realization references",
      "Default Decoration SVG asset references",
      "host binding requirements for decoration rendering and runtime validation"
    ],
    "does_not_own": [
      "canonical source semantics",
      "front-panel widget instance layout",
      "front-panel widget instance visual customization",
      "FIR semantics",
      "lowering semantics",
      "runtime-private execution behavior",
      "widget class law",
      "Default Decoration SVG geometry"
    ]
  },
  "widget_classes": [
    {
      "class_id": "frog.widgets.flat_box",
      "role": "support",
      "value_type": null
    },
    {
      "class_id": "frog.widgets.horizontal_line",
      "role": "support",
      "value_type": null
    },
    {
      "class_id": "frog.widgets.vertical_line",
      "role": "support",
      "value_type": null
    }
  ],
  "host_bindings": [
    {
      "binding_id": "decoration_runtime_host_default",
      "host_family": "frog_conforming_decoration_runtime_host",
      "target": "frog_conforming_decoration_runtime_host",
      "required_capabilities": [
        "window",
        "basic_widget_rendering",
        "decoration_rendering",
        "svg_part_overlay_alignment",
        "svg_style_property_binding",
        "native_kernel_manifest"
      ]
    }
  ],
  "realization_refs": [
    {
      "package_ref": "Libraries/Realizations/Default/decorations.default.wfrog",
      "target_classes": [
        "frog.widgets.flat_box",
        "frog.widgets.horizontal_line",
        "frog.widgets.vertical_line"
      ]
    }
  ],
  "svg_assets": [
    {
      "asset_id": "decoration_flat_box_svg",
      "kind": "svg",
      "path": "../../../Libraries/Realizations/Default/assets/decorations/templates/flat_box.svg",
      "target_classes": [
        "frog.widgets.flat_box"
      ]
    },
    {
      "asset_id": "decoration_horizontal_line_svg",
      "kind": "svg",
      "path": "../../../Libraries/Realizations/Default/assets/decorations/templates/horizontal_line.svg",
      "target_classes": [
        "frog.widgets.horizontal_line"
      ]
    },
    {
      "asset_id": "decoration_vertical_line_svg",
      "kind": "svg",
      "path": "../../../Libraries/Realizations/Default/assets/decorations/templates/vertical_line.svg",
      "target_classes": [
        "frog.widgets.vertical_line"
      ]
    }
  ]
}

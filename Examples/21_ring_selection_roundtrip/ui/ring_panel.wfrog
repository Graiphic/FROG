{
  "format": "frog.wfrog",
  "kind": "widget_realization_package",
  "package_id": "example21.ring_panel",
  "title": "Example 21 Default Ring realization package",
  "artifact_governance_ref": {
    "path": "Versioning/Readme.md"
  },
  "source_ref": {
    "example_id": "21_ring_selection_roundtrip",
    "source_path": "Examples/21_ring_selection_roundtrip/main.frog",
    "fir_path": "Examples/21_ring_selection_roundtrip/main.fir.json",
    "lowering_path": "Examples/21_ring_selection_roundtrip/main.lowering.json"
  },
  "ownership_boundary": {
    "owns": [
      "Default Ring realization reference",
      "Default Ring SVG asset reference",
      "host binding requirements for Ring selector rendering"
    ],
    "does_not_own": [
      "canonical source semantics",
      "front-panel widget instance layout",
      "front-panel widget instance visual customization",
      "Ring item records",
      "selected Ring value",
      "FIR semantics",
      "lowering semantics",
      "runtime-private execution behavior",
      "widget class law",
      "Default Ring SVG geometry"
    ]
  },
  "widget_classes": [
    {
      "class_id": "frog.widgets.ring_control",
      "role": "control",
      "value_type": "u16"
    },
    {
      "class_id": "frog.widgets.ring_indicator",
      "role": "indicator",
      "value_type": "u16"
    }
  ],
  "host_bindings": [
    {
      "binding_id": "ring_runtime_host_default",
      "host_family": "frog_conforming_ring_runtime_host",
      "target": "frog_conforming_ring_runtime_host",
      "required_capabilities": [
        "window",
        "basic_widget_rendering",
        "widget_value_binding",
        "ring_selection_rendering",
        "ring_popup_overlay",
        "ring_state_patch_interaction",
        "svg_part_overlay_alignment",
        "svg_style_property_binding",
        "native_kernel_manifest"
      ]
    }
  ],
  "realization_refs": [
    {
      "package_ref": "Libraries/Realizations/Default/ring.default.wfrog",
      "target_classes": [
        "frog.widgets.ring_control",
        "frog.widgets.ring_indicator"
      ]
    }
  ],
  "svg_assets": [
    {
      "asset_id": "ring_rectangular_svg",
      "kind": "svg",
      "path": "../../../Libraries/Realizations/Default/assets/ring/templates/ring_rectangular.svg",
      "target_classes": [
        "frog.widgets.ring_control",
        "frog.widgets.ring_indicator"
      ]
    }
  ]
}

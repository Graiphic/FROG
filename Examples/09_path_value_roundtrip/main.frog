          "caption.style.font_size": "14px",
          "caption.style.font_weight": "600",
          "display.icon_visible": true,
          "display.validation_marker_visible": false,
          "display.text_overflow_visible": false,
          "browse.enabled": false,
          "browse.button_visible": false,
          "style.path_face.fill_color": "#f8fafc",
          "style.path_face.border_color": "#64748b",
          "style.path_face.border_width": "2px",
          "style.path_display.color": "#111827",
          "style.path_display.font_size": "16px",
          "style.path_display.font_weight": "400",
          "style.path_display.padding_inline": "4px",
          "style.path_display.baseline_offset": "0px",
          "style.path_icon.fill_color": "#facc15",
          "style.path_icon.front_fill_color": "#fde68a",
          "style.path_icon.stroke_color": "#b45309",
          "style.path_icon.highlight_color": "#fff7cc",
          "style.browse_button.fill_color": "transparent",
          "style.browse_button.border_color": "transparent",
          "style.browse_button.border_width": "0px",
          "interaction.enabled": false,
          "interaction.read_only": true,
          "realization.variant": "rectangular_field"
        },
        "visual": {
          "asset_ref": "asset:path_rectangular_field_svg"
        },
        "binding": {
          "mode": "widget_value",
          "public_output_id": "result_path"
        }
      },

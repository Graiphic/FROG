  "lowering_intent": {
    "purpose": "make the path value roundtrip consumable by a bounded runtime/UI-binding check",
    "backend_family_target": "reference_host_runtime_ui_binding",
    "compiler_family_targets": [
      "llvm_native_kernel_bridge"
    ]
  },
  "lowered_units": [
    {
      "unit_id": "main",
      "kind": "path_value_roundtrip_kernel_with_ui_bindings",
      "public_io": {
        "inputs": [
          {
            "id": "input_path",
            "type": "path"
          }
        ],
        "outputs": [
          {
            "id": "result_path",
            "type": "path"
          }
        ]
      },
      "ui_bindings": {
        "control_bindings": [
          {
            "widget_id": "path_input",
            "mode": "widget_value",
            "public_input_id": "input_path",
            "value_type": "path"
          }

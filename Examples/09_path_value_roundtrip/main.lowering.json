        "indicator_bindings": [
          {
            "widget_id": "path_result",
            "mode": "widget_value",
            "public_output_id": "result_path",
            "value_type": "path"
          }
        ]
      },
      "execution_kernel": {
        "operation": "copy",
        "dst": "result_path",
        "type": "path",
        "src": "input_path",
        "encoding": "utf8",
        "max_utf8_bytes": 256,
        "final_publication": [
          {
            "target": "public_output.result_path",
            "source": "input_path"

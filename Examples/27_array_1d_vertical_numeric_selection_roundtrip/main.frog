    "is_example": true,
    "lifecycle": {
      "status": "deprecated",
      "deprecated_on": "2026-06-04",
      "deprecated_reason": "Historical rigid/non-widget-composed Array milestone retained for regression and traceability; superseded by widget-composed Array container examples.",

{
  "spec_version": "0.1",
  "metadata": {
    "name": "27_array_1d_vertical_numeric_selection_roundtrip",
    "summary": "1D vertical numeric Array control-to-indicator selected-element roundtrip using .frog-owned array data and Default Array .wfrog realization assets.",
    "description": "Places one 1D vertical numeric Array control and one read-only Array indicator on the front panel. The .frog source owns rank, length, elements, selected element, one-dimensional index display, vertical viewport, layout, labels, bindings, and instance-level visual overrides. The .wfrog package references the Default Array realization and SVG assets. Runtime implementation for this post-boundary example continues in Graiphic/FROG-Runtime unless explicitly promoted later.",
    "author": "Graiphic",
    "program_version": "0.1.0",

    "panel_id": "main_panel",
    "title": "Array 1D Vertical Numeric Selection Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "array_runtime_host_default",
    "documentation": {
      "title": "Array 1D Vertical Numeric Selection Roundtrip",
      "summary": "A one-dimensional Array is a finite ordered vector. The index display has one value and the vertical viewport exposes a contiguous slice of the vector.",
      "sections": [
        {
          "title": "Array control",
          "body": "Editing a visible or out-of-range numeric cell materializes the vector up to that index and fills new numeric elements with 0."
        },
        {
          "title": "Execute",
          "body": "Execute consumes the selected 1D element value through the native manifest corridor and publishes the value to the read-only Array indicator."
        },
        {
          "title": "Array indicator",
          "body": "The indicator is read-only. It mirrors the executed vector data and selected value without accepting direct edits."
        }
      ]
    }
  }
}

{
    "spec_version":  "0.1",
    "metadata":  {
                     "name":  "41_numeric_placement_ide_view",
                     "summary":  "IDE-view calibration example for Default Numeric placement grid, placement aura, label aura, and compact control/indicator postures.",
                     "description":  "Publishes a source-owned IDE/calibration view of the Default Numeric control and indicator postures. It keeps the same placement coordinates as execution surfaces, shows the common 16px grid, and lets the C++ reference browser host render source-declared placement aura selection overlays. Execution semantics remain the bounded accumulator shape only to reuse the existing C++ Slice 05 runtime family; this example is reviewed as an IDE/placement witness rather than an applicative execution slice.",
                     "author":  "Graiphic",
                     "program_version":  "0.1.0",
                     "review":  {
                                    "last_reviewed":  "2026-06-08",
                                    "review_scope":  "Default Numeric IDE grid, placement_bounds aura, label aura, centered control/indicator bodies, and button-side postures."
                                },
                     "tags":  [
                                  "example",
                                  "ui",
                                  "widget_value",
                                  "widget_reference",
                                  "bounded_loop",
                                  "state",
                                  "delay",
                                  "accumulator",
                                  "vertical_slice",
                                  "u16",
                                  "property_write",
                                  "foreground_color",
                                  "wfrog",
                                  "widget_realization_package",
                                  "ide_view",
                                  "placement_grid",
                                  "placement_aura"
                              ],
                     "is_example":  true,
                     "license":  "Apache-2.0"
                 },

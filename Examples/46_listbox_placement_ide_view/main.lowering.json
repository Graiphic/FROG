                                                                                     "target":  "widget.selected_listbox.value.selected_value",
                                                                                     "source":  "native_kernel.selected_item_value"
                                                                                 },
                                                                                 {
                                                                                     "target":  "public_output.selected_item_value",
                                                                                     "source":  "native_kernel.selected_item_value"
                                                                                 }
                                                                             ]
                                                   }
                          }
                      ]
}

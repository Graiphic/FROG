                                                                             "mode":  "widget_value",
                                                                             "semantic_value_member":  "value.selected_value",
                                                                             "ui_identity_member":  "value.selected_id",
                                                                             "realization_asset_ref":  "asset:listbox_shell_svg"
                                                                         },
                                                                         {
                                                                             "widget_id":  "selected_listbox",
                                                                             "widget_class":  "frog.widgets.listbox_indicator",
                                                                             "mode":  "widget_value",
                                                                             "semantic_value_member":  "value.selected_value",
                                                                             "ui_identity_member":  "value.selected_id",
                                                                             "realization_asset_ref":  "asset:listbox_shell_svg"
                                                                         }
                                                                     ],
                                                  "host_overlays":  [

    ],
    "panel_id": "main_panel",
    "title": "Array Dimension Count Property Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "array_runtime_host_default",
    "documentation": {
      "title": "Array Dimension Count Property Roundtrip",
      "summary": "A Numeric U8 control writes Array dimensions.rank and index_display.rank while two Numeric U8 controls continue to write visible row and column counts. The Array adapts as an N-dimensional widget: every dimension owns an index display and the last two dimensions form the visible matrix whose cells instantiate Default Numeric widgets.",
      "sections": [
        {
          "title": "Dimension property",
          "body": "Execute consumes Dimensions, then writes numeric_array.dimensions.rank / published_array.dimensions.rank and their index_display.rank mirrors. The widget creates the requested N-dimensional shape from explicit profiles and the default leading-singleton trailing-matrix policy."
        },
        {
          "title": "Visible-count properties",
          "body": "Execute consumes Visible rows and Visible columns, then writes numeric_array.viewport.visible_counts[0]/[1] and published_array.viewport.visible_counts[0]/[1]."
        },
        {
          "title": "Numeric element",
          "body": "Each visible cell instantiates a Numeric element template. Control cells keep increment/decrement buttons; indicator cells are read-only and visually greyed."
        },
        {
          "title": "Execute",
          "body": "Execute consumes the selected Numeric element value through the native manifest corridor and publishes the value and matrix records to the read-only Array indicator."
        }
      ]
    }
  }
}

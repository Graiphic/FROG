{
  "spec_version": "0.1",
  "metadata": {
    "name": "35_array_dimension_count_property_roundtrip",
    "summary": "Array dynamic dimension-count property roundtrip using one Numeric U8 dimension control plus two Numeric U8 visible row/column controls.",
    "description": "Places a Numeric U8 dimension-count control, two Numeric U8 visible-count controls, one Array control, and one read-only Array indicator on the front panel. Execute consumes the dimension count through explicit diagram property-write nodes that update Array dimensions.rank and index_display.rank, then consumes the row and column values through property-write nodes that update Array viewport.visible_counts[0] and viewport.visible_counts[1]. This slice commands an N-dimensional Array posture: rank 1 renders as a single-axis array, rank 2 renders as a matrix, and rank 3 or higher renders the last two dimensions as the visible matrix while exposing all leading dimensions through stacked index displays. Each visible cell is a contained Numeric widget whose per-cell editing/display behavior comes from the Default Numeric realization.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "tags": [
      "example",
      "ui",
      "array",
      "array_control",
      "array_indicator",
      "rank_N",
      "n_dimensional_array",
      "selected_element",
      "roundtrip",
      "wfrog",
      "widget_realization_package",
      "post_public_runtime_boundary",
      "array_container",
      "numeric_element_template",
      "default_numeric_realization",
      "widget_container",
      "last_two_dimension_projection",
      "leading_index_displays",
      "property_node",
      "visible_counts",
      "visible_row_count",
      "visible_column_count",
      "numeric_u8_controls",
      "dimension_count",
      "index_display_rank",
      "display_dimension_count",
      "dynamic_rank",
      "rank_command"
    ],
    "is_example": true,
    "license": "Apache-2.0"
  },
  "interface": {

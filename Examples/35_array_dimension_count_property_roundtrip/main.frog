          "dimensions.default_element_value": 0,
          "dimensions.materialize_out_of_range_edits": true,
          "viewport.orientation": "matrix",
          "element.template_ref": "frog.realizations.default.numeric_indicator",
          "element.asset_ref": "asset:numeric_rectangular_svg",
          "element.default_value": 0,
          "element.cell_width": 74,
          "element.cell_height": 30,
          "element.layout.fit_part": "indicator_body",
          "element.layout.boundary_policy": "superpose_adjacent_widget_bounds",
          "element.props.caption.visible": false,
          "element.props.label.visible": false,
          "element.props.display.increment_buttons_visible": false,
          "element.props.display.radix_visible": false,
          "element.props.interaction.read_only": true,
          "element.props.style.frame.fill_color": "transparent",
          "element.props.style.frame.border_color": "#94a3b8",
          "element.props.style.frame.border_width": "1px",
          "element.props.style.value_face.fill_color": "#eef2f7",
          "element.props.style.value_face.border_color": "transparent",
          "element.props.style.value_face.border_width": "0px",
          "element.props.style.text_value.color": "#111827",
          "element.props.style.text_value.font_family": "Segoe UI, Arial, sans-serif",
          "element.props.style.text_value.font_size": "13px",
          "element.props.style.text_value.font_weight": "400",
          "dimensions.rank_profile.1.shape": [

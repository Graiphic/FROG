                        "panel_id":  "main_panel",
                        "title":  "Array 2D Numeric Container Roundtrip",
                        "class_ref":  "frog.widgets.panel",
                        "host_binding_ref":  "array_runtime_host_default",
                        "documentation":  {
                                              "title":  "Array 2D Numeric Container Roundtrip",
                                              "summary":  "A two-dimensional Array can act as a widget container. This example binds each visible Array cell to the Default Numeric widget so the Array manages dimensions and scrolling while the contained Numeric widgets keep their own control/indicator posture.",
                                              "sections":  [
                                                               {
                                                                   "title":  "Array container",
                                                                   "body":  "The Array owns rank 2, shape, index displays, viewport, scrolling, materialization, and repeated-cell layout."
                                                               },
                                                               {
                                                                   "title":  "Numeric element",
                                                                   "body":  "Each visible cell instantiates a Numeric element template. Control cells keep increment/decrement buttons; indicator cells are read-only and visually greyed."
                                                               },
                                                               {
                                                                   "title":  "Execute",
                                                                   "body":  "Execute consumes the selected Numeric element value through the native manifest corridor and publishes the value and matrix records to the read-only Array indicator."
                                                               }
                                                           ]
                                          }
                    }
}


{
    "spec_version":  "0.1",
    "metadata":  {
                     "name":  "33_array_2d_numeric_container_roundtrip",
                     "summary":  "2D Array container control-to-indicator roundtrip using Default Array cells that instantiate Default Numeric element widgets.",
                     "description":  "Places one two-dimensional Array control and one read-only Array indicator on the front panel. The Array owns rank, shape, viewport, index displays, scrolling, and materialization. Each visible cell is a contained Numeric widget whose per-cell editing/display behavior comes from the Default Numeric realization. The .frog source owns element class binding, element default value, cell sizing, labels, bindings, initial values, and instance-level visual overrides. The .wfrog package references Default Array and Default Numeric realization assets.",
                     "author":  "Graiphic",
                     "program_version":  "0.1.0",
                     "tags":  [
                                  "example",
                                  "ui",
                                  "array",
                                  "array_control",
                                  "array_indicator",
                                  "rank_2",
                                  "selected_element",
                                  "roundtrip",
                                  "wfrog",
                                  "widget_realization_package",
                                  "post_public_runtime_boundary",
                                  "array_container",
                                  "numeric_element_template",
                                  "default_numeric_realization",
                                  "widget_container",
                                  "two_dimensional_array"
                              ],
                     "is_example":  true,
                     "license":  "Apache-2.0"
                 },

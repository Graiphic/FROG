{
  "spec_version": "0.1",
  "metadata": {
    "name": "39_array_enum_container_dimension_count_roundtrip",
    "summary": "Enum Array dynamic dimension-count property roundtrip using one Numeric U8 dimension control plus two Numeric U8 visible row/column controls.",
    "description": "Places Numeric U8 controls for dimensions and visible row/column counts around an Array control and Array indicator whose contained element widget is Default Enum. Execute consumes the selected Enum cell through the native Enum manifest corridor, while dimensions.rank, index_display.rank, and viewport.visible_counts keep the same N-dimensional behavior validated by the Numeric Array example.",
    "author": "Graiphic",
    "program_version": "0.1.0",
    "review": {
      "last_reviewed": "2026-06-12",
      "reviewer": "Codex + Graiphic",
      "visible_runtime_fact": "Reviewed 2026-06-12"
    },
    "tags": [

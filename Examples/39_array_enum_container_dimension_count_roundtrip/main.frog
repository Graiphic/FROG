    "panel_id": "main_panel",
    "title": "Enum Array Dimension Count Property Roundtrip",
    "class_ref": "frog.widgets.panel",
    "host_binding_ref": "array_runtime_host_default",
    "documentation": {
      "title": "Enum Array Dimension Count Property Roundtrip",
      "summary": "A Numeric U8 control writes Array dimensions.rank and index_display.rank while two Numeric U8 controls continue to write visible row and column counts. The Array adapts as an N-dimensional widget and each visible cell instantiates a Default Enum widget.",
      "sections": [
        {
          "title": "Dimension property",
          "body": "Execute consumes Dimensions, then writes enum_array.dimensions.rank / published_array.dimensions.rank and their index_display.rank mirrors."
        },
        {
          "title": "Visible-count properties",
          "body": "Execute consumes Visible rows and Visible columns, then writes enum_array.viewport.visible_counts[0]/[1] and published_array.viewport.visible_counts[0]/[1]."
        },
        {
          "title": "Enum element",
          "body": "Each visible cell instantiates an Enum element template. Control cells select source-owned enum items; indicator cells are read-only and visually greyed."
        },
        {
          "title": "Execute",
          "body": "Execute consumes the selected Enum element value through the native manifest corridor and publishes the value and matrix records to the read-only Array indicator."
        }
      ]
    }
  }
}
